    {
      "concept_id": "em.pde.boundary_initial_conditions",
      "order": 2,
      "name_ko": "7.2 초기조건과 경계조건",
      "definition": "PDE의 해를 결정하기 위해 시간 초기상태나 공간 경계에서 부과하는 조건이다.",
      "formulas": [
        {
          "formula_id": "dirichlet_condition",
          "name_ko": "Dirichlet 조건",
          "role": "definition",
          "latex": "u|_{\\partial\\Omega}=g",
          "cas": "Eq(u, g)"
        },
        {
          "formula_id": "neumann_condition",
          "name_ko": "Neumann 조건",
          "role": "definition",
          "latex": "\\frac{\\partial u}{\\partial n}=h",
          "cas": "Eq(Derivative(u, n), h)"
        },
        {
          "formula_id": "robin_condition",
          "name_ko": "Robin 조건",
          "role": "definition",
          "latex": "\\alpha u+\\beta\\frac{\\partial u}{\\partial n}=r",
          "cas": "Eq(alpha * u + beta * Derivative(u, n), r)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "compatibility_and_physics_match",
          "description": "PDE 유형과 물리적 의미에 맞는 조건을 사용하고, 조건들 사이의 호환성을 확인해야 한다.",
          "rule": {
            "property": "conditions_compatible_and_appropriate",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "boundary_types_meaning",
          "description": "Dirichlet은 값, Neumann은 법선미분 또는 flux, Robin은 둘의 선형결합을 지정한다."
        }
      ],
      "prerequisites": [
