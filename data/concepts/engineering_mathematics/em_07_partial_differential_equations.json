    {
      "concept_id": "em.pde.separation_of_variables",
      "order": 3,
      "name_ko": "7.3 변수분리법",
      "definition": "해를 각 변수에만 의존하는 함수들의 곱으로 가정해 PDE를 ODE들로 나누는 방법이다.",
      "formulas": [
        {
          "formula_id": "product_ansatz_pde",
          "name_ko": "곱의 해 가정",
          "role": "definition",
          "latex": "u(x,t)=X(x)T(t)",
          "cas": "Eq(u(x, t), X(x) * T(t))"
