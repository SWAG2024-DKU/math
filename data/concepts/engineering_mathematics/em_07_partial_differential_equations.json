        {
          "formula_id": "separated_odes",
          "name_ko": "분리된 ODE 예시",
          "role": "formula",
          "latex": "\\frac{T'}{\\alpha^2T} = \\frac{X''}{X} = -\\lambda",
          "cas": "Eq(Derivative(T, t)/(alpha**2 * T), -lambda_val) & Eq(Derivative(X, (x, 2))/X, -lambda_val)"
        }
      ],
