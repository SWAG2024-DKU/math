    {
      "concept_id": "em.pde.classification",
      "order": 1,
      "name_ko": "7.1 PDE의 차수·선형성과 분류",
      "definition": "편미분방정식의 최고 편도함수 차수, 미지함수에 대한 선형성, 2계 주부분의 형태를 분류하는 개념이다.",
      "formulas": [
        {
          "formula_id": "principal_part_2var",
          "name_ko": "2변수 2계 주부분",
          "role": "definition",
          "latex": "Au_{xx}+2Bu_{xy}+Cu_{yy}",
          "cas": "A * diff(u, (x, 2)) + 2*B * diff(u, x, y) + C * diff(u, (y, 2))"
        },
        {
          "formula_id": "discriminant_pde",
          "name_ko": "판별식",
          "role": "formula",
          "latex": "\\Delta=B^2-AC",
          "cas": "Eq(Delta, B**2 - A*C)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "variable_coefficients_classification",
          "description": "가변계수 PDE는 각 점의 계수를 기준으로 분류하며 위치에 따라 유형이 달라질 수 있다.",
          "rule": {
            "property": "classified_at_each_point",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "canonical_types_examples",
          "description": "Laplace 방정식은 타원형, 열방정식은 포물형, 파동방정식은 쌍곡형의 대표다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.partial_derivative",
          "name_ko": "편미분",
          "importance": "required"
        },
        {
          "concept_id": "algebra.quadratic_form",
          "name_ko": "이차형식",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "em.pde.heat_equation",
        "em.pde.wave_equation",
        "em.pde.laplace_poisson"
      ],
      "learning_objectives": [
        {
          "objective_id": "classify_pde",
          "verb": "identify",
          "description": "2계 편미분방정식의 주부분 판별식을 통해 타원형, 포물형, 쌍곡형으로 분류한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "em.pde.classification.standard_form_cross_term",
          "title": "교차 미분항 계수 배수 오인",
          "description": "주부분 표현에서 2Bu_{xy}의 계수 2를 빼고 Bu_{xy}로 오인한다.",
          "diagnosis_tag": "confuse_discriminant_coefficient",
          "feedback": "2계 PDE 주부분의 표준 형태는 Au_{xx} + 2Bu_{xy} + Cu_{yy}이므로 판별식은 B^2 - AC가 됩니다."
        }
      ],
