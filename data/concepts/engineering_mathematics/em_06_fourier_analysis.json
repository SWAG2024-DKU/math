    {
      "concept_id": "em.fourier.series_and_coefficients",
      "order": 3,
      "name_ko": "Fourier 급수와 계수",
      "definition": "주기함수를 사인과 코사인의 무한 선형결합으로 표현하는 급수다.",
      "formulas": [
        {
          "formula_id": "fourier_series_expansion",
          "name_ko": "Fourier 급수 전개식",
          "role": "definition",
          "latex": "f(x)\\sim \\frac{a_0}{2} + \\sum_{n=1}^{\\infty} \\left[a_n\\cos\\frac{n\\pi x}{L} + b_n\\sin\\frac{n\\pi x}{L}\\right]",
          "cas": "Eq(f(x), a_0/2 + Sum(a_n * cos(n*pi*x/L) + b_n * sin(n*pi*x/L), (n, 1, oo)))"
        },
        {
          "formula_id": "fourier_coefficient_an",
          "name_ko": "a_n 계수 공식",
          "role": "formula",
          "latex": "a_n = \\frac{1}{L}\\int_{-L}^{L} f(x)\\cos\\frac{n\\pi x}{L}\\,dx",
          "cas": "Eq(a_n, (1/L) * Integral(f(x) * cos(n*pi*x/L), (x, -L, L)))"
        },
        {
          "formula_id": "fourier_coefficient_bn",
          "name_ko": "b_n 계수 공식",
          "role": "formula",
          "latex": "b_n = \\frac{1}{L}\\int_{-L}^{L} f(x)\\sin\\frac{n\\pi x}{L}\\,dx",
          "cas": "Eq(b_n, (1/L) * Integral(f(x) * sin(n*pi*x/L), (x, -L, L)))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "integrable_over_period",
          "description": "f가 한 주기에서 적분 가능해야 한다.",
          "rule": {
            "property": "f_integrable_over_period",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "convergence_at_points",
          "description": "연속점에서는 함수값으로, 점프 불연속점에서는 좌우극한 평균으로 수렴한다."
        }
      ],
