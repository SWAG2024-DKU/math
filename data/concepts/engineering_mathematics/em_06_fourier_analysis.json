    {
      "concept_id": "em.fourier.periodic_functions_fundamental_frequency",
      "order": 1,
      "name_ko": "주기함수와 기본주파수",
      "definition": "어떤 양수 T에 대해 f(x+T)=f(x)인 함수를 주기함수라 한다.",
      "formulas": [
        {
          "formula_id": "periodicity_definition",
          "name_ko": "주기함수 정의",
          "role": "definition",
          "latex": "f(x+T)=f(x)",
          "cas": "Eq(f(x + T), f(x))"
        },
        {
          "formula_id": "fundamental_frequency",
          "name_ko": "기본주파수(각주파수)",
          "role": "formula",
          "latex": "\\omega_0=\\frac{2\\pi}{T}",
          "cas": "Eq(omega_0, 2 * pi / T)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "periodicity_holds_for_all_x",
          "description": "주기 관계가 모든 x에서 성립해야 하며 기본주기는 가장 작은 양의 주기다.",
          "rule": {
            "property": "periodicity_holds_all_x",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "integer_multiple_periods",
          "description": "정수배 주기도 모두 주기이며 Fourier 성분은 기본주파수의 정수배를 갖는다."
        }
      ],
      "prerequisites": [
