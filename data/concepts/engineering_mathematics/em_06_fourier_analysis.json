    {
      "concept_id": "em.fourier.complex_fourier_series",
      "order": 5,
      "name_ko": "복소 Fourier 급수",
      "definition": "삼각 Fourier 급수를 복소지수의 합으로 나타낸 형식이다.",
      "formulas": [
        {
          "formula_id": "complex_fourier_expansion",
          "name_ko": "복소 Fourier 급수 전개식",
          "role": "definition",
          "latex": "f(t)\\sim \\sum_{n=-\\infty}^{\\infty} c_ne^{in\\omega_0t}",
          "cas": "Eq(f(t), Sum(c_n * exp(I * n * omega_0 * t), (n, -oo, oo)))"
        },
        {
          "formula_id": "complex_fourier_coefficient_cn",
          "name_ko": "복소 계수 c_n 공식",
          "role": "formula",
          "latex": "c_n = \\frac{1}{T}\\int_{t_0}^{t_0+T} f(t)e^{-in\\omega_0t}\\,dt",
          "cas": "Eq(c_n, (1/T) * Integral(f(t) * exp(-I * n * omega_0 * t), (t, t0, t0 + T)))"
        }
      ],
      "application_conditions": [
