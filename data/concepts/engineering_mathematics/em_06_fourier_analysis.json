    {
      "concept_id": "em.fourier.trigonometric_orthogonality",
      "order": 2,
      "name_ko": "삼각함수의 직교성",
      "definition": "서로 다른 정수 주파수의 사인·코사인이 한 주기 구간에서 내적이 0이 되는 성질이다.",
      "formulas": [
        {
          "formula_id": "cosine_cosine_orthogonality",
          "name_ko": "코사인-코사인 직교성",
          "role": "definition",
          "latex": "\\int_{-L}^{L} \\cos\\frac{m\\pi x}{L} \\cos\\frac{n\\pi x}{L}\\,dx=0 \\quad (m\\neq n)",
          "cas": "Eq(Integral(cos(m*pi*x/L) * cos(n*pi*x/L), (x, -L, L)), 0)"
        },
        {
          "formula_id": "sine_cosine_orthogonality",
          "name_ko": "사인-코사인 직교성",
          "role": "definition",
          "latex": "\\int_{-L}^{L} \\sin\\frac{m\\pi x}{L} \\cos\\frac{n\\pi x}{L}\\,dx=0",
          "cas": "Eq(Integral(sin(m*pi*x/L) * cos(n*pi*x/L), (x, -L, L)), 0)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "integers_m_n_same_interval",
          "description": "m, n은 정수이며 같은 기본구간과 스케일을 사용해야 한다.",
          "rule": {
            "property": "m_n_integers_same_interval",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "independent_coefficient_extraction",
          "description": "각 주파수 성분의 계수를 독립적으로 추출할 수 있게 한다."
