    {
      "concept_id": "em.laplace.first_shifting_theorem",
      "order": 3,
      "name_ko": "주파수 이동정리",
      "definition": "시간영역에서 e^{at}를 곱하면 s영역의 변수가 이동하는 성질이다.",
      "formulas": [
        {
          "formula_id": "first_shifting_formula",
          "name_ko": "제1 이동정리",
          "role": "definition",
          "latex": "\\mathcal{L}\\{e^{at}f(t\\})=F(s-a)",
          "cas": "Eq(laplace(exp(a*t) * f(t)), F(s - a))"
        }
      ],
      "application_conditions": [
        {
