    {
      "concept_id": "em.laplace.second_shifting_theorem",
      "order": 4,
      "name_ko": "시간 이동과 단위계단함수",
      "definition": "특정 시점 이후에 켜지는 지연함수를 Heaviside 함수로 표현하는 방법이다.",
      "formulas": [
        {
          "formula_id": "heaviside_step_function",
          "name_ko": "단위계단함수 정의",
          "role": "definition",
          "latex": "u(t-a)=\\begin{cases}0,&t<a\\\\1,&t\\ge a\\end{cases}",
          "cas": "Piecewise((0, t < a), (1, t >= a))"
