  "concepts": [
    {
      "concept_id": "em.laplace.definition_existence",
      "order": 1,
      "name_ko": "Laplace 변환의 정의와 존재조건",
      "definition": "함수 f(t)를 복소변수 s의 함수로 바꾸는 단측 적분변환이다.",
      "formulas": [
        {
          "formula_id": "laplace_transform_integral",
          "name_ko": "Laplace 변환 정의",
          "role": "definition",
          "latex": "\\mathcal{L}\\{f(t)\\}=F(s)=\\int_0^\\infty e^{-st}f(t)\\,dt",
          "cas": "Integral(exp(-s * t) * f(t), (t, 0, oo))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "piecewise_continuous_exponential_order",
          "description": "f가 모든 유한 구간에서 조각별 연속이고 지수차수 함수이면 충분히 큰 Re(s)에서 변환이 존재한다.",
          "rule": {
            "property": "is_piecewise_continuous_and_exponential_order",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "converts_calculus_to_algebra",
          "description": "시간영역의 미분과 적분을 s영역의 대수연산으로 바꾼다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.improper_integral",
          "name_ko": "이상적분",
          "importance": "required"
        },
        {
          "concept_id": "calculus.exponential",
          "name_ko": "지수함수",
          "importance": "required"
        },
        {
          "concept_id": "algebra.complex_number",
          "name_ko": "복소수",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "em.laplace.linearity_table"
      ],
      "learning_objectives": [
        {
          "objective_id": "understand_laplace_definition",
          "verb": "identify",
          "description": "Laplace 변환의 정의와 존재 조건을 이해한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "em.laplace.definition_existence.variable_confusion",
          "title": "변수 혼동 오류",
          "description": "적분변수 t와 변환변수 s의 역할을 혼동한다.",
