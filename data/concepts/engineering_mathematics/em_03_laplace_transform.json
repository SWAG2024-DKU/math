    {
      "concept_id": "em.laplace.linearity_table",
      "order": 2,
      "name_ko": "선형성과 기본 변환표",
      "definition": "함수의 선형결합을 각 함수 변환의 선형결합으로 바꾸고 표준함수의 변환을 이용하는 원리다.",
      "formulas": [
        {
          "formula_id": "laplace_linearity",
          "name_ko": "선형성",
          "role": "definition",
          "latex": "\\mathcal{L}\\{af+bg\\}=aF+bG",
          "cas": "Eq(laplace(a*f + b*g), a*laplace(f) + b*laplace(g))"
        },
        {
          "formula_id": "basic_transforms",
          "name_ko": "기본 변환 공식",
          "role": "formula",
          "latex": "\\mathcal{L}\\{1\\}=\\frac{1}{s},\\quad \\mathcal{L}\\{t^n\\}=\\frac{n!}{s^{n+1}},\\quad \\mathcal{L}\\{e^{at\\}}=\\frac{1}{s-a}",
          "cas": "Eq(laplace(t**n), factorial(n) / s**(n+1))"
        },
        {
          "formula_id": "trig_transforms",
          "name_ko": "삼각함수 변환",
          "role": "formula",
          "latex": "\\mathcal{L}\\{\\sin bt\\}=\\frac{b}{s^2+b^2},\\quad \\mathcal{L}\\{\\cos bt\\}=\\frac{s}{s^2+b^2}",
          "cas": "Eq(laplace(sin(b*t)), b / (s**2 + b**2))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "common_roc_required",
          "description": "각 함수의 변환이 공통 수렴영역에서 존재해야 한다.",
          "rule": {
            "property": "transforms_exist_in_common_roc",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "decomposition_into_basic_functions",
          "description": "복잡한 함수를 기본함수의 합으로 분해해 계산할 수 있다."
        }
      ],
      "prerequisites": [
