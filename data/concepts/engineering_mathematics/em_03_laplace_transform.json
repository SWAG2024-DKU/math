    {
      "concept_id": "em.laplace.derivatives_transform",
      "order": 5,
      "name_ko": "도함수의 Laplace 변환",
      "definition": "시간미분을 s의 거듭제곱과 초기값 항으로 바꾸는 성질이다.",
      "formulas": [
        {
          "formula_id": "first_derivative_laplace",
          "name_ko": "1계 도함수 변환",
          "role": "formula",
          "latex": "\\mathcal{L}\\{y'\\}=sY-y(0)",
          "cas": "Eq(laplace(Derivative(y, t)), s * Y - y(0))"
        },
        {
          "formula_id": "second_derivative_laplace",
          "name_ko": "2계 도함수 변환",
          "role": "formula",
          "latex": "\\mathcal{L}\\{y''\\}=s^2Y-sy(0)-y'(0)",
          "cas": "Eq(laplace(Derivative(y, (t, 2))), s**2 * Y - s * y(0) - Derivative(y, t).subs(t, 0))"
        },
        {
          "formula_id": "nth_derivative_laplace",
          "name_ko": "n계 도함수 변환",
          "role": "definition",
          "latex": "\\mathcal{L}\\{y^{(n)}\\}=s^nY-\\sum_{k=0}^{n-1}s^{n-1-k}y^{(k)}(0)",
          "cas": "Eq(laplace(Derivative(y, (t, n))), s**n * Y - sum(s**(n-1-k) * Derivative(y, (t, k)).subs(t, 0) for k in range(n)))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "y_and_derivatives_exponential_order",
          "description": "y와 필요한 도함수들이 조각별 연속이고 지수차수 조건을 만족해야 한다.",
