    {
      "concept_id": "em.vector.gradient_directional_derivative",
      "order": 2,
      "name_ko": "Gradient와 방향도함수",
      "definition": "Gradient는 스칼라장의 편미분을 모은 벡터이며, 방향도함수는 특정 방향의 순간 변화율이다.",
      "formulas": [
        {
          "formula_id": "gradient_formula",
          "name_ko": "그래디언트 정의",
          "role": "definition",
          "latex": "\\nabla f=(f_x,f_y,f_z)",
          "cas": "Matrix([diff(f, x), diff(f, y), diff(f, z)])"
        },
        {
          "formula_id": "directional_derivative_formula",
          "name_ko": "방향도함수 정의",
          "role": "definition",
          "latex": "D_{\\mathbf{u}}f=\\nabla f\\cdot\\mathbf{u}",
          "cas": "Dot(Gradient(f), u)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "differentiable_f_unit_vector_u",
          "description": "f가 해당 점에서 미분 가능하고 u가 단위벡터여야 한다.",
          "rule": {
            "property": "f_differentiable_u_is_unit",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "gradient_perpendicular_to_level_surface",
          "description": "nbnabla f는 등위면에 수직이며 최대 방향도함수는 ||nabla f||이고 방향은 gradient 방향이다."
        }
      ],
      "prerequisites": [
