      "order": 3,
      "name_ko": "Wronskian과 기본해집합",
      "definition": "여러 함수 또는 해의 선형독립성을 판정하는 데 쓰는 행렬식이다.",
      "formulas": [
        {
          "formula_id": "wronskian_determinant",
          "name_ko": "론스키안 행렬식",
          "role": "definition",
          "latex": "W(y_1,\\dots,y_n) = \\det\\left[y_j^{(i-1)}\\right]",
          "cas": "Matrix([[y_1, y_2, ..., y_n], [Derivative(y_1, x), ..., Derivative(y_n, x)], ...]).det()"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "differentiability_and_interval",
          "description": "함수들이 같은 구간에서 충분히 미분 가능해야 하며 선형 ODE 해들의 경우 한 점에서 W != 0이어야 한다.",
          "rule": {
            "property": "differentiable_and_non_zero_at_point",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "fundamental_set_basis",
          "description": "기본해집합은 해공간의 기저가 되며 W != 0이면 구간 전체에서 선형독립이다."
        }
      ],
