  "concepts": [
    {
      "concept_id": "em.ode.higher_order_linear",
      "order": 1,
      "name_ko": "2계 고계 선형 상미분방정식",
      "definition": "미지함수와 각 계수의 도함수들이 모두 1차로 나타나는 n계 방정식이다.",
      "formulas": [
        {
          "formula_id": "higher_order_linear_general_form",
          "name_ko": "n계 선형 ODE 일반형",
          "role": "definition",
          "latex": "a_n(x)y^{(n)}+\\cdots+a_1(x)y'+a_0(x)y=g(x)",
          "cas": "Eq(sum(a_k(x) * Derivative(y, (x, k)) for k in range(n+1)), g(x))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "leading_coefficient_nonzero",
          "description": "최고계수 a_n(x) != 0인 구간에서 표준형으로 나눌 수 있어야 한다.",
          "rule": {
            "property": "leading_coefficient_not_zero",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "homogeneous_vs_nonhomogeneous",
          "description": "g=0이면 동차, g!=0이면 비동차이며 일반해에는 보통 n개의 독립적인 임의상수가 포함된다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.derivative",
          "name_ko": "고계 미분",
          "importance": "required"
        },
        {
          "concept_id": "em.ode.first_order_intro",
          "name_ko": "1계 ODE",
          "importance": "required"
        },
        {
          "concept_id": "la.space.linear_independence",
          "name_ko": "선형대수의 선형독립",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "em.ode.superposition_space"
      ],
      "learning_objectives": [
        {
          "objective_id": "classify_higher_order_ode",
          "verb": "identify",
          "description": "고계 선형 상미분방정식의 구조와 동차·비동차 여부를 판정한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "em.ode.higher_order_linear.coefficient_linearity",
          "title": "계수함수의 선형성 오해",
          "description": "계수함수 a_k(x)도 반드시 1차 선형 함수여야 한다고 오인한다.",
          "diagnosis_tag": "confuse_coefficient_linearity",
          "feedback": "선형 방정식에서 1차여야 하는 것은 미지함수 y와 그 도함수들이며, 계수함수 a_k(x)는 비선형 함수여도 상관없습니다."
        }
      ],
