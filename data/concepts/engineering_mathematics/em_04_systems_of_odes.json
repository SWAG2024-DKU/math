    {
      "concept_id": "em.ode.state_space_conversion",
      "order": 2,
      "name_ko": "고계 ODE의 상태공간 변환",
      "definition": "n계 방정식을 n개의 상태변수를 도입해 1계 시스템으로 바꾸는 과정이다.",
      "formulas": [
        {
          "formula_id": "state_space_vector_form",
          "name_ko": "상태공간 변환 예시",
          "role": "formula",
          "latex": "\\begin{pmatrix}x_1'\\\\x_2'\\end{pmatrix} = \\begin{pmatrix}0&1\\\\-b&-a\\end{pmatrix} \\begin{pmatrix}x_1\\\\x_2\\end{pmatrix} + \\begin{pmatrix}0\\\\f(t)\\end{pmatrix}",
          "cas": "Eq(Matrix([[x1_prime], [x2_prime]]), Matrix([[0, 1], [-b, -a]]) * Matrix([[x1], [x2]]) + Matrix([[0], [f(t)]]))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "highest_derivative_solved",
          "description": "원래 방정식이 최고계 도함수에 관해 풀려 있어야 한다.",
          "rule": {
            "property": "highest_derivative_isolated",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "control_engineering_link",
          "description": "수치해석과 제어공학에서 사용하는 상태방정식으로 연결된다."
        }
      ],
