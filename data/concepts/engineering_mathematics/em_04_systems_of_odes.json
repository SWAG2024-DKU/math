    {
      "concept_id": "em.ode.eigenvalue_method",
      "order": 3,
      "name_ko": "고유값·고유벡터 해법",
      "definition": "상수계수 동차 시스템의 해를 행렬의 고유쌍으로 구성하는 방법이다.",
      "formulas": [
        {
          "formula_id": "eigenvalue_problem",
          "name_ko": "고유값 방정식",
          "role": "definition",
          "latex": "A\\mathbf{v}=\\lambda\\mathbf{v}",
          "cas": "Eq(A * v, lambda_val * v)"
        },
        {
          "formula_id": "eigen_solution_term",
          "name_ko": "개별 고유해",
          "role": "formula",
          "latex": "\\mathbf{x}(t)=e^{\\lambda t}\\mathbf{v}",
          "cas": "Eq(x(t), exp(lambda_val * t) * v)"
        },
        {
          "formula_id": "eigen_general_solution",
          "name_ko": "일반해 구성",
          "role": "formula",
          "latex": "\\mathbf{x}(t)=\\sum_i c_i e^{\\lambda_i t}\\mathbf{v}_i",
          "cas": "Eq(x(t), Sum(c_i * exp(lambda_i * t) * v_i, i))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "constant_matrix_and_linearly_independent_eigenvectors",
          "description": "A가 상수이며 필요한 수만큼 선형독립 고유벡터를 구할 수 있어야 한다.",
          "rule": {
