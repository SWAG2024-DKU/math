    {
      "concept_id": "em.ode.systems_matrix_form",
      "order": 1,
      "name_ko": "연립 ODE의 행렬형",
      "definition": "여러 1계 미분방정식을 하나의 벡터방정식으로 표현한 것이다.",
      "formulas": [
        {
          "formula_id": "matrix_ode_general",
          "name_ko": "비동차 연립 ODE 행렬형",
          "role": "definition",
          "latex": "\\mathbf{x}'(t)=A(t)\\mathbf{x}(t)+\\mathbf{g}(t)",
          "cas": "Eq(Derivative(x, t), A(t) * x + g(t))"
        },
        {
          "formula_id": "matrix_ode_homogeneous",
          "name_ko": "상수계수 동차 연립 ODE 행렬형",
          "role": "definition",
          "latex": "\\mathbf{x}'=A\\mathbf{x}",
          "cas": "Eq(Derivative(x, t), A * x)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "linear_system_condition",
          "description": "성분별 방정식이 미지함수들에 대해 선형이어야 선형 시스템이 된다.",
