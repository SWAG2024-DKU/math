  "concepts": [
    {
      "concept_id": "em.ode.first_order_intro",
      "order": 1,
      "name_ko": "1계 상미분방정식",
      "definition": "하나의 독립변수에 대한 미지함수와 그 1계 도함수 사이의 관계식이다. 일반해에는 보통 하나의 임의상수가 포함되며, 초기조건을 적용하면 특수해가 결정된다.",
      "formulas": [
        {
          "formula_id": "general_form_ode",
          "name_ko": "일반형",
          "role": "definition",
          "latex": "F(x,y,y')=0",
          "cas": "Eq(F(x, y, Derivative(y, x)), 0)"
        },
        {
          "formula_id": "normal_form_ode",
          "name_ko": "정규형",
          "role": "definition",
          "latex": "y'=f(x,y)",
          "cas": "Eq(Derivative(y, x), f(x, y))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "solve_for_y_prime",
          "description": "정규형을 사용하려면 주어진 구간에서 방정식을 y'에 관해 풀 수 있어야 한다.",
          "rule": {
            "property": "can_solve_for_derivative",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "solution_forms",
          "description": "해는 명시적 형태 y=phi(x) 또는 음함수 형태 G(x,y)=0로 주어질 수 있다."
        }
      ],
      "prerequisites": [
