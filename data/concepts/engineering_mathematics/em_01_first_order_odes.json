    {
      "concept_id": "em.ode.linear_integrating_factor",
      "order": 5,
      "name_ko": "1계 선형방정식과 적분인자",
      "definition": "미지함수와 그 도함수가 모두 1차로 나타나는 방정식이다. 적분인자를 곱해 좌변을 하나의 곱미분으로 만든다.",
      "formulas": [
        {
          "formula_id": "linear_standard_form",
          "name_ko": "선형방정식 표준형",
          "role": "definition",
          "latex": "y'+P(x)y=Q(x)",
          "cas": "Eq(Derivative(y, x) + P(x) * y, Q(x))"
        },
        {
          "formula_id": "integrating_factor_formula",
          "name_ko": "적분인자",
          "role": "formula",
          "latex": "\\mu(x)=e^{\\int P(x)\\,dx}",
          "cas": "exp(Integral(P(x), x))"
        },
        {
          "formula_id": "linear_general_solution",
          "name_ko": "일반해 공식",
          "role": "formula",
          "latex": "y=\\frac{1}{\\mu(x)} \\left(\\int\\mu(x)Q(x)\\,dx+C\\right)",
          "cas": "(1 / mu) * (Integral(mu * Q(x), x) + C)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "standard_form_and_continuity",
          "description": "방정식을 표준형으로 정리해야 하며 P, Q가 다루는 구간에서 연속이어야 한다.",
          "rule": {
            "property": "is_standard_form",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "homogeneous_plus_particular",
          "description": "동차해는 Ce^{-int Pdx}이며 전체해는 동차해와 특수해의 합이다."
        }
      ],
      "prerequisites": [
