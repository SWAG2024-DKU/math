          "name_ko": "함수",
          "importance": "required"
        },
        {
          "concept_id": "calculus.derivative",
          "name_ko": "미분",
          "importance": "required"
        },
        {
          "concept_id": "calculus.integral",
          "name_ko": "적분",
          "importance": "required"
        },
