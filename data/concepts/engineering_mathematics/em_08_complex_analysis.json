    {
      "concept_id": "em.complex.cartesian_polar_form",
      "order": 1,
      "name_ko": "8.1 복소수의 직교형과 극형식",
      "definition": "복소수를 실수부·허수부 또는 크기·편각으로 표현하는 방법이다.",
      "formulas": [
        {
          "formula_id": "cartesian_form",
          "name_ko": "직교형",
          "role": "definition",
          "latex": "z=x+iy",
          "cas": "Eq(z, x + I*y)"
        },
        {
          "formula_id": "polar_form",
          "name_ko": "극형식",
          "role": "definition",
          "latex": "z=re^{i\\theta}=r(\\cos\\theta+i\\sin\\theta)",
          "cas": "Eq(z, r * exp(I * theta))"
        },
        {
          "formula_id": "modulus_definition",
          "name_ko": "크기",
          "role": "formula",
          "latex": "r=|z|=\\sqrt{x^2+y^2}",
          "cas": "Eq(r, sqrt(x**2 + y**2))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "z_nonzero_for_argument",
          "description": "z != 0일 때 편각을 정의하며 편각은 2pi의 정수배만큼 여러 값을 갖는다.",
          "rule": {
            "property": "z_not_zero",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "multiplication_division_properties",
          "description": "곱셈에서는 크기가 곱해지고 편각이 더해지며, 나눗셈에서는 크기를 나누고 편각을 뺀다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.trigonometry",
          "name_ko": "삼각함수",
          "importance": "required"
        },
        {
