    {
      "concept_id": "em.complex.euler_demoivre",
      "order": 2,
      "name_ko": "8.2 Euler 공식과 de Moivre 정리",
      "definition": "복소지수와 삼각함수를 연결하고 복소수의 거듭제곱과 근을 계산하는 공식이다.",
      "formulas": [
        {
          "formula_id": "euler_formula",
          "name_ko": "Euler 공식",
          "role": "definition",
          "latex": "e^{i\\theta}=\\cos\\theta+i\\sin\\theta",
          "cas": "Eq(exp(I * theta), cos(theta) + I * sin(theta))"
        },
        {
          "formula_id": "demoivre_theorem",
          "name_ko": "드 무아브르 정리",
          "role": "formula",
          "latex": "(\\cos\\theta+i\\sin\\theta)^n=\\cos n\\theta+i\\sin n\\theta",
          "cas": "Eq((cos(theta) + I * sin(theta))**n, cos(n * theta) + I * sin(n * theta))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "demoivre_integer_n",
          "description": "de Moivre 공식은 정수 n에 직접 적용한다.",
          "rule": {
            "property": "n_is_integer",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "roots_of_unity_distribution",
          "description": "z^n = w의 근은 복소평면의 원 위에 등간격으로 배치된다."
        }
      ],
      "prerequisites": [
