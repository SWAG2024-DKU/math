  "concepts": [
    {
      "concept_id": "calculus.integration_by_parts",
      "order": 1,
      "name_ko": "부분적분",
      "definition": "곱의 미분법칙에 대응하는 적분법으로, 치환법이 연쇄법칙에 대응하듯 부분적분은 곱법칙에 대응한다. ∫u dv=uv-∫v du 형태로, 어려운 적분을 더 쉬운 다른 적분으로 바꾼다.",
      "formulas": [
        {
          "formula_id": "integration_by_parts",
          "name_ko": "부분적분 공식",
          "role": "theorem",
          "latex": "\\int f(x)g'(x)\\,dx=f(x)g(x)-\\int g(x)f'(x)\\,dx,\\qquad\\int u\\,dv=uv-\\int v\\,du",
          "cas": "f(x)*g(x) - Integral(g(x)*diff(f(x),x), x)"
        },
        {
          "formula_id": "integration_by_parts_definite",
          "name_ko": "정적분에 대한 부분적분",
          "role": "theorem",
          "latex": "\\int_a^bf(x)g'(x)\\,dx=\\Big[f(x)g(x)\\Big]_a^b-\\int_a^bg(x)f'(x)\\,dx",
          "cas": "f(b)*g(b)-f(a)*g(a) - Integral(g(x)*diff(f(x),x), (x,a,b))"
        },
        {
          "formula_id": "reduction_formula_sin",
          "name_ko": "점화공식 예시(sin^n x)",
          "role": "example",
          "latex": "\\int\\sin^nx\\,dx=-\\frac1n\\cos x\\sin^{n-1}x+\\frac{n-1}n\\int\\sin^{n-2}x\\,dx",
          "cas": "-cos(x)*sin(x)**(n-1)/n + (n-1)/n*Integral(sin(x)**(n-2), x)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "u_dv_selection_criteria",
          "description": "u, dv를 선택할 때: u는 미분했을 때 더 간단한(적어도 더 복잡하지 않은) 함수가 되어야 하고, dv는 원시함수 v를 구할 수 있어야 한다.",
          "rule": {
            "property": "u_simplifies_and_dv_integrable",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "definite_needs_continuous_derivatives",
          "description": "정적분 형태는 f', g'이 연속이어야 성립한다.",
          "rule": {
            "property": "f_prime_and_g_prime_continuous",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "derived_from_product_rule",
          "description": "곱법칙 d/dx[f(x)g(x)]=f(x)g'(x)+g(x)f'(x)를 부정적분으로 표현하고 정리하면 부분적분 공식이 유도된다."
        },
        {
          "property_id": "log_and_inverse_trig_as_u",
          "description": "로그함수·역삼각함수처럼 도함수가 더 간단해지는 함수는 u로 선택하기 좋다(예: ∫ln x dx는 u=ln x, dv=dx)."
        },
        {
          "property_id": "self_referential_equation_trick",
          "description": "부분적분을 반복 적용해 원래 적분으로 되돌아오는 경우(예: ∫e^x sin x dx), 원래 적분을 미지수로 하는 방정식으로 보고 풀 수 있다."
        },
        {
          "property_id": "reduction_formula_pattern",
          "description": "점화공식은 거듭제곱의 지수를 하나씩 줄여가며 반복 적용해 최종적으로 기본 적분으로 귀결시키며, cos^n x, tan^n x, sec^n x, (ln x)^n, x^n e^x 등에도 유사하게 성립한다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.product_rule",
          "name_ko": "곱법칙",
          "importance": "required"
        },
        {
          "concept_id": "calculus.indefinite_integral",
