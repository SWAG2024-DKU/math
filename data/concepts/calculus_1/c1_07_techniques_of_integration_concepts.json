    {
      "concept_id": "calculus.trigonometric_integrals",
      "order": 2,
      "name_ko": "삼각함수의 적분",
      "definition": "sin^m x cos^n x, tan^m x sec^n x 등 삼각함수가 결합된 적분을, 삼각함수 항등식으로 하나의 인수를 분리해 치환하거나 반각공식으로 전개해 계산하는 체계적인 방법이다.",
      "formulas": [
        {
          "formula_id": "sin_cos_power_odd",
          "name_ko": "사인·코사인 거듭제곱(홀수 인수 분리)",
          "role": "technique",
          "latex": "\\cos^{2k+1}x=(1-\\sin^2x)^k\\cos x\\ (u=\\sin x),\\qquad\\sin^{2k+1}x=(1-\\cos^2x)^k\\sin x\\ (u=\\cos x)",
          "cas": "(1-sin(x)**2)**k*cos(x)"
        },
        {
          "formula_id": "sin_cos_power_even",
          "name_ko": "사인·코사인 거듭제곱(모두 짝수: 반각공식)",
          "role": "technique",
          "latex": "\\sin^2x=\\tfrac12(1-\\cos2x),\\qquad\\cos^2x=\\tfrac12(1+\\cos2x)",
          "cas": "(1-cos(2*x))/2"
        },
        {
          "formula_id": "tan_sec_power",
          "name_ko": "탄젠트·시컨트 거듭제곱",
          "role": "technique",
          "latex": "\\sec^{2k}x=(1+\\tan^2x)^{k-1}\\sec^2x\\ (u=\\tan x),\\qquad\\tan^{2k+1}x\\sec^nx=(\\sec^2x-1)^k\\sec^{n-1}x\\sec x\\tan x\\ (u=\\sec x)",
          "cas": "(1+tan(x)**2)**(k-1)*sec(x)**2"
        },
        {
          "formula_id": "tan_sec_basic_integrals",
          "name_ko": "필수 보조 공식",
          "role": "lemma",
          "latex": "\\int\\tan x\\,dx=\\ln|\\sec x|+C,\\qquad\\int\\sec x\\,dx=\\ln|\\sec x+\\tan x|+C",
          "cas": "log(Abs(sec(x)+tan(x)))"
        },
        {
          "formula_id": "product_to_sum",
          "name_ko": "곱을 합차로 바꾸는 공식",
          "role": "identity",
          "latex": "\\sin A\\cos B=\\tfrac12[\\sin(A-B)+\\sin(A+B)]",
          "cas": "(sin(A-B)+sin(A+B))/2"
        }
      ],
      "application_conditions": [
