    {
      "concept_id": "calculus.surface_area_of_revolution",
      "order": 2,
      "name_ko": "회전체의 겉넓이",
      "definition": "곡선을 축에 대해 회전시켜 만든 곡면의 넓이를, 원뿔대들의 옆넓이 근사합의 극한으로 정의한다. x축 회전이면 S=∫2πf(x)√(1+[f'(x)]²)dx=∫2πy ds, y축 회전이면 반지름을 x로 바꾼다.",
      "formulas": [
        {
          "formula_id": "frustum_lateral_area",
          "name_ko": "원뿔대의 옆넓이",
          "role": "lemma",
          "latex": "A=2\\pi rl,\\qquad r=\\tfrac12(r_1+r_2)",
          "cas": "2*pi*r*l"
        },
        {
          "formula_id": "surface_area_x_axis",
          "name_ko": "x축 회전 겉넓이",
          "role": "theorem",
          "latex": "S=\\int_a^b2\\pi f(x)\\sqrt{1+[f'(x)]^2}\\,dx=\\int2\\pi y\\,ds",
          "cas": "Integral(2*pi*f(x)*sqrt(1+diff(f(x),x)**2), (x,a,b))"
        },
        {
          "formula_id": "surface_area_y_axis",
          "name_ko": "y축 회전 겉넓이",
          "role": "theorem",
          "latex": "S=\\int_a^b2\\pi x\\sqrt{1+[f'(x)]^2}\\,dx=\\int2\\pi x\\,ds",
          "cas": "Integral(2*pi*x*sqrt(1+diff(f(x),x)**2), (x,a,b))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "f_nonnegative_continuous_derivative",
          "description": "f는 양수이고 연속인 도함수를 가져야 한다(f≥0이 아니면 반지름이 음수가 되어 공식이 성립하지 않는다).",
          "rule": {
            "property": "f_nonnegative_and_f_prime_continuous",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "circumference_times_ds_mnemonic",
          "description": "공식은 '회전하는 동안 그려지는 원둘레(2πy 또는 2πx) × 호의 길이 미분 ds'로 기억하면 된다."
        },
        {
          "property_id": "either_variable_gives_same_answer",
          "description": "곡선을 x로 적분하든 y로 적분하든(둘 다 가능한 경우) 같은 값을 얻으므로 서로 검산에 쓸 수 있다."
        },
        {
          "property_id": "sanity_check_via_cylinder_or_cone",
          "description": "계산 결과의 타당성은 같은 높이의 원기둥 넓이나 같은 반지름의 원뿔대 넓이와 비교해 어림 확인할 수 있다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.arc_length",
          "name_ko": "호의 길이",
          "importance": "required"
        },
        {
          "concept_id": "calculus.volume_by_disk_and_washer",
          "name_ko": "원판법과 고리법",
          "importance": "recommended"
        }
      ],
      "related_concepts": [
        "calculus.pappus_theorem"
      ],
      "learning_objectives": [
        {
          "objective_id": "set_up_surface_area_integral",
          "verb": "construct",
          "description": "회전축에 맞는 겉넓이 적분(반지름과 ds)을 세운다."
        },
        {
          "objective_id": "compute_surface_area",
          "verb": "calculate",
          "description": "치환법으로 회전체의 겉넓이를 계산한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "calculus.surface_area.confuse_with_volume",
          "title": "겉넓이와 부피를 혼동",
          "description": "회전체의 겉넓이(2차원, 곡면)를 원판·고리·원통셸로 구하는 부피(3차원)와 같은 방식으로 계산한다.",
