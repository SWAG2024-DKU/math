    {
      "concept_id": "calculus.pappus_theorem",
      "order": 4,
      "name_ko": "파푸스 정리",
      "definition": "평면 영역 R이 직선 l의 한쪽에 완전히 놓여 있고 l에 대해 회전할 때, 회전체의 부피는 V=A·d이다(A는 R의 넓이, d=2πr̄는 R의 무게중심이 회전 중 이동한 거리, r̄는 무게중심에서 회전축까지의 거리).",
      "formulas": [
        {
          "formula_id": "pappus_theorem",
          "name_ko": "파푸스 정리",
          "role": "theorem",
          "latex": "V=A\\cdot d,\\qquad d=2\\pi\\bar r",
          "cas": "A*2*pi*r_bar"
        },
        {
          "formula_id": "torus_volume",
          "name_ko": "원환체(torus)의 부피",
          "role": "example",
          "latex": "A=\\pi r^2,\\ d=2\\pi R\\implies V=2\\pi^2r^2R\\quad(R>r)",
          "cas": "2*pi**2*r**2*R"
        }
      ],
      "application_conditions": [
