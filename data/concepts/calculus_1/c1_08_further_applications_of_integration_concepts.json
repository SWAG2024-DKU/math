    {
      "concept_id": "calculus.hydrostatic_force",
      "order": 3,
      "name_ko": "유체 정역학적 힘",
      "definition": "유체 속 깊이 d에서의 압력은 P=ρgd(밀도·중력가속도·깊이의 곱)이며 방향과 무관하다. 수직으로 잠긴 판에 작용하는 전체 힘은 판을 깊이에 따른 얇은 수평띠로 나누어 각 띠의 압력×넓이를 리만합으로 더한 극한, 즉 F=∫ρgx w(x)dx이다.",
      "formulas": [
        {
          "formula_id": "pressure_definition",
          "name_ko": "압력의 정의",
          "role": "definition",
          "latex": "P=\\frac{F}{A}=\\rho gd",
          "cas": "rho*g*d"
