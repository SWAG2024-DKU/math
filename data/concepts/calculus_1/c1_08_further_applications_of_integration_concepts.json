    {
      "concept_id": "calculus.arc_length",
      "order": 1,
      "name_ko": "호의 길이",
      "definition": "곡선을 다각형 경로로 근사시킨 뒤 선분의 수를 늘려가는 극한으로 호의 길이를 정의한다. f'이 [a,b]에서 연속(매끄러움)이면 y=f(x)의 길이는 L=∫[a,b]√(1+[f'(x)]²)dx이다.",
      "formulas": [
        {
          "formula_id": "arc_length_definition",
          "name_ko": "호의 길이의 정의",
          "role": "definition",
          "latex": "L=\\lim_{n\\to\\infty}\\sum_{i=1}^n|P_{i-1}P_i|",
          "cas": "limit(Sum(dist(P[i-1],P[i]), (i,1,n)), n, oo)"
        },
        {
          "formula_id": "arc_length_formula",
          "name_ko": "호의 길이 공식",
          "role": "theorem",
          "latex": "L=\\int_a^b\\sqrt{1+[f'(x)]^2}\\,dx=\\int_a^b\\sqrt{1+\\left(\\frac{dy}{dx}\\right)^2}\\,dx",
          "cas": "Integral(sqrt(1+diff(f(x),x)**2), (x,a,b))"
        },
        {
          "formula_id": "arc_length_function",
          "name_ko": "호의 길이 함수",
          "role": "definition",
          "latex": "s(x)=\\int_a^x\\sqrt{1+[f'(t)]^2}\\,dt,\\qquad\\frac{ds}{dx}=\\sqrt{1+\\left(\\frac{dy}{dx}\\right)^2}",
          "cas": "Integral(sqrt(1+diff(f(t),t)**2), (t,a,x))"
        },
        {
          "formula_id": "differential_arc_length",
          "name_ko": "미분 형태(대칭적 표현)",
          "role": "notation",
          "latex": "ds=\\sqrt{1+\\left(\\frac{dy}{dx}\\right)^2}\\,dx,\\qquad(ds)^2=(dx)^2+(dy)^2",
          "cas": "sqrt(1+(dy/dx)**2)*dx"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "f_prime_continuous_smooth",
          "description": "f(또는 f')이 [a,b]에서 연속이어야 한다. 이런 함수를 '매끄럽다'고 한다.",
          "rule": {
            "property": "f_prime_continuous_on_a_b",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "mvt_in_derivation",
          "description": "공식 유도에는 평균값 정리를 각 부분구간 [x_{i-1},x_i]에 적용해 Δy_i=f'(x_i*)Δx로 근사하는 과정이 필요하다."
        },
        {
          "property_id": "rate_at_least_one",
          "description": "호의 길이 함수 s(x)의 변화율 ds/dx는 항상 1 이상이며, 곡선의 기울기가 0일 때만 1이 된다(√(1+기울기²)≥1이므로)."
        },
        {
          "property_id": "generalizes_circle_circumference",
          "description": "원의 둘레는 내접 다각형 둘레의 극한으로 정의되며, 호의 길이 정의는 이 아이디어를 일반적인 곡선으로 확장한 것이다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.rolles_theorem_and_mvt",
          "name_ko": "롤의 정리와 평균값 정리",
          "importance": "required"
        },
        {
          "concept_id": "calculus.trigonometric_substitution",
          "name_ko": "삼각치환",
          "importance": "recommended"
        }
      ],
      "related_concepts": [
        "calculus.surface_area_of_revolution"
      ],
      "learning_objectives": [
        {
          "objective_id": "set_up_arc_length_integral",
          "verb": "construct",
          "description": "y=f(x) 또는 x=g(y)로 주어진 곡선의 호의 길이 적분을 세운다."
        },
        {
          "objective_id": "compute_arc_length",
          "verb": "calculate",
          "description": "치환법·삼각치환을 이용해 호의 길이 적분을 계산한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "calculus.arc_length.integrate_derivative_directly",
          "title": "도함수 자체를 적분한다고 착각",
          "description": "호의 길이 공식의 피적분함수를 f'(x)로 착각해 기울기 자체를 적분한다.",
          "diagnosis_tag": "integrate_derivative_instead_of_arc_length_integrand",
          "feedback": "호의 길이 공식의 피적분함수는 f'(x)가 아니라 √(1+[f'(x)]²)이다."
        }
      ],
