        {
          "formula_id": "hydrostatic_force",
          "name_ko": "유체 정역학적 힘",
          "role": "theorem",
          "latex": "F=\\lim_{n\\to\\infty}\\sum_{i=1}^n\\rho gx_i^*w(x_i^*)\\Delta x=\\int\\rho gx\\,w(x)\\,dx",
          "cas": "Integral(rho*g*x*w(x), x)"
        }
      ],
      "application_conditions": [
