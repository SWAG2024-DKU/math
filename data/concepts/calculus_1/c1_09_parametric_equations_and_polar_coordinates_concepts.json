  "concepts": [
    {
      "concept_id": "calculus.parametric_curves",
      "order": 1,
      "name_ko": "매개변수로 정의되는 곡선",
      "definition": "수직선 판정을 통과하지 못해 y=f(x) 형태로 나타낼 수 없는 곡선도, x와 y를 제3의 매개변수 t의 함수 x=f(t), y=g(t)로 나타내면 표현할 수 있다.",
      "formulas": [
        {
          "formula_id": "parametric_equations",
          "name_ko": "매개방정식",
          "role": "definition",
          "latex": "x=f(t),\\qquad y=g(t)",
          "cas": "(f(t), g(t))"
        },
        {
          "formula_id": "circle_parametrization",
          "name_ko": "원의 매개방정식",
          "role": "example",
          "latex": "x=h+r\\cos t,\\qquad y=k+r\\sin t,\\qquad0\\le t\\le2\\pi",
          "cas": "(h+r*cos(t), k+r*sin(t))"
        },
        {
          "formula_id": "cycloid_parametrization",
          "name_ko": "사이클로이드",
          "role": "example",
          "latex": "x=r(\\theta-\\sin\\theta),\\qquad y=r(1-\\cos\\theta)",
          "cas": "(r*(theta-sin(theta)), r*(1-cos(theta)))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "restricted_t_gives_start_end",
          "description": "t가 구간 [a,b]로 제한되면 (f(a),g(a))가 시작점, (f(b),g(b))가 끝점이다.",
          "rule": {
            "property": "t_restricted_to_a_b",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "elimination_not_always_possible",
          "description": "매개변수를 소거해 x, y만의 방정식을 얻을 수 있는 경우도 있지만 항상 가능한 것은 아니다.",
          "rule": {
            "property": "parameter_elimination_possible",
            "operator": "not_equals",
            "value": "always"
          }
        }
      ],
      "properties": [
        {
          "property_id": "elimination_loses_direction_info",
          "description": "매개변수를 소거하면 곡선의 모양만 알 수 있고, 매개방정식이 담고 있는 각 시각의 위치·운동 방향 정보는 사라진다."
        },
        {
          "property_id": "same_curve_different_parametrization",
          "description": "같은 곡선(점의 집합)이라도 서로 다른 매개방정식으로 표현될 수 있다(예: 단위원을 한 번 도는 표현과 두 번 도는 표현)."
        },
        {
          "property_id": "trivial_parametrization_of_explicit_function",
          "description": "y=f(x) 형태의 그래프는 x=t, y=f(t)로 매개화할 수 있다."
        },
        {
          "property_id": "cycloid_brachistochrone_tautochrone",
          "description": "사이클로이드는 최단강하선(중력만으로 A에서 B까지 가장 빨리 미끄러지는 곡선) 문제와 등시곡선(출발 높이와 무관하게 도달 시간이 같은 곡선) 문제의 해다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.function",
          "name_ko": "함수, 정의역과 치역",
          "importance": "required"
        }
