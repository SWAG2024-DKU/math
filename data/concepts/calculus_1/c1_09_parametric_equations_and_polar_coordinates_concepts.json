    {
      "concept_id": "calculus.parametric_tangent_line",
      "order": 2,
      "name_ko": "매개변수곡선의 접선과 이계도함수",
      "definition": "매개곡선 x=f(t), y=g(t)의 접선의 기울기는 연쇄법칙으로부터 dy/dx=(dy/dt)/(dx/dt)이다(dx/dt≠0). 이계도함수는 dy/dx를 다시 t에 관해 미분한 뒤 dx/dt로 나누어 구한다.",
      "formulas": [
        {
          "formula_id": "parametric_tangent_slope",
          "name_ko": "접선의 기울기",
          "role": "theorem",
          "latex": "\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt}\\quad(dx/dt\\neq0)",
          "cas": "diff(g(t),t)/diff(f(t),t)"
        },
        {
          "formula_id": "parametric_second_derivative",
          "name_ko": "이계도함수",
          "role": "theorem",
          "latex": "\\frac{d^2y}{dx^2}=\\frac{\\dfrac{d}{dt}\\left(\\dfrac{dy}{dx}\\right)}{dx/dt}",
          "cas": "diff(dydx, t)/diff(f(t),t)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "dx_dt_nonzero_for_tangent",
          "description": "접선 공식은 dx/dt≠0일 때 성립한다. dy/dt=0, dx/dt≠0이면 수평접선, dy/dt≠0, dx/dt=0이면 수직접선이며, 둘 다 0이면 다른 방법(로피탈 법칙 등)이 필요하다.",
          "rule": {
            "property": "dx_dt",
            "operator": "not_equals",
            "value": 0
          }
        }
      ],
      "properties": [
        {
          "property_id": "self_intersection_multiple_tangents",
          "description": "자기교차점에서는 서로 다른 t값이 같은 점 (x,y)에 대응하며, 각 t값에서 별개의 접선 기울기를 가질 수 있다."
        },
        {
          "property_id": "lhopital_at_singular_point",
          "description": "dx/dt=dy/dt=0이 되는 특이점(사이클로이드의 꼭짓점 등)에서는 로피탈 법칙으로 접선의 기울기를 구할 수 있다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.parametric_curves",
          "name_ko": "매개변수로 정의되는 곡선",
          "importance": "required"
        },
        {
          "concept_id": "calculus.chain_rule",
          "name_ko": "연쇄법칙",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.parametric_area_arc_length_and_surface"
      ],
      "learning_objectives": [
        {
          "objective_id": "compute_parametric_tangent_slope",
          "verb": "calculate",
          "description": "매개곡선의 접선의 기울기를 구한다."
        },
        {
          "objective_id": "find_horizontal_vertical_tangents",
          "verb": "calculate",
          "description": "수평접선·수직접선이 나타나는 t값을 찾는다."
        },
        {
          "objective_id": "compute_parametric_second_derivative",
          "verb": "calculate",
          "description": "매개곡선의 이계도함수를 구한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "calculus.parametric_tangent.wrong_second_derivative",
          "title": "이계도함수를 (d²y/dt²)/(d²x/dt²)로 착각",
          "description": "매개곡선의 이계도함수를 dy/dx 공식과 유사하게 (d²y/dt²)을 (d²x/dt²)으로 직접 나눈다.",
          "diagnosis_tag": "wrong_parametric_second_derivative_formula",
          "feedback": "이계도함수는 (dy/dx)를 다시 t에 관해 미분한 뒤 dx/dt로 나누어야 하며, d²y/dt²을 d²x/dt²으로 직접 나누는 것이 아니다."
        }
      ],
