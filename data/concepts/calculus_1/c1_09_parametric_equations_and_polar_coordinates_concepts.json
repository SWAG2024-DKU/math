    {
      "concept_id": "calculus.parametric_area_arc_length_and_surface",
      "order": 3,
      "name_ko": "매개변수곡선의 넓이·호의 길이·곡면 넓이",
      "definition": "매개곡선 아래 넓이는 A=∫y dx=∫g(t)f'(t)dt(치환적분)로, 호의 길이는 L=∫√((dx/dt)²+(dy/dt)²)dt로, x축 회전 곡면의 넓이는 S=∫2πy√((dx/dt)²+(dy/dt)²)dt로 계산한다. 이 공식들은 곡선이 매개변수 구간에서 정확히 한 번만 그려질 때만 정확하다.",
      "formulas": [
        {
          "formula_id": "parametric_area",
          "name_ko": "매개곡선의 넓이",
          "role": "theorem",
          "latex": "A=\\int_a^by\\,dx=\\int_\\alpha^\\beta g(t)f'(t)\\,dt",
          "cas": "Integral(g(t)*diff(f(t),t), (t, alpha, beta))"
        },
        {
          "formula_id": "parametric_arc_length",
          "name_ko": "매개곡선의 호의 길이",
          "role": "theorem",
          "latex": "L=\\int_\\alpha^\\beta\\sqrt{\\left(\\frac{dx}{dt}\\right)^2+\\left(\\frac{dy}{dt}\\right)^2}\\,dt",
          "cas": "Integral(sqrt(diff(f(t),t)**2+diff(g(t),t)**2), (t,alpha,beta))"
        },
        {
          "formula_id": "parametric_speed",
          "name_ko": "속력",
          "role": "application",
          "latex": "v(t)=s'(t)=\\sqrt{\\left(\\frac{dx}{dt}\\right)^2+\\left(\\frac{dy}{dt}\\right)^2}",
          "cas": "sqrt(diff(f(t),t)**2+diff(g(t),t)**2)"
        },
        {
          "formula_id": "parametric_surface_area",
          "name_ko": "곡면의 넓이(x축 회전)",
          "role": "theorem",
          "latex": "S=\\int_\\alpha^\\beta2\\pi y\\sqrt{\\left(\\frac{dx}{dt}\\right)^2+\\left(\\frac{dy}{dt}\\right)^2}\\,dt\\quad(g(t)\\ge0)",
          "cas": "Integral(2*pi*g(t)*sqrt(diff(f(t),t)**2+diff(g(t),t)**2), (t,alpha,beta))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "traced_exactly_once",
          "description": "호의 길이·곡면 넓이 공식은 곡선이 매개변수 구간에서 정확히 한 번만 지나가야 정확한 값을 준다. 두 번 그려지면 실제 길이의 배수로 잘못 계산된다.",
          "rule": {
            "property": "curve_traced_exactly_once_on_interval",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "surface_needs_nonnegative_y",
          "description": "x축 회전 곡면 넓이 공식은 g(t)≥0을 전제로 한다.",
          "rule": {
            "property": "g(t)",
            "operator": "greater_or_equal",
            "value": 0
          }
        }
      ],
      "properties": [
        {
          "property_id": "cycloid_area_and_length",
          "description": "사이클로이드의 한 호 아래 넓이는 구르는 원의 넓이의 3배(3πr²)이고, 한 호의 길이는 원의 반지름의 8배(8r)이다."
        }
      ],
      "prerequisites": [
