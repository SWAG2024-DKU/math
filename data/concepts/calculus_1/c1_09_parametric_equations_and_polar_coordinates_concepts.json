    {
      "concept_id": "calculus.conic_sections",
      "order": 7,
      "name_ko": "원뿔곡선(포물선·타원·쌍곡선)",
      "definition": "원뿔을 평면으로 자를 때 나타나는 곡선으로, 포물선은 초점과 준선까지의 거리가 같은 점들의 집합, 타원은 두 초점까지의 거리의 합이 일정한 점들의 집합, 쌍곡선은 두 초점까지의 거리의 차가 일정한 점들의 집합으로 정의되며 각각 표준 방정식을 갖는다.",
      "formulas": [
        {
          "formula_id": "parabola_standard_form",
          "name_ko": "포물선의 표준형",
          "role": "standard_form",
          "latex": "x^2=4py\\ (\\text{초점}(0,p),\\text{준선}y=-p),\\qquad y^2=4px\\ (\\text{초점}(p,0),\\text{준선}x=-p)",
          "cas": "Eq(x**2, 4*p*y)"
        },
        {
          "formula_id": "ellipse_standard_form",
          "name_ko": "타원의 표준형(가로축)",
          "role": "standard_form",
          "latex": "\\frac{x^2}{a^2}+\\frac{y^2}{b^2}=1\\ (a\\ge b>0,\\ c^2=a^2-b^2,\\ \\text{초점}(\\pm c,0))",
          "cas": "Eq(x**2/a**2+y**2/b**2, 1)"
        },
        {
          "formula_id": "ellipse_standard_form_vertical",
          "name_ko": "타원의 표준형(세로축)",
          "role": "standard_form",
          "latex": "\\frac{x^2}{b^2}+\\frac{y^2}{a^2}=1\\ (a\\ge b>0,\\ c^2=a^2-b^2,\\ \\text{초점}(0,\\pm c))",
          "cas": "Eq(x**2/b**2+y**2/a**2, 1)"
        },
        {
          "formula_id": "hyperbola_standard_form",
          "name_ko": "쌍곡선의 표준형(가로축)",
          "role": "standard_form",
          "latex": "\\frac{x^2}{a^2}-\\frac{y^2}{b^2}=1\\ (c^2=a^2+b^2,\\ \\text{초점}(\\pm c,0),\\ \\text{점근선}y=\\pm\\tfrac ba x)",
