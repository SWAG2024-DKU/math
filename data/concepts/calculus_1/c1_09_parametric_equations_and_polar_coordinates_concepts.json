    {
      "concept_id": "calculus.polar_coordinates",
      "order": 4,
      "name_ko": "극좌표계와 극곡선",
      "definition": "극(원점)과 극축을 기준으로 점까지의 거리 r과 극축으로부터의 각 θ로 점을 나타내는 좌표계다. 한 점은 (r,θ+2nπ), (-r,θ+(2n+1)π) 등 무한히 많은 표현을 가지며, r<0이면 점은 θ의 반대쪽에 있다.",
      "formulas": [
        {
          "formula_id": "polar_to_cartesian",
          "name_ko": "극좌표 → 직교좌표",
          "role": "transformation",
          "latex": "x=r\\cos\\theta,\\qquad y=r\\sin\\theta",
          "cas": "(r*cos(theta), r*sin(theta))"
        },
        {
          "formula_id": "cartesian_to_polar",
          "name_ko": "직교좌표 → 극좌표",
          "role": "transformation",
          "latex": "r^2=x^2+y^2,\\qquad\\tan\\theta=\\frac{y}{x}",
          "cas": "(sqrt(x**2+y**2), atan2(y,x))"
        },
        {
          "formula_id": "common_polar_curves",
          "name_ko": "대표적인 극곡선",
          "role": "example",
          "latex": "r=a\\pm b\\sin\\theta,\\ r=a\\pm b\\cos\\theta\\ (\\text{리마송}),\\qquad r=a\\sin n\\theta,\\ r=a\\cos n\\theta\\ (\\text{장미 곡선})",
          "cas": "a+b*sin(theta)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "point_not_unique",
          "description": "극좌표에서 한 점은 유일하게 표현되지 않는다: (r,θ)는 (r,θ+2nπ), (-r,θ+(2n+1)π)와 같은 점을 나타낸다(n은 정수).",
          "rule": {
            "property": "polar_representation_not_unique",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "theta_from_quadrant_not_tan_alone",
          "description": "tanθ=y/x만으로는 θ가 유일하게 결정되지 않으므로, 점이 실제로 있는 사분면을 보고 θ를 정해야 한다.",
          "rule": {
            "property": "theta_determined_by_quadrant",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "symmetry_tests",
          "description": "θ→-θ 불변이면 극축 대칭, r→-r 또는 θ→π+θ 불변이면 극(원점) 대칭, θ→π-θ 불변이면 θ=π/2(세로축) 대칭이다."
        },
        {
          "property_id": "sketch_via_r_theta_graph",
          "description": "극곡선의 개형은 r을 θ의 함수로 직교좌표에 먼저 그린 뒤, 그 증가·감소 패턴을 따라가며 그리는 방법이 유용하다."
        },
        {
          "property_id": "circle_and_cardioid_examples",
          "description": "r=2cosθ는 중심 (1,0), 반지름 1인 원 (x-1)²+y²=1과 동치이며, r=1+sinθ는 심장형, r=cos2θ는 4엽 장미다."
        },
