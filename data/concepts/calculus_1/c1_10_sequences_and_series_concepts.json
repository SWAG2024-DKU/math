        },
        {
          "concept_id": "calculus.squeeze_theorem",
          "name_ko": "조임정리",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.monotonic_and_bounded_sequence"
      ],
      "learning_objectives": [
