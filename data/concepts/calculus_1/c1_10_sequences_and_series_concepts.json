    {
      "concept_id": "calculus.monotonic_and_bounded_sequence",
      "order": 2,
      "name_ko": "단조수열·유계수열과 단조수열 정리",
      "definition": "수열이 증가(a_n<a_{n+1}) 또는 감소(a_n>a_{n+1})하면 단조수열, 위·아래로 유계이면 유계수열이라 한다. 단조수열 정리는 유계이고 단조인 수열이 반드시 수렴함을 보장한다. 점화식으로 정의된 수열은 단조성·유계성을 보인 뒤 이 정리로 수렴을 증명할 수 있다.",
      "formulas": [
        {
          "formula_id": "monotonic_sequence_def",
          "name_ko": "단조수열의 정의",
          "role": "definition",
          "latex": "a_n<a_{n+1}\\ (\\text{증가}),\\qquad a_n>a_{n+1}\\ (\\text{감소})",
          "cas": "a[n] < a[n+1]"
        },
        {
          "formula_id": "bounded_sequence_def",
          "name_ko": "유계수열의 정의",
          "role": "definition",
          "latex": "\\exists M,\\ a_n\\le M\\ (\\text{위로 유계});\\qquad\\exists m,\\ a_n\\ge m\\ (\\text{아래로 유계})",
          "cas": "a[n] <= M"
        },
        {
          "formula_id": "monotonic_sequence_theorem",
          "name_ko": "단조수열 정리",
          "role": "theorem",
          "latex": "\\text{단조}+\\text{유계}\\implies\\text{수렴}",
          "cas": "converges(a_n)"
        },
        {
          "formula_id": "recursive_sequence_limit",
          "name_ko": "점화수열의 극한",
          "role": "theorem",
          "latex": "a_{n+1}=F(a_n),\\ a_n\\to L,\\ F\\text{가 }L\\text{에서 연속}\\implies L=F(L)",
          "cas": "solve(Eq(L, F(L)), L)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "monotonic_theorem_from_completeness",
          "description": "단조수열 정리는 실수의 완비공리로부터 유도된다.",
          "rule": {
            "property": "derived_from_completeness_axiom",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "recursive_needs_convergence_first",
          "description": "점화수열의 극한 공식을 쓰려면 수렴이 먼저 보장되어야 하며, F가 극한값에서 연속이어야 한다.",
          "rule": {
            "property": "convergence_established_before_solving_L",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "bounded_not_sufficient_alone",
          "description": "유계라고 반드시 수렴하는 것은 아니다(예: a_n=(-1)^n은 유계지만 발산)."
        },
        {
          "property_id": "monotonic_not_sufficient_alone",
          "description": "단조라고 반드시 수렴하는 것도 아니다(예: a_n=n)."
        },
        {
          "property_id": "induction_for_recursive_proof",
          "description": "점화식 수열(예: a_1=2, a_{n+1}=(a_n+6)/3)은 수학적 귀납법으로 단조성·유계성을 보인 뒤 단조수열 정리로 수렴을 증명하고, lim a_{n+1}=lim a_n=L을 점화식에 대입해 L을 구한다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.sequence_limit",
          "name_ko": "수열의 극한",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.series_convergence"
      ],
      "learning_objectives": [
        {
          "objective_id": "classify_monotonicity_and_boundedness",
          "verb": "classify",
          "description": "수열의 단조성과 유계성을 판별한다."
