    {
      "concept_id": "calculus.series_convergence",
      "order": 3,
      "name_ko": "급수의 수렴, 기하급수, 발산판정법",
      "definition": "무한수열 {a_n}의 모든 항의 합 Σa_n을 무한급수라 하며, 부분합 수열 s_n=Σ[i=1,n]a_i의 극한이 존재할 때 그 값을 급수의 합이라 한다. 기하급수 Σar^{n-1}은 |r|<1이면 a/(1-r)로 수렴하고 |r|≥1이면 발산한다. lim a_n이 0이 아니거나 존재하지 않으면 급수는 발산한다(발산판정법) — 단 lim a_n=0은 수렴의 필요조건일 뿐 충분조건이 아니다.",
      "formulas": [
        {
          "formula_id": "series_sum_def",
          "name_ko": "급수의 합",
          "role": "definition",
          "latex": "\\sum_{n=1}^\\infty a_n=\\lim_{n\\to\\infty}s_n,\\qquad s_n=\\sum_{i=1}^na_i",
          "cas": "Sum(a_n, (n,1,oo))"
        },
        {
          "formula_id": "geometric_series_sum",
          "name_ko": "기하급수의 합",
          "role": "theorem",
          "latex": "\\sum_{n=1}^\\infty ar^{n-1}=\\frac{a}{1-r}\\quad(|r|<1)",
          "cas": "a/(1-r)"
        },
        {
          "formula_id": "divergence_test",
          "name_ko": "발산판정법",
          "role": "theorem",
          "latex": "\\lim_{n\\to\\infty}a_n\\neq0\\ (\\text{또는 부존재})\\implies\\sum a_n\\text{ 발산}",
          "cas": "limit(a_n, n, oo)"
        },
        {
          "formula_id": "series_linearity",
          "name_ko": "급수의 선형성",
          "role": "theorem",
          "latex": "\\sum ca_n=c\\sum a_n,\\qquad\\sum(a_n\\pm b_n)=\\sum a_n\\pm\\sum b_n",
          "cas": "c*Sum(a_n,(n,1,oo))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "divergence_test_only_shows_divergence",
          "description": "발산판정법은 발산만 보일 수 있다. lim a_n=0이라고 해서 급수가 수렴한다고 결론지을 수 없다(조화급수가 대표적 반례).",
          "rule": {
