  "concepts": [
    {
      "concept_id": "calculus.sequence_limit",
      "order": 1,
      "name_ko": "수열의 극한",
      "definition": "무한수열은 양의 정수를 정의역으로 갖는 함수로 볼 수 있다. n이 충분히 클 때 a_n이 고정된 값 L에 가까워지면 수열은 L로 수렴한다고 하고, 그렇지 않으면 발산한다고 한다. f(n)=a_n이고 lim(x→∞)f(x)=L이면 lim(n→∞)a_n=L이다(역은 성립하지 않음).",
      "formulas": [
        {
          "formula_id": "sequence_limit_def",
          "name_ko": "수열의 극한",
          "role": "definition",
          "latex": "\\lim_{n\\to\\infty}a_n=L",
          "cas": "limit(a_n, n, oo)"
        },
        {
          "formula_id": "function_to_sequence_limit",
          "name_ko": "함수의 극한과의 연결",
          "role": "theorem",
          "latex": "f(n)=a_n,\\ \\lim_{x\\to\\infty}f(x)=L\\implies\\lim_{n\\to\\infty}a_n=L",
          "cas": "limit(f(x), x, oo)"
        },
        {
          "formula_id": "sequence_limit_laws",
          "name_ko": "수열의 극한법칙",
          "role": "theorem",
          "latex": "\\lim(a_n\\pm b_n)=\\lim a_n\\pm\\lim b_n,\\quad\\lim(a_nb_n)=\\lim a_n\\cdot\\lim b_n,\\quad\\lim\\frac{a_n}{b_n}=\\frac{\\lim a_n}{\\lim b_n}\\ (\\lim b_n\\neq0)",
          "cas": "limit(a_n+b_n, n, oo)"
        },
        {
          "formula_id": "geometric_sequence_limit",
          "name_ko": "등비수열의 극한",
          "role": "theorem",
          "latex": "\\lim_{n\\to\\infty}r^n=\\begin{cases}0&|r|<1\\\\1&r=1\\\\\\text{부존재}&r>1\\text{ 또는 }r\\le-1\\end{cases}",
          "cas": "limit(r**n, n, oo)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "function_limit_theorem_converse_fails",
          "description": "함수의 극한으로부터 수열의 극한을 얻는 정리는 역이 성립하지 않는다 — 수열의 수렴으로부터 대응 함수의 극한을 함부로 말할 수 없다.",
          "rule": {
            "property": "converse_of_function_to_sequence_limit_theorem",
            "operator": "equals",
            "value": false
          }
        },
        {
          "condition_id": "sequence_squeeze_theorem",
          "description": "수열의 조임정리는 어떤 N 이후 모든 n에서 a_n≤b_n≤c_n이고 lim a_n=lim c_n=L이면 lim b_n=L이다(처음 유한개 항은 무시 가능).",
          "rule": {
            "property": "inequality_holds_eventually",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "abs_value_limit_zero",
          "description": "lim|a_n|=0이면 lim a_n=0이다."
        },
        {
          "property_id": "geometric_convergence_range",
          "description": "{r^n}은 -1<r≤1일 때만 수렴한다."
        },
        {
          "property_id": "lhopital_bypass",
          "description": "n이 정수가 아닌 실변수로 자연스럽게 확장 가능할 때, 함수의 극한 정리를 이용해 로피탈 법칙을 우회 적용할 수 있다."
        }
      ],
      "prerequisites": [
