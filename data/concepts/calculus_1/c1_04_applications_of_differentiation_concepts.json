      "concept_id": "calculus.lhopitals_rule",
      "order": 6,
      "name_ko": "부정형과 로피탈 법칙",
      "definition": "f, g가 a 근방(a 자신은 제외 가능)에서 미분가능하고 g'(x)≠0이며, f(x)/g(x)가 0/0 또는 ∞/∞ 꼴 부정형이면, 우변의 극한이 존재하거나 ±∞이면 lim f(x)/g(x)=lim f'(x)/g'(x)이다. 곱·차·거듭제곱 부정형은 대수적 변형으로 0/0 또는 ∞/∞ 꼴로 바꾼 뒤 적용한다.",
      "formulas": [
        {
          "formula_id": "lhopitals_rule",
          "name_ko": "로피탈 법칙",
          "role": "theorem",
          "latex": "\\lim_{x\\to a}\\frac{f(x)}{g(x)}=\\lim_{x\\to a}\\frac{f'(x)}{g'(x)}",
          "cas": "limit(diff(f(x),x)/diff(g(x),x), x, a)"
        },
        {
          "formula_id": "product_indeterminate_transform",
          "name_ko": "곱 부정형의 변형",
          "role": "transformation",
          "latex": "0\\cdot\\infty:\\quad fg=\\frac{f}{1/g}\\ \\text{또는}\\ fg=\\frac{g}{1/f}",
          "cas": "f(x)/(1/g(x))"
        },
        {
          "formula_id": "power_indeterminate_transform",
          "name_ko": "거듭제곱 부정형의 변형",
          "role": "transformation",
          "latex": "y=[f(x)]^{g(x)}\\implies\\ln y=g(x)\\ln f(x)\\implies y=e^{\\ln y}",
          "cas": "exp(g(x)*log(f(x)))"
        },
