  "concepts": [
    {
      "concept_id": "calculus.extreme_values_and_fermats_theorem",
      "order": 1,
      "name_ko": "최댓값·최솟값, 극값 정리, 페르마 정리와 임계수",
      "definition": "정의역 D의 모든 x에서 f(c)≥f(x)이면 f(c)는 절대최댓값, f(c)≤f(x)이면 절대최솟값이다. c 근방에서만 이 부등식이 성립하면 극값(국소극값)이라 한다. 극값 정리는 폐구간에서 연속인 함수가 최댓값·최솟값을 반드시 가짐을 보장하고, 페르마 정리는 극값에서 미분가능하면 도함수가 0임을 말한다. 임계수는 f'(c)=0이거나 f'(c)가 존재하지 않는 정의역 안의 점이다.",
      "formulas": [
        {
          "formula_id": "absolute_extrema_def",
          "name_ko": "절대최댓값·최솟값의 정의",
          "role": "definition",
          "latex": "\\forall x\\in D,\\ f(c)\\ge f(x)\\implies f(c)\\text{는 절대최댓값},\\qquad f(c)\\le f(x)\\implies f(c)\\text{는 절대최솟값}",
          "cas": "Max(f(x) for x in D)"
        },
        {
          "formula_id": "local_extrema_def",
          "name_ko": "극값(국소극값)의 정의",
          "role": "definition",
          "latex": "c\\text{ 근방에서 }f(c)\\ge f(x)\\implies\\text{극댓값},\\qquad f(c)\\le f(x)\\implies\\text{극솟값}",
          "cas": "local_max(f, c)"
        },
        {
          "formula_id": "extreme_value_theorem",
          "name_ko": "극값 정리",
          "role": "theorem",
          "latex": "f\\text{가 }[a,b]\\text{에서 연속}\\implies f\\text{는 }[a,b]\\text{에서 최댓값과 최솟값을 가짐}",
          "cas": "Max(f, [a,b])"
        },
        {
          "formula_id": "fermats_theorem",
          "name_ko": "페르마 정리",
          "role": "theorem",
          "latex": "f\\text{가 }c\\text{에서 극값을 갖고 }f'(c)\\text{가 존재}\\implies f'(c)=0",
          "cas": "Eq(fprime(c), 0)"
        },
        {
          "formula_id": "critical_number_def",
          "name_ko": "임계수의 정의",
          "role": "definition",
          "latex": "f'(c)=0\\ \\text{또는}\\ f'(c)\\text{가 존재하지 않는 }c\\in\\text{정의역}",
          "cas": "solve(Eq(fprime(c), 0), c)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "evt_needs_closed_continuous",
          "description": "극값 정리는 폐구간에서의 연속성이 모두 필요하다. 구간이 열려 있거나 함수가 불연속이면 최댓값·최솟값이 존재하지 않을 수 있다.",
          "rule": {
            "property": "continuous_on_closed_interval",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "fermat_interior_point",
          "description": "페르마 정리에서 c는 정의역의 내부점이어야 하고 f'(c)가 존재해야 한다.",
          "rule": {
            "property": "c_is_interior_point_and_fprime_exists",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "local_vs_absolute",
          "description": "절대극값은 전체 정의역을 기준으로 하고, 극값(국소극값)은 한 점의 근방만을 기준으로 한다. 국소극값이 절대극값일 필요는 없다."
        },
        {
          "property_id": "fermat_one_direction_only",
          "description": "페르마 정리는 한쪽 방향으로만 성립한다: f'(c)=0이라고 해서 c가 반드시 극값인 것은 아니다(예: f(x)=x^3에서 f'(0)=0이지만 0은 극값이 아니다). 또한 극값에서 f'(c)가 존재하지 않을 수도 있다(예: f(x)=|x|의 0)."
        },
        {
          "property_id": "extrema_occur_at_critical_or_endpoints",
          "description": "극값은 임계수 또는 구간의 끝점에서만 발생할 수 있다."
        }
      ],
