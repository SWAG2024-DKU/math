    {
      "concept_id": "calculus.rolles_theorem_and_mvt",
      "order": 3,
      "name_ko": "롤의 정리와 평균값 정리",
      "definition": "롤의 정리는 f가 [a,b]에서 연속, (a,b)에서 미분가능하고 f(a)=f(b)이면 f'(c)=0인 c∈(a,b)가 존재함을 말한다. 평균값 정리(MVT)는 이를 일반화해, 같은 연속·미분가능 조건 아래 f'(c)가 구간 전체의 평균변화율과 같아지는 c가 존재함을 보장한다.",
      "formulas": [
        {
          "formula_id": "rolles_theorem",
          "name_ko": "롤의 정리",
          "role": "theorem",
          "latex": "f\\text{가 }[a,b]\\text{연속},(a,b)\\text{미분가능},f(a)=f(b)\\implies\\exists c\\in(a,b),f'(c)=0",
          "cas": "solve(Eq(fprime(c), 0), c)"
        },
        {
          "formula_id": "mean_value_theorem",
          "name_ko": "평균값 정리",
          "role": "theorem",
          "latex": "f\\text{가 }[a,b]\\text{연속},(a,b)\\text{미분가능}\\implies\\exists c\\in(a,b),\\ f'(c)=\\frac{f(b)-f(a)}{b-a}",
          "cas": "solve(Eq(fprime(c), (f(b)-f(a))/(b-a)), c)"
        },
        {
          "formula_id": "zero_derivative_constant",
          "name_ko": "도함수가 0인 함수",
          "role": "corollary",
          "latex": "(a,b)\\text{의 모든 }x\\text{에서 }f'(x)=0\\implies f\\text{는 상수함수}",
          "cas": "Eq(fprime(x), 0)"
        },
        {
          "formula_id": "same_derivative_differ_by_constant",
          "name_ko": "같은 도함수를 갖는 함수",
          "role": "corollary",
          "latex": "f'(x)=g'(x)\\ (\\text{구간 전체})\\implies f(x)=g(x)+C",
          "cas": "f(x) - g(x)"
        },
        {
          "formula_id": "derivative_bound_estimate",
          "name_ko": "도함수 상한·하한을 이용한 추정",
          "role": "corollary",
          "latex": "m\\le f'(x)\\le M\\ (\\text{on }[a,b])\\implies m(b-a)\\le f(b)-f(a)\\le M(b-a)",
          "cas": "m*(b-a) <= f(b)-f(a)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "rolle_three_hypotheses",
          "description": "롤의 정리는 폐구간에서 연속, 개구간에서 미분가능, 양 끝값이 같다는 세 가정이 모두 필요하다.",
