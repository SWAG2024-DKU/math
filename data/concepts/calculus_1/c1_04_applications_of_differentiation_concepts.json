      "concept_id": "calculus.indefinite_integral",
      "order": 8,
      "name_ko": "원시함수(부정적분)",
      "definition": "F'=f를 만족하는 함수 F를 f의 원시함수(역도함수, antiderivative)라 한다. F가 구간 I에서 f의 한 원시함수이면 I에서 f의 가장 일반적인 원시함수는 F(x)+C이며, 이를 부정적분 기호 ∫f(x)dx=F(x)+C로 나타낸다.",
      "formulas": [
        {
          "formula_id": "antiderivative_def",
          "name_ko": "원시함수의 정의",
          "role": "definition",
          "latex": "F'(x)=f(x)\\ (\\text{구간의 모든 }x)\\implies F\\text{는 }f\\text{의 원시함수}",
          "cas": "Eq(diff(F(x),x), f(x))"
        },
        {
          "formula_id": "general_antiderivative",
          "name_ko": "가장 일반적인 원시함수",
          "role": "theorem",
          "latex": "\\int f(x)\\,dx=F(x)+C",
          "cas": "integrate(f(x), x)"
        },
        {
          "formula_id": "antiderivative_linearity",
          "name_ko": "원시함수의 선형성",
          "role": "theorem",
          "latex": "\\int cf(x)\\,dx=c\\int f(x)\\,dx,\\qquad\\int[f(x)+g(x)]\\,dx=\\int f(x)\\,dx+\\int g(x)\\,dx",
          "cas": "c*integrate(f(x), x)"
        },
        {
          "formula_id": "antiderivative_table",
          "name_ko": "원시함수 공식표",
          "role": "table",
          "latex": "\\int x^n dx=\\frac{x^{n+1}}{n+1}+C\\ (n\\neq-1),\\quad\\int\\frac1xdx=\\ln|x|+C,\\quad\\int e^xdx=e^x+C,\\quad\\int\\sin xdx=-\\cos x+C",
          "cas": "integrate(x**n, x)"
        }
      ],
