    {
      "concept_id": "calculus.volume_by_cross_section",
      "order": 2,
      "name_ko": "절단면법에 의한 부피",
      "definition": "절단면의 넓이가 A(x)인 입체를 x=a에서 x=b까지 적분하면 부피 V=∫[a,b]A(x)dx를 얻는다. 절단면은 원, 고리뿐 아니라 정사각형, 삼각형, 반원 등 기하학적으로 정의되는 임의의 모양일 수 있다.",
      "formulas": [
        {
          "formula_id": "volume_by_cross_section",
          "name_ko": "절단면법",
          "role": "definition",
          "latex": "V=\\lim_{n\\to\\infty}\\sum_{i=1}^nA(x_i^*)\\Delta x=\\int_a^bA(x)\\,dx",
          "cas": "Integral(A(x), (x,a,b))"
        },
        {
          "formula_id": "square_cross_section",
          "name_ko": "정사각형 절단면",
          "role": "special_case",
          "latex": "A(x)=[s(x)]^2",
          "cas": "s(x)**2"
        },
        {
          "formula_id": "equilateral_triangle_cross_section",
          "name_ko": "정삼각형 절단면",
          "role": "special_case",
          "latex": "A(x)=\\frac{\\sqrt3}{4}[s(x)]^2",
          "cas": "sqrt(3)/4*s(x)**2"
        },
        {
          "formula_id": "semicircle_cross_section",
          "name_ko": "반원 절단면",
          "role": "special_case",
          "latex": "A(x)=\\frac{\\pi}{8}[d(x)]^2",
          "cas": "pi/8*d(x)**2"
        },
        {
          "formula_id": "sphere_volume_derivation",
          "name_ko": "구의 부피(절단면 유도)",
