  "concepts": [
    {
      "concept_id": "calculus.area_between_curves",
      "order": 1,
      "name_ko": "곡선 사이의 넓이",
      "definition": "구간 [a,b]에서 f(x)≥g(x)이면 두 곡선 y=f(x), y=g(x)와 직선 x=a,x=b로 둘러싸인 영역의 넓이는 ∫[a,b][f(x)-g(x)]dx이다. 위·아래 관계가 구간 안에서 바뀌면 절댓값을 취하거나 교점 기준으로 구간을 나눈다. 영역의 모양에 따라 y에 대해 적분(오른쪽 경계-왼쪽 경계)하는 것이 더 간단할 수도 있다.",
      "formulas": [
        {
          "formula_id": "area_between_curves_x",
          "name_ko": "x에 대한 넓이",
          "role": "definition",
          "latex": "A=\\int_a^b[f(x)-g(x)]\\,dx\\quad(f(x)\\ge g(x)\\text{ on }[a,b])",
          "cas": "Integral(f(x)-g(x), (x,a,b))"
        },
        {
          "formula_id": "area_between_curves_abs",
          "name_ko": "부호가 바뀌는 경우",
          "role": "generalization",
          "latex": "A=\\int_a^b|f(x)-g(x)|\\,dx",
          "cas": "Integral(Abs(f(x)-g(x)), (x,a,b))"
        },
        {
          "formula_id": "area_between_curves_y",
          "name_ko": "y에 대한 넓이",
          "role": "alternative_form",
          "latex": "A=\\int_c^d[x_R(y)-x_L(y)]\\,dy",
          "cas": "Integral(xR(y)-xL(y), (y,c,d))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "f_g_continuous_order_fixed",
          "description": "f, g는 연속함수여야 하며, x에 대해 적분할 때는 구간 전체에서 위·아래 경계가 바뀌지 않아야 한다(바뀌면 절댓값을 취하거나 구간을 나눈다).",
          "rule": {
            "property": "upper_lower_order_constant_on_interval",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "intersections_determine_bounds",
          "description": "교점을 먼저 구해 적분구간(경계값)을 정해야 한다.",
          "rule": {
            "property": "integration_bounds_from_intersections",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "riemann_sum_origin",
          "description": "넓이 공식은 대표 근사 직사각형(폭 Δx, 높이 f(x)-g(x))의 리만합의 극한으로 유도되며, g(x)=0인 특수한 경우 곡선 아래 넓이의 정의와 일치한다."
        },
        {
          "property_id": "choose_x_or_y_by_shape",
          "description": "위(또는 오른쪽) 경계나 아래(또는 왼쪽) 경계가 하나의 곡선으로 표현되는 변수를 택하면 계산이 간단해진다."
        },
        {
          "property_id": "symmetry_shortcut_for_area",
          "description": "영역이 대칭이면 절반만 적분하고 2배 하는 방식으로 계산을 간단히 할 수 있다."
        }
      ],
