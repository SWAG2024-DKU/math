    {
      "concept_id": "calculus.fundamental_theorem_of_calculus_part1",
      "order": 4,
      "name_ko": "미적분학의 기본 정리 1부(누적함수의 도함수)",
      "definition": "f가 [a,b]에서 연속이고 g(x)=∫[a,x]f(t)dt이면, g는 [a,b]에서 연속이고 (a,b)에서 미분가능하며 g'(x)=f(x)이다. 즉 적분한 뒤 미분하면 원래 함수가 복원된다.",
      "formulas": [
        {
          "formula_id": "ftc1",
          "name_ko": "미적분학의 기본 정리 1부",
          "role": "theorem",
          "latex": "f\\text{가 }[a,b]\\text{연속},\\ g(x)=\\int_a^xf(t)\\,dt\\implies g'(x)=f(x)",
          "cas": "diff(Integral(f(t), (t, a, x)), x)"
        },
        {
          "formula_id": "ftc1_chain_rule_variant",
          "name_ko": "가변 상한과 연쇄법칙의 결합",
          "role": "corollary",
          "latex": "\\frac{d}{dx}\\int_a^{g(x)}f(t)\\,dt=f(g(x))\\cdot g'(x)",
          "cas": "diff(Integral(f(t), (t, a, g(x))), x)"
        },
        {
          "formula_id": "ftc1_variable_bounds",
          "name_ko": "양쪽 적분한계가 변수인 경우",
          "role": "corollary",
          "latex": "\\frac{d}{dx}\\int_{u(x)}^{v(x)}f(t)\\,dt=f(v(x))v'(x)-f(u(x))u'(x)",
          "cas": "diff(Integral(f(t), (t, u(x), v(x))), x)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "f_continuous_on_ab_ftc1",
