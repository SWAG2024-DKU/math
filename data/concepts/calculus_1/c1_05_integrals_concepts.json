    {
      "concept_id": "calculus.integral",
      "order": 2,
      "name_ko": "정적분의 정의와 적분가능성",
      "definition": "정적분 ∫[a,b]f(x)dx는 리만합의 극한 lim(n→∞)Σf(x_i*)Δx으로 정의된다. f가 [a,b]에서 연속이거나 유한개의 도약 불연속점을 가지면 f는 [a,b]에서 적분가능하다.",
      "formulas": [
        {
          "formula_id": "definite_integral_def",
          "name_ko": "정적분의 정의",
          "role": "definition",
          "latex": "\\int_a^bf(x)\\,dx=\\lim_{n\\to\\infty}\\sum_{i=1}^nf(x_i^*)\\,\\Delta x",
          "cas": "Integral(f(x), (x, a, b))"
        },
        {
          "formula_id": "integrability_theorem",
          "name_ko": "적분가능성 정리",
          "role": "theorem",
          "latex": "f\\text{가 }[a,b]\\text{에서 연속이거나 유한개의 도약 불연속점}\\implies f\\text{는 }[a,b]\\text{에서 적분가능}",
          "cas": "is_integrable(f, a, b)"
        },
        {
          "formula_id": "orientation_convention",
          "name_ko": "적분 방향 규약",
          "role": "convention",
          "latex": "\\int_b^af(x)\\,dx=-\\int_a^bf(x)\\,dx,\\qquad\\int_a^af(x)\\,dx=0",
          "cas": "-Integral(f(x), (x,a,b))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "integrability_required",
          "description": "정적분이 존재하려면 적분가능성 정리의 조건(연속 또는 유한개의 도약 불연속)을 만족해야 한다. 무한 불연속점이 있으면 일반적인(부정적분이 아닌 이상적분) 의미로는 적분가능하지 않다.",
          "rule": {
