    {
      "concept_id": "calculus.integral_properties",
      "order": 3,
      "name_ko": "정적분의 성질과 중점 법칙",
      "definition": "정적분은 선형성, 구간의 가법성, 대소 비교 성질(1~8)을 만족한다. 성질 1~5는 a,b의 대소와 무관하게 성립하고, 대소 비교 성질(6~8)은 a≤b일 때만 성립한다. 중점 법칙은 각 부분구간의 중점에서의 함숫값으로 정적분을 근사하는 방법이다.",
      "formulas": [
        {
          "formula_id": "integral_linearity",
          "name_ko": "정적분의 선형성",
          "role": "theorem",
          "latex": "\\int_a^b[f(x)+g(x)]dx=\\int_a^bf\\,dx+\\int_a^bg\\,dx,\\qquad\\int_a^bcf(x)dx=c\\int_a^bf\\,dx",
          "cas": "Integral(f(x)+g(x), (x,a,b))"
        },
        {
          "formula_id": "integral_additivity",
          "name_ko": "구간의 가법성",
          "role": "theorem",
          "latex": "\\int_a^cf(x)dx+\\int_c^bf(x)dx=\\int_a^bf(x)dx",
          "cas": "Integral(f(x),(x,a,c))+Integral(f(x),(x,c,b))"
        },
        {
          "formula_id": "integral_comparison",
          "name_ko": "대소 비교 성질",
          "role": "theorem",
          "latex": "f(x)\\ge g(x)\\ (a\\le x\\le b)\\implies\\int_a^bf\\,dx\\ge\\int_a^bg\\,dx,\\qquad m\\le f(x)\\le M\\implies m(b-a)\\le\\int_a^bf\\,dx\\le M(b-a)",
          "cas": "Integral(f(x),(x,a,b)) >= Integral(g(x),(x,a,b))"
        },
        {
          "formula_id": "midpoint_rule",
          "name_ko": "중점 법칙",
          "role": "approximation",
          "latex": "\\int_a^bf(x)dx\\approx\\sum_{i=1}^nf(\\bar x_i)\\Delta x,\\qquad\\bar x_i=\\tfrac12(x_{i-1}+x_i)",
          "cas": "Sum(f((x[i-1]+x[i])/2)*Dx, (i,1,n))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "properties_1_5_any_order",
          "description": "선형성·가법성(성질 1~5)은 a<b, a=b, a>b 어느 경우에도 성립한다.",
          "rule": {
