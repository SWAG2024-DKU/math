        {
          "formula_id": "decreasing_condition",
          "name_ko": "감소함수 조건",
          "role": "condition",
          "latex": "x_1<x_2\\implies f(x_1)>f(x_2)",
          "cas": "Implies(x1<x2, f(x1)>f(x2))"
        }
      ],
      "application_conditions": [
