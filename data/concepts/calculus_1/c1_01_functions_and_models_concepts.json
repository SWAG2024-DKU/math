  "concepts": [
    {
      "concept_id": "calculus.function",
      "order": 1,
      "name_ko": "함수, 정의역과 치역",
      "definition": "함수 f는 집합 D의 각 원소 x를 집합 E에 있는 오직 한 원소 f(x)에 대응시키는 규칙이다. D를 정의역, f(x)를 x에서 f의 함숫값이라 하고, x가 정의역에서 변할 때 f(x)의 모든 값의 집합을 치역이라 한다.",
      "formulas": [
        {
          "formula_id": "function_notation",
          "name_ko": "함수 표기",
          "role": "definition",
          "latex": "y=f(x)",
          "cas": "y - f(x)"
        },
        {
          "formula_id": "function_graph",
          "name_ko": "함수의 그래프",
          "role": "definition",
          "latex": "\\{(x,f(x))\\mid x\\in D\\}",
          "cas": "{(x, f(x)) for x in D}"
        },
        {
          "formula_id": "difference_quotient",
          "name_ko": "차분몫",
          "role": "auxiliary_formula",
          "latex": "\\frac{f(a+h)-f(a)}{h}\\quad(h\\neq0)",
          "cas": "(f(a+h)-f(a))/h"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "domain_convention",
          "description": "함수가 수식으로만 주어지고 정의역이 명시되어 있지 않으면, 수식이 의미 있게 되는 모든 실수의 집합을 정의역으로 하는 정의역에 대한 관례를 따른다.",
          "rule": {
            "property": "domain_explicitly_given",
            "operator": "equals",
            "value": false
          }
        },
        {
          "condition_id": "vertical_line_test",
          "description": "좌표평면 위의 곡선이 어떤 함수의 그래프가 되기 위한 필요충분조건은 임의의 수직선이 곡선과 최대 한 점에서만 만나는 것이다.",
          "rule": {
            "property": "max_intersections_with_any_vertical_line",
            "operator": "less_or_equal",
            "value": 1
          }
        }
      ],
      "properties": [
        {
          "property_id": "graph_height_is_value",
          "description": "그래프 위 점 (x,y)의 y성분은 y=f(x)이므로, x 위의 그래프 높이가 곧 함숫값이다."
        },
        {
          "property_id": "difference_quotient_meaning",
          "description": "차분몫은 x=a와 x=a+h 사이의 평균변화율을 나타내며, 2장에서 평균변화율과 미분계수를 정의하는 기초가 된다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "algebra.real_numbers_and_intervals",
          "name_ko": "실수와 구간",
          "importance": "required"
        },
