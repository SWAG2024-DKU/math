    {
      "concept_id": "calculus.function_symmetry_monotonicity",
      "order": 3,
      "name_ko": "우함수·기함수와 증가·감소함수",
      "definition": "정의역의 모든 x에서 f(-x)=f(x)이면 우함수(짝함수), f(-x)=-f(x)이면 기함수(홀함수)라 한다. 구간 I에 속하는 모든 x1<x2에 대해 f(x1)<f(x2)이면 증가함수, f(x1)>f(x2)이면 감소함수다.",
      "formulas": [
        {
          "formula_id": "even_function",
          "name_ko": "우함수 조건",
          "role": "condition",
          "latex": "f(-x)=f(x)",
          "cas": "Eq(f(-x), f(x))"
        },
        {
          "formula_id": "odd_function",
          "name_ko": "기함수 조건",
          "role": "condition",
          "latex": "f(-x)=-f(x)",
