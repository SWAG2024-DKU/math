      "concept_id": "calculus.logarithm",
      "order": 9,
      "name_ko": "로그함수와 로그법칙",
      "definition": "b>0, b≠1일 때 지수함수 f(x)=b^x의 역함수가 로그함수 log_b x이며, 정의역은 (0,∞), 치역은 실수 전체다. 밑이 e인 로그를 자연로그라 하고 ln x로 쓴다.",
      "formulas": [
        {
          "formula_id": "log_definition",
          "name_ko": "로그의 정의",
          "role": "definition",
          "latex": "\\log_bx=y\\iff b^y=x",
          "cas": "Eq(log(x, b), y)"
        },
        {
          "formula_id": "log_cancellation",
          "name_ko": "로그 소거식",
          "role": "property",
          "latex": "\\log_b(b^x)=x\\ (x\\in\\mathbb{R}),\\qquad b^{\\log_bx}=x\\ (x>0)",
          "cas": "log(b**x, b) - x"
        },
        {
          "formula_id": "log_laws",
          "name_ko": "로그법칙",
          "role": "property",
          "latex": "\\log_b(xy)=\\log_bx+\\log_by,\\quad\\log_b\\left(\\frac{x}{y}\\right)=\\log_bx-\\log_by,\\quad\\log_b(x^r)=r\\log_bx",
          "cas": "log(x*y, b) - (log(x,b)+log(y,b))"
        },
        {
          "formula_id": "natural_log",
          "name_ko": "자연로그",
          "role": "definition",
          "latex": "\\ln x=y\\iff e^y=x,\\qquad\\ln(e^x)=x,\\qquad e^{\\ln x}=x,\\qquad\\ln e=1",
          "cas": "log(x)"
        },
        {
          "formula_id": "change_of_base",
          "name_ko": "밑변환 공식",
          "role": "transformation",
          "latex": "\\log_bx=\\frac{\\ln x}{\\ln b}",
          "cas": "log(x)/log(b)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "domain_positive",
          "description": "log_b x는 x>0에서만 정의된다.",
          "rule": {
            "property": "x",
            "operator": "greater_than",
            "value": 0
          }
        },
        {
          "condition_id": "laws_require_positive_args",
          "description": "로그법칙은 x, y가 모두 양수일 때 성립한다.",
          "rule": {
            "property": "arguments_positive",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "growth_rate",
          "description": "ln x는 (0,∞)에서 증가하지만 x>1일 때 매우 천천히 증가하며, x의 어떤 양의 제곱근함수보다도 느리게 증가한다."
        }
