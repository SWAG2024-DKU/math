  "concepts": [
    {
      "concept_id": "calculus.vectors_in_plane",
      "order": 1,
      "name_ko": "평면의 벡터",
      "definition": "벡터는 크기와 방향을 함께 가지는 양으로, 평면에서는 v=<v1,v2> 형태로 나타낸다. 두 점 P,Q에 대해 PQ벡터는 끝점에서 시작점 좌표를 뺀 <x2-x1,y2-y1>이며, 원점에서 점 P로 향하는 위치벡터로 점을 나타낼 수 있다.",
      "formulas": [
        {
          "formula_id": "vector_pq",
          "name_ko": "두 점을 잇는 벡터",
          "role": "definition",
          "latex": "\\overrightarrow{PQ}=\\langle x_2-x_1,\\ y_2-y_1\\rangle",
          "cas": "Matrix([x2-x1, y2-y1])"
        },
        {
          "formula_id": "vector_magnitude_2d",
          "name_ko": "벡터의 크기",
          "role": "definition",
          "latex": "\\|\\mathbf{v}\\|=\\sqrt{v_1^2+v_2^2}",
          "cas": "sqrt(v1**2+v2**2)"
        },
        {
          "formula_id": "unit_vector",
          "name_ko": "단위벡터",
          "role": "definition",
          "latex": "\\mathbf{u}=\\frac{\\mathbf{v}}{\\|\\mathbf{v}\\|}\\quad(\\mathbf{v}\\neq\\mathbf{0})",
          "cas": "v/v.norm()"
        },
        {
          "formula_id": "standard_basis_2d",
          "name_ko": "표준단위벡터",
          "role": "definition",
          "latex": "\\mathbf{i}=\\langle1,0\\rangle,\\ \\mathbf{j}=\\langle0,1\\rangle\\implies\\mathbf{v}=v_1\\mathbf{i}+v_2\\mathbf{j}",
          "cas": "v1*i+v2*j"
        },
        {
          "formula_id": "vector_addition_scalar",
          "name_ko": "덧셈·뺄셈·스칼라배",
          "role": "definition",
          "latex": "\\mathbf{u}\\pm\\mathbf{v}=\\langle u_1\\pm v_1,u_2\\pm v_2\\rangle,\\qquad c\\mathbf{v}=\\langle cv_1,cv_2\\rangle",
          "cas": "u+v"
        },
        {
          "formula_id": "direction_angle",
          "name_ko": "방향각",
          "role": "theorem",
          "latex": "\\mathbf{v}=\\|\\mathbf{v}\\|\\langle\\cos\\theta,\\sin\\theta\\rangle",
          "cas": "v.norm()*Matrix([cos(theta), sin(theta)])"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "unit_vector_requires_nonzero",
          "description": "영벡터는 방향이 정해지지 않으므로 단위벡터로 만들 수 없다(v≠0이어야 한다).",
          "rule": {
            "property": "v",
            "operator": "not_equals",
            "value": "zero_vector"
          }
        },
        {
          "condition_id": "direction_angle_needs_quadrant_check",
          "description": "방향각을 구할 때는 성분의 부호로부터 사분면을 확인해야 한다.",
          "rule": {
            "property": "theta_determined_by_quadrant",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "vector_algebra_properties",
          "description": "벡터의 덧셈은 교환·결합법칙을, 스칼라배는 분배법칙을 만족한다: u+v=v+u, (u+v)+w=u+(v+w), c(u+v)=cu+cv, (c+d)v=cv+dv, c(dv)=(cd)v."
        },
        {
          "property_id": "scalar_sign_determines_direction",
          "description": "c>0이면 cv의 방향이 v와 같고, c<0이면 반대이며, 크기는 |c|‖v‖이다."
        },
        {
          "property_id": "point_vs_vector_distinction",
          "description": "점과 벡터는 표기가 비슷하지만 서로 다른 개념이다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "algebra.pythagorean_theorem",
          "name_ko": "피타고라스 정리",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.vectors_in_3d_space"
      ],
      "learning_objectives": [
        {
          "objective_id": "construct_vector_from_points",
          "verb": "construct",
          "description": "두 점으로부터 벡터를 구한다."
        },
        {
          "objective_id": "compute_vector_magnitude_and_unit_vector",
          "verb": "calculate",
          "description": "벡터의 크기와 같은 방향의 단위벡터를 구한다."
        },
        {
          "objective_id": "compute_direction_angle",
          "verb": "calculate",
          "description": "벡터의 방향각을 구한다."
        }
      ],
      "misconceptions": [
