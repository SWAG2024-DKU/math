    {
      "concept_id": "calculus.dot_product",
      "order": 3,
      "name_ko": "내적",
      "definition": "u·v=u1v1+u2v2+u3v3로 정의되는 내적의 결과는 스칼라다. u·v=‖u‖‖v‖cosθ이므로 두 벡터 사이의 각과 직교 여부를 판정하는 데 쓰이며, 정사영·스칼라 성분·일(work) 계산에도 활용된다.",
      "formulas": [
        {
          "formula_id": "dot_product_definition",
          "name_ko": "내적의 정의",
          "role": "definition",
          "latex": "\\mathbf{u}\\cdot\\mathbf{v}=u_1v_1+u_2v_2+u_3v_3",
          "cas": "u1*v1+u2*v2+u3*v3"
        },
        {
          "formula_id": "dot_product_geometric",
          "name_ko": "내적의 기하학적 의미",
          "role": "theorem",
          "latex": "\\mathbf{u}\\cdot\\mathbf{v}=\\|\\mathbf{u}\\|\\|\\mathbf{v}\\|\\cos\\theta\\implies\\cos\\theta=\\frac{\\mathbf{u}\\cdot\\mathbf{v}}{\\|\\mathbf{u}\\|\\|\\mathbf{v}\\|}",
          "cas": "acos((u.dot(v))/(u.norm()*v.norm()))"
        },
        {
          "formula_id": "orthogonality_condition",
          "name_ko": "직교 조건",
          "role": "condition",
          "latex": "\\mathbf{u}\\cdot\\mathbf{v}=0\\ (\\mathbf{u},\\mathbf{v}\\neq\\mathbf{0})\\implies\\mathbf{u}\\perp\\mathbf{v}",
          "cas": "Eq(u.dot(v), 0)"
        },
        {
          "formula_id": "vector_projection",
          "name_ko": "벡터 정사영과 스칼라 성분",
          "role": "definition",
          "latex": "\\operatorname{proj}_{\\mathbf{v}}\\mathbf{u}=\\frac{\\mathbf{u}\\cdot\\mathbf{v}}{\\|\\mathbf{v}\\|^2}\\mathbf{v},\\qquad\\operatorname{comp}_{\\mathbf{v}}\\mathbf{u}=\\frac{\\mathbf{u}\\cdot\\mathbf{v}}{\\|\\mathbf{v}\\|}",
          "cas": "(u.dot(v)/v.dot(v))*v"
        },
        {
          "formula_id": "work_formula",
          "name_ko": "일",
          "role": "application",
          "latex": "W=\\mathbf{F}\\cdot\\mathbf{D}=\\|\\mathbf{F}\\|\\|\\mathbf{D}\\|\\cos\\theta",
          "cas": "F.dot(D)"
        },
        {
          "formula_id": "direction_cosines",
          "name_ko": "방향코사인",
          "role": "application",
          "latex": "\\cos\\alpha=\\frac a{\\|\\mathbf v\\|},\\cos\\beta=\\frac b{\\|\\mathbf v\\|},\\cos\\gamma=\\frac c{\\|\\mathbf v\\|},\\qquad\\cos^2\\alpha+\\cos^2\\beta+\\cos^2\\gamma=1",
          "cas": "a/v.norm()"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "angle_formula_needs_nonzero_vectors",
          "description": "각도공식과 직교 조건은 두 벡터가 모두 영벡터가 아니어야 적용된다.",
          "rule": {
            "property": "both_vectors_nonzero",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "dot_product_properties",
          "description": "내적은 교환법칙(u·v=v·u), 분배법칙(u·(v+w)=u·v+u·w), 결합법칙(스칼라)(cu)·v=c(u·v)을 만족하며, u·u=‖u‖²이다."
        },
        {
          "property_id": "projection_denominator_squared",
          "description": "정사영 공식의 분모는 ‖v‖²이며, 스칼라 성분(comp)의 분모는 ‖v‖로 다르다."
        },
        {
          "property_id": "work_depends_on_displacement_component",
          "description": "일은 힘의 전체 크기가 아니라 변위 방향 성분(F·D)에 의해 결정된다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.vectors_in_3d_space",
          "name_ko": "3차원 공간의 좌표와 벡터",
