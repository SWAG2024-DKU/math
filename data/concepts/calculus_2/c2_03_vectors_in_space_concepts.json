    {
      "concept_id": "calculus.vectors_in_3d_space",
      "order": 2,
      "name_ko": "3차원 공간의 좌표와 벡터",
      "definition": "3차원 공간의 점 P(x,y,z)는 세 개의 서로 수직인 좌표축으로 나타내며, 세 좌표평면(xy,xz,yz)이 공간을 여덟 개의 팔분공간으로 나눈다. 3차원 벡터는 v=<v1,v2,v3>=v1i+v2j+v3k로 나타내며, 크기와 두 점 사이의 거리·중점·구의 방정식은 2차원 공식에 z성분을 추가한 형태다.",
      "formulas": [
        {
          "formula_id": "distance_3d",
          "name_ko": "두 점 사이의 거리(3차원)",
          "role": "definition",
          "latex": "d(P,Q)=\\sqrt{(x_2-x_1)^2+(y_2-y_1)^2+(z_2-z_1)^2}",
          "cas": "sqrt((x2-x1)**2+(y2-y1)**2+(z2-z1)**2)"
        },
        {
          "formula_id": "midpoint_3d",
          "name_ko": "중점",
          "role": "definition",
          "latex": "M=\\left(\\frac{x_1+x_2}2,\\frac{y_1+y_2}2,\\frac{z_1+z_2}2\\right)",
          "cas": "((x1+x2)/2, (y1+y2)/2, (z1+z2)/2)"
        },
        {
          "formula_id": "sphere_equation",
          "name_ko": "구의 방정식",
          "role": "standard_form",
          "latex": "(x-h)^2+(y-k)^2+(z-l)^2=r^2",
          "cas": "Eq((x-h)**2+(y-k)**2+(z-l)**2, r**2)"
        },
        {
          "formula_id": "vector_3d_magnitude",
          "name_ko": "3차원 벡터의 크기",
          "role": "definition",
          "latex": "\\|\\mathbf{v}\\|=\\sqrt{v_1^2+v_2^2+v_3^2}",
          "cas": "sqrt(v1**2+v2**2+v3**2)"
        },
        {
          "formula_id": "standard_basis_3d",
          "name_ko": "3차원 표준단위벡터",
          "role": "definition",
          "latex": "\\mathbf{i}=\\langle1,0,0\\rangle,\\ \\mathbf{j}=\\langle0,1,0\\rangle,\\ \\mathbf{k}=\\langle0,0,1\\rangle",
          "cas": "(Matrix([1,0,0]), Matrix([0,1,0]), Matrix([0,0,1]))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "coordinate_plane_meaning",
          "description": "좌표평면의 방정식은 해당 축의 좌표가 0이라는 뜻이다(xy-평면: z=0 등).",
          "rule": {
            "property": "coordinate_plane_equation_sets_one_variable_zero",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
