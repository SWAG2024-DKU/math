    {
      "concept_id": "calculus.cross_product",
      "order": 4,
      "name_ko": "외적",
      "definition": "u×v는 3차원 벡터에서 정의되며, u와 v 모두에 수직인 벡터로 방향은 오른손법칙으로 정하고 크기는 ‖u×v‖=‖u‖‖v‖sinθ이다. 결과는 벡터이며 반교환적(u×v=-(v×u))이고, 두 벡터가 만드는 평행사변형의 넓이가 ‖u×v‖와 같다.",
      "formulas": [
        {
          "formula_id": "cross_product_definition",
          "name_ko": "외적의 정의",
          "role": "definition",
          "latex": "\\mathbf{u}\\times\\mathbf{v}=\\langle u_2v_3-u_3v_2,\\ u_3v_1-u_1v_3,\\ u_1v_2-u_2v_1\\rangle",
          "cas": "u.cross(v)"
