    {
      "concept_id": "calculus.vector_derivative_and_tangent",
      "order": 2,
      "name_ko": "벡터값 함수의 도함수와 접선",
      "definition": "벡터값 함수의 도함수 r'(t)는 극한으로 정의되며 성분별로 미분한 것과 같다: r'(t)=<f'(t),g'(t),h'(t)>. r'(t)≠0이면 이는 곡선의 접선 방향을 나타내며, 단위접선벡터는 T(t)=r'(t)/‖r'(t)‖이다.",
      "formulas": [
        {
          "formula_id": "vector_derivative_def",
          "name_ko": "도함수의 정의",
          "role": "definition",
          "latex": "\\mathbf{r}'(t)=\\lim_{h\\to0}\\frac{\\mathbf{r}(t+h)-\\mathbf{r}(t)}{h}=\\langle f'(t),g'(t),h'(t)\\rangle",
          "cas": "Matrix([diff(f(t),t), diff(g(t),t), diff(h(t),t)])"
        },
        {
          "formula_id": "tangent_line_vector_equation",
          "name_ko": "접선의 벡터방정식",
          "role": "theorem",
          "latex": "\\mathbf{L}(s)=\\mathbf{r}(t_0)+s\\mathbf{r}'(t_0)",
          "cas": "r(t0) + s*rprime(t0)"
        },
        {
          "formula_id": "unit_tangent_vector",
          "name_ko": "단위접선벡터",
          "role": "definition",
          "latex": "\\mathbf{T}(t)=\\frac{\\mathbf{r}'(t)}{\\|\\mathbf{r}'(t)\\|}\\quad(\\mathbf{r}'(t)\\neq\\mathbf{0})",
          "cas": "rprime(t)/rprime(t).norm()"
        },
        {
          "formula_id": "higher_order_vector_derivative",
          "name_ko": "고계도함수",
          "role": "definition",
          "latex": "\\mathbf{r}^{(n)}(t)=\\langle f^{(n)}(t),g^{(n)}(t),h^{(n)}(t)\\rangle",
          "cas": "Matrix([diff(f(t),t,n), diff(g(t),t,n), diff(h(t),t,n)])"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "tangent_direction_needs_nonzero_derivative",
          "description": "r'(t0)≠0이어야 t=t0에서 일반적인 접선 방향이 정의된다.",
          "rule": {
            "property": "r_prime_at_t0",
            "operator": "not_equals",
            "value": "zero_vector"
          }
        }
      ],
      "properties": [
        {
          "property_id": "tangent_vs_unit_tangent_distinct",
          "description": "접선벡터 r'(t)와 단위접선벡터 T(t)는 다르다. T(t)는 방향은 같지만 크기가 항상 1이다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.vector_valued_functions_and_space_curves",
          "name_ko": "벡터값 함수와 공간곡선",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.vector_differentiation_rules"
      ],
      "learning_objectives": [
        {
          "objective_id": "compute_vector_derivative",
          "verb": "calculate",
          "description": "벡터값 함수를 성분별로 미분한다."
        },
        {
          "objective_id": "find_tangent_line_equation",
          "verb": "construct",
          "description": "특정 t0에서 공간곡선의 접선의 벡터방정식을 구한다."
