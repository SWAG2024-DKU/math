    {
      "concept_id": "calculus.vector_integral",
      "order": 4,
      "name_ko": "벡터값 함수의 적분",
      "definition": "벡터값 함수의 부정적분·정적분은 성분별로 계산하며, 부정적분의 적분상수는 상수벡터 C=<C1,C2,C3>이다. R'(t)=r(t)이면 ∫[a,b]r(t)dt=R(b)-R(a)이다(벡터값 함수의 기본정리). 속도벡터로부터 위치벡터를 구할 때 초기조건으로 상수벡터를 결정한다.",
      "formulas": [
        {
          "formula_id": "vector_indefinite_integral",
          "name_ko": "벡터값 함수의 부정적분",
          "role": "definition",
          "latex": "\\int\\mathbf{r}(t)\\,dt=\\left\\langle\\int f\\,dt,\\int g\\,dt,\\int h\\,dt\\right\\rangle=\\mathbf{R}(t)+\\mathbf{C}",
          "cas": "Matrix([Integral(f(t),t), Integral(g(t),t), Integral(h(t),t)])"
        },
        {
          "formula_id": "vector_definite_integral",
          "name_ko": "벡터값 함수의 정적분",
          "role": "definition",
          "latex": "\\int_a^b\\mathbf{r}(t)\\,dt=\\left\\langle\\int_a^bf\\,dt,\\int_a^bg\\,dt,\\int_a^bh\\,dt\\right\\rangle",
          "cas": "Matrix([Integral(f(t),(t,a,b)), Integral(g(t),(t,a,b)), Integral(h(t),(t,a,b))])"
        },
        {
          "formula_id": "vector_ftc",
          "name_ko": "벡터값 함수의 기본정리",
          "role": "theorem",
          "latex": "\\mathbf{R}'(t)=\\mathbf{r}(t)\\implies\\int_a^b\\mathbf{r}(t)\\,dt=\\mathbf{R}(b)-\\mathbf{R}(a)",
          "cas": "R(b) - R(a)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "integration_constant_is_vector",
          "description": "부정적분의 적분상수는 하나의 스칼라가 아니라 상수벡터 C=<C1,C2,C3>다.",
          "rule": {
