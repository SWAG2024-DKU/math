    {
      "concept_id": "calculus.vector_differentiation_rules",
      "order": 3,
      "name_ko": "벡터 미분법칙과 합성함수의 미분",
      "definition": "벡터값 함수 u(t), v(t)와 스칼라함수 f(t)에 대해 합·스칼라곱·내적·외적의 미분법칙이 성립하며, 합성함수 u(g(t))의 도함수는 연쇄법칙 u'(g(t))g'(t)로 구한다. 위치벡터의 크기가 일정하면 위치벡터와 그 도함수는 서로 수직이다.",
      "formulas": [
        {
          "formula_id": "vector_diff_rules",
          "name_ko": "벡터 미분법칙",
          "role": "theorem",
          "latex": "\\frac{d}{dt}[\\mathbf{u}+\\mathbf{v}]=\\mathbf{u}'+\\mathbf{v}',\\quad\\frac{d}{dt}[f\\mathbf{u}]=f'\\mathbf{u}+f\\mathbf{u}',\\quad\\frac{d}{dt}[\\mathbf{u}\\cdot\\mathbf{v}]=\\mathbf{u}'\\cdot\\mathbf{v}+\\mathbf{u}\\cdot\\mathbf{v}',\\quad\\frac{d}{dt}[\\mathbf{u}\\times\\mathbf{v}]=\\mathbf{u}'\\times\\mathbf{v}+\\mathbf{u}\\times\\mathbf{v}'",
          "cas": "diff(u(t).dot(v(t)), t)"
        },
        {
          "formula_id": "vector_chain_rule",
          "name_ko": "합성함수의 미분",
          "role": "theorem",
          "latex": "\\frac{d}{dt}\\mathbf{u}(g(t))=\\mathbf{u}'(g(t))g'(t)",
          "cas": "diff(u(g(t)), t)"
        },
        {
          "formula_id": "constant_magnitude_orthogonality",
          "name_ko": "크기가 일정한 벡터의 성질",
          "role": "theorem",
          "latex": "\\|\\mathbf{r}(t)\\|=C\\implies\\mathbf{r}(t)\\cdot\\mathbf{r}'(t)=0",
          "cas": "Eq(r(t).dot(rprime(t)), 0)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "cross_product_order_preserved",
          "description": "외적의 미분법칙에서는 순서가 중요하다: u'×v+u×v'이며, 항의 순서를 바꾸면 안 된다.",
          "rule": {
            "property": "cross_product_term_order_preserved",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "each_rule_mirrors_scalar_calculus",
          "description": "합·스칼라곱·내적의 미분법칙은 스칼라 함수의 합법칙·곱법칙과 형태가 같으며, 외적의 미분법칙도 곱법칙과 유사하되 순서가 유지된다."
        },
        {
          "property_id": "position_perpendicular_to_velocity_on_sphere",
          "description": "크기가 일정한 위치벡터(예: 구면 위의 운동)는 그 접선벡터(속도)와 항상 수직이다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.vector_derivative_and_tangent",
          "name_ko": "벡터값 함수의 도함수와 접선",
          "importance": "required"
        },
        {
          "concept_id": "calculus.dot_product",
          "name_ko": "내적",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.vector_integral"
      ],
      "learning_objectives": [
        {
          "objective_id": "apply_vector_differentiation_rules",
          "verb": "apply",
          "description": "합·곱·내적·외적의 미분법칙으로 벡터식을 미분한다."
        },
        {
          "objective_id": "apply_vector_chain_rule",
