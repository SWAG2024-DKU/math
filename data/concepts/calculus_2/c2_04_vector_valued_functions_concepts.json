          "latex": "\\mathbf{a}=a_T\\mathbf{T}+a_N\\mathbf{N}",
          "cas": "a_T*T + a_N*N"
        },
        {
          "formula_id": "tangential_acceleration",
          "name_ko": "접선가속도",
          "role": "theorem",
          "latex": "a_T=\\frac{dv}{dt}=\\frac{\\mathbf{v}\\cdot\\mathbf{a}}{\\|\\mathbf{v}\\|}",
          "cas": "v(t).dot(a(t))/v(t).norm()"
        },
        {
          "formula_id": "normal_acceleration",
          "name_ko": "법선가속도",
          "role": "theorem",
          "latex": "a_N=\\kappa v^2=\\frac{\\|\\mathbf{v}\\times\\mathbf{a}\\|}{\\|\\mathbf{v}\\|}",
          "cas": "v(t).cross(a(t)).norm()/v(t).norm()"
        },
        {
          "formula_id": "acceleration_magnitude",
          "name_ko": "가속도의 크기",
          "role": "corollary",
          "latex": "\\|\\mathbf{a}\\|^2=a_T^2+a_N^2",
          "cas": "a_T**2 + a_N**2"
        },
        {
          "formula_id": "uniform_circular_motion",
          "name_ko": "등속 원운동",
          "role": "special_case",
