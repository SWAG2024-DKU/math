    {
      "concept_id": "calculus.tangential_normal_acceleration",
      "order": 8,
      "name_ko": "접선가속도와 법선가속도",
      "definition": "가속도는 a=a_T T+a_N N으로 접선(속력 변화) 성분과 법선(방향 변화) 성분으로 분해된다. a_T=dv/dt=(v·a)/‖v‖는 속력의 변화를, a_N=κv²=‖v×a‖/‖v‖는 운동 방향의 변화를 나타내며, T와 N이 수직이므로 ‖a‖²=a_T²+a_N²이다.",
      "formulas": [
        {
          "formula_id": "acceleration_decomposition",
          "name_ko": "가속도의 접선·법선 분해",
