  "concepts": [
    {
      "concept_id": "calculus.vector_valued_functions_and_space_curves",
      "order": 1,
      "name_ko": "벡터값 함수와 공간곡선",
      "definition": "실수 t에 벡터를 대응시키는 함수 r(t)=<f(t),g(t),h(t)>를 벡터값 함수라 하며, t가 증가할 때 점 (x(t),y(t),z(t))가 그리는 자취가 공간곡선이다. 정의역은 성분함수 정의역의 교집합이며, 극한·연속은 성분별로 정의된다.",
      "formulas": [
        {
          "formula_id": "vector_valued_function_def",
          "name_ko": "벡터값 함수의 정의",
          "role": "definition",
          "latex": "\\mathbf{r}(t)=\\langle f(t),g(t),h(t)\\rangle=f(t)\\mathbf{i}+g(t)\\mathbf{j}+h(t)\\mathbf{k}",
          "cas": "Matrix([f(t), g(t), h(t)])"
        },
        {
          "formula_id": "vector_function_domain",
          "name_ko": "벡터값 함수의 정의역",
          "role": "definition",
          "latex": "\\operatorname{Dom}(\\mathbf{r})=\\operatorname{Dom}(f)\\cap\\operatorname{Dom}(g)\\cap\\operatorname{Dom}(h)",
          "cas": "Dom(f).intersect(Dom(g)).intersect(Dom(h))"
        },
        {
          "formula_id": "helix_example",
          "name_ko": "원형 나선",
          "role": "example",
          "latex": "\\mathbf{r}(t)=\\langle a\\cos t,a\\sin t,bt\\rangle",
          "cas": "Matrix([a*cos(t), a*sin(t), b*t])"
        },
        {
          "formula_id": "vector_function_limit",
          "name_ko": "벡터값 함수의 극한",
          "role": "definition",
          "latex": "\\lim_{t\\to a}\\mathbf{r}(t)=\\left\\langle\\lim_{t\\to a}f(t),\\lim_{t\\to a}g(t),\\lim_{t\\to a}h(t)\\right\\rangle",
          "cas": "Matrix([limit(f(t),t,a), limit(g(t),t,a), limit(h(t),t,a)])"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "all_component_limits_must_exist",
          "description": "각 성분의 극한이 모두 존재해야 벡터값 함수 전체의 극한이 존재한다.",
          "rule": {
            "property": "all_component_limits_exist",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "continuity_iff_component_continuity",
          "description": "r(t)가 t=a에서 연속이라는 것은 lim r(t)=r(a)라는 뜻이며, 이는 각 성분함수가 a에서 연속인 것과 동치다.",
          "rule": {
            "property": "vector_continuity_equiv_component_continuity",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "different_parametrization_effects",
          "description": "같은 기하학적 곡선도 매개화가 달라지면 진행 방향, 이동 속도, 추적 횟수, 매개변수 범위가 달라질 수 있다."
        },
        {
          "property_id": "curve_intersection_needs_different_parameters",
          "description": "두 곡선 r1(t), r2(s)의 교점은 r1(t)=r2(s)를 만족하는 t, s를 찾아 결정하며, 같은 공간점을 지나더라도 같은 시간·방향으로 통과하지 않을 수 있다."
        }
      ],
      "prerequisites": [
