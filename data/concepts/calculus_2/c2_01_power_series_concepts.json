    {
      "concept_id": "calculus.power_series_algebra",
      "order": 3,
      "name_ko": "멱급수의 대수적 연산과 계수의 유일성",
      "definition": "공통 수렴구간에서 두 멱급수는 항별로 더하거나 뺄 수 있고, 상수배도 항별로 적용된다. 두 멱급수의 곱은 코시 곱(Cauchy product)으로 계산한다. 두 멱급수가 어떤 열린구간에서 같은 함수를 나타내면 같은 차수의 계수는 서로 같다(계수의 유일성).",
      "formulas": [
        {
          "formula_id": "power_series_sum_diff",
          "name_ko": "멱급수의 합과 차",
          "role": "theorem",
          "latex": "\\sum a_nx^n\\pm\\sum b_nx^n=\\sum(a_n\\pm b_n)x^n",
          "cas": "Sum(a_n+b_n, (n,0,oo))"
        },
        {
          "formula_id": "power_series_scalar_multiple",
          "name_ko": "멱급수의 상수배",
          "role": "theorem",
          "latex": "c\\sum a_nx^n=\\sum ca_nx^n",
          "cas": "c*Sum(a_n*x**n, (n,0,oo))"
        },
        {
          "formula_id": "cauchy_product",
          "name_ko": "멱급수의 곱(코시 곱)",
          "role": "theorem",
          "latex": "\\left(\\sum a_nx^n\\right)\\left(\\sum b_nx^n\\right)=\\sum_{n=0}^\\infty\\left(\\sum_{k=0}^na_kb_{n-k}\\right)x^n",
          "cas": "Sum(Sum(a_k*b[n-k], (k,0,n)), (n,0,oo))"
        },
        {
          "formula_id": "coefficient_uniqueness",
          "name_ko": "계수의 유일성",
          "role": "theorem",
          "latex": "\\sum a_n(x-a)^n=\\sum b_n(x-a)^n\\ (\\text{열린구간에서})\\implies a_n=b_n",
          "cas": "Eq(a_n, b_n)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "common_interval_required",
          "description": "합·차·곱 연산은 두 멱급수가 공통 수렴구간에서 수렴할 때 성립한다.",
          "rule": {
            "property": "both_series_converge_on_common_interval",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "cauchy_product_collect_same_degree",
          "description": "급수의 곱에서는 같은 차수(x^n)의 모든 항(a_k b_{n-k}의 합)을 합쳐야 한다."
        }
      ],
      "prerequisites": [
