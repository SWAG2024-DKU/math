    {
      "concept_id": "calculus.power_series_term_by_term_calculus",
      "order": 4,
      "name_ko": "멱급수의 항별 미분·적분과 변수 치환",
      "definition": "수렴반지름이 R인 멱급수 f(x)=Σc_n(x-a)^n은 |x-a|<R에서 항별로 미분·적분할 수 있으며, 미분·적분한 급수의 수렴반지름도 R로 같다(끝점의 수렴 여부는 달라질 수 있음). 기본 멱급수의 x 자리에 g(x)를 대입하는 변수 치환으로도 새 급수를 얻을 수 있다.",
      "formulas": [
        {
          "formula_id": "term_by_term_differentiation",
          "name_ko": "항별 미분",
          "role": "theorem",
          "latex": "f'(x)=\\sum_{n=1}^\\infty nc_n(x-a)^{n-1}\\quad(|x-a|<R)",
          "cas": "Sum(n*c_n*(x-a)**(n-1), (n,1,oo))"
        },
        {
          "formula_id": "term_by_term_integration",
          "name_ko": "항별 적분",
          "role": "theorem",
          "latex": "\\int_a^xf(t)\\,dt=\\sum_{n=0}^\\infty\\frac{c_n}{n+1}(x-a)^{n+1}\\quad(|x-a|<R)",
          "cas": "Sum(c_n/(n+1)*(x-a)**(n+1), (n,0,oo))"
        },
        {
          "formula_id": "geometric_series_derivative",
          "name_ko": "기하급수의 미분",
          "role": "example",
          "latex": "\\frac{1}{(1-x)^2}=\\sum_{n=1}^\\infty nx^{n-1}=\\sum_{n=0}^\\infty(n+1)x^n",
          "cas": "diff(1/(1-x), x)"
        },
        {
          "formula_id": "geometric_series_integral",
          "name_ko": "기하급수의 적분",
          "role": "example",
          "latex": "-\\ln(1-x)=\\sum_{n=1}^\\infty\\frac{x^n}{n},\\qquad\\ln(1+x)=\\sum_{n=1}^\\infty(-1)^{n+1}\\frac{x^n}{n}",
          "cas": "-log(1-x)"
        },
        {
          "formula_id": "power_series_substitution",
          "name_ko": "변수 치환",
          "role": "technique",
          "latex": "\\frac{1}{1-g(x)}=\\sum_{n=0}^\\infty[g(x)]^n\\quad(|g(x)|<1)",
          "cas": "1/(1-g(x))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "term_by_term_within_radius_only",
          "description": "항별 미분·적분은 수렴반지름 내부(|x-a|<R)에서만 적용한다.",
