        }
      ],
      "misconceptions": [
        {
          "misconception_id": "calculus.power_series_algebra.miss_cauchy_product_terms",
          "title": "코시 곱에서 일부 항 누락",
          "description": "x^n의 계수를 구할 때 a_k b_{n-k} 조합 중 일부만 더한다.",
