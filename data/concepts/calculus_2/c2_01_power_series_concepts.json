    {
      "concept_id": "calculus.power_series_as_function",
      "order": 2,
      "name_ko": "기하급수와 멱급수로 정의된 함수",
      "definition": "기하급수 1/(1-x)=Σx^n(|x|<1)은 여러 함수의 멱급수를 만드는 기본식이다. 수렴구간 안에서 멱급수는 부분합 S_N(x)의 극한으로 하나의 함수 f(x)=Σc_n(x-a)^n을 정의한다.",
      "formulas": [
        {
          "formula_id": "geometric_series_as_power_series",
          "name_ko": "기하급수 형태",
          "role": "definition",
          "latex": "\\frac{1}{1-x}=\\sum_{n=0}^\\infty x^n,\\qquad-1<x<1",
          "cas": "1/(1-x)"
        },
        {
          "formula_id": "power_series_partial_sum",
          "name_ko": "멱급수의 부분합",
          "role": "definition",
          "latex": "S_N(x)=\\sum_{n=0}^Nc_n(x-a)^n,\\qquad f(x)=\\lim_{N\\to\\infty}S_N(x)",
          "cas": "Sum(c_n*(x-a)**n, (n,0,N))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "defined_only_within_interval",
          "description": "멱급수가 정의하는 함수 f(x)는 수렴구간 안에서만 의미를 가진다.",
          "rule": {
            "property": "x_within_interval_of_convergence",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "partial_sums_approach_f",
          "description": "N이 증가할수록 부분합 S_N(x)은 수렴구간 안에서 함수 f(x)에 가까워진다."
        }
      ],
      "prerequisites": [
