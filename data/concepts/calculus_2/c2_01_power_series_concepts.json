  "concepts": [
    {
      "concept_id": "calculus.power_series_definition_and_convergence",
      "order": 1,
      "name_ko": "멱급수의 정의, 수렴반지름과 수렴구간",
      "definition": "점 x=a를 중심으로 하는 멱급수 Σc_n(x-a)^n은 x=a에서만 수렴하거나, 모든 실수에서 수렴하거나, 어떤 R>0에 대해 |x-a|<R에서 수렴하고 |x-a|>R에서 발산하는 세 가지 형태 중 하나를 갖는다. 이 R을 수렴반지름이라 하며, 비율판정법이나 근판정법으로 구할 수 있다.",
      "formulas": [
        {
          "formula_id": "power_series_def",
          "name_ko": "멱급수의 정의",
          "role": "definition",
          "latex": "\\sum_{n=0}^\\infty c_n(x-a)^n=c_0+c_1(x-a)+c_2(x-a)^2+\\cdots",
          "cas": "Sum(c_n*(x-a)**n, (n,0,oo))"
        },
        {
          "formula_id": "radius_of_convergence_ratio",
          "name_ko": "비율판정법에 의한 수렴반지름",
          "role": "theorem",
          "latex": "\\lim_{n\\to\\infty}\\left|\\frac{c_{n+1}}{c_n}\\right|=\\ell\\implies R=\\frac1\\ell\\ (\\ell=0\\Rightarrow R=\\infty,\\ \\ell=\\infty\\Rightarrow R=0)",
          "cas": "1/limit(Abs(c[n+1]/c[n]), n, oo)"
        },
        {
          "formula_id": "radius_of_convergence_root",
          "name_ko": "근판정법에 의한 수렴반지름",
          "role": "theorem",
          "latex": "R=\\frac{1}{\\limsup_{n\\to\\infty}\\sqrt[n]{|c_n|}}",
          "cas": "1/limsup(Abs(c_n)**(1/n), n, oo)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "ratio_root_test_determines_open_interval_only",
          "description": "비율판정법이나 근판정법은 보통 열린구간(a-R,a+R)만 결정한다. 끝점에서는 판정값이 1이 되는 경우가 많으므로 원래 급수에 직접 대입해 별도로 검사해야 한다.",
          "rule": {
            "property": "endpoint_convergence_checked_separately",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "three_convergence_patterns",
          "description": "멱급수는 (1) 중심에서만 수렴, (2) 모든 실수에서 수렴, (3) 어떤 R>0에 대해 |x-a|<R에서 수렴·|x-a|>R에서 발산 중 하나의 패턴을 갖는다."
        },
        {
          "property_id": "converges_at_center_always",
          "description": "멱급수는 중심 x=a에서는 항상 수렴한다(모든 항이 0이 되므로)."
        },
        {
          "property_id": "interval_four_possible_forms",
          "description": "수렴구간은 (a-R,a+R), [a-R,a+R), (a-R,a+R], [a-R,a+R] 네 가지 형태 중 하나이며, 한쪽 끝점만 포함될 수도 있다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.ratio_and_root_tests",
          "name_ko": "비판정법과 근판정법",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.power_series_as_function"
