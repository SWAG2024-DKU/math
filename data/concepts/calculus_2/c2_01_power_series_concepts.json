          "cas": "P_n(x) + R_n(x)"
        },
        {
          "formula_id": "lagrange_remainder",
          "name_ko": "Lagrange 나머지항",
          "role": "theorem",
          "latex": "R_n(x)=\\frac{f^{(n+1)}(c)}{(n+1)!}(x-a)^{n+1}\\quad(c\\text{는 }a,x\\text{ 사이})",
          "cas": "diff(f(x),x,n+1).subs(x,c)/factorial(n+1)*(x-a)**(n+1)"
