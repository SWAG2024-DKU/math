      "learning_objectives": [
        {
          "objective_id": "compute_radius_of_convergence",
          "verb": "calculate",
          "description": "비율판정법 또는 근판정법으로 멱급수의 수렴반지름을 구한다."
        },
        {
          "objective_id": "determine_interval_of_convergence",
          "verb": "calculate",
          "description": "끝점을 원래 급수에 대입해 검사하여 수렴구간을 확정한다."
        }
