  "concepts": [
    {
      "concept_id": "calculus.parameter_elimination_and_line_parametrization",
      "order": 1,
      "name_ko": "매개변수 제거와 직선·선분·타원의 매개화",
      "definition": "매개방정식을 Cartesian 방정식으로 바꾸려면 두 식에서 매개변수 t를 제거한다. 점 (x0,y0)를 지나고 방향벡터가 <a,b>인 직선은 x=x0+at, y=y0+bt로, 두 점을 잇는 선분은 매개변수 범위를 0≤t≤1로 제한해 매개화한다. 중심 (h,k), 반축 a,b인 타원은 x=h+a cos t, y=k+b sin t로 매개화한다.",
      "formulas": [
        {
          "formula_id": "parameter_elimination_example",
          "name_ko": "매개변수 제거 예시",
          "role": "example",
          "latex": "x=t+1,\\ y=t^2\\implies t=x-1\\implies y=(x-1)^2",
          "cas": "(x-1)**2"
        },
        {
          "formula_id": "line_parametrization",
          "name_ko": "직선의 매개화",
          "role": "definition",
          "latex": "x=x_0+at,\\qquad y=y_0+bt",
          "cas": "(x0+a*t, y0+b*t)"
        },
        {
          "formula_id": "segment_parametrization",
          "name_ko": "두 점을 잇는 선분",
          "role": "definition",
          "latex": "x=x_0+t(x_1-x_0),\\qquad y=y_0+t(y_1-y_0),\\qquad0\\le t\\le1",
          "cas": "(x0+t*(x1-x0), y0+t*(y1-y0))"
        },
        {
          "formula_id": "ellipse_parametrization",
          "name_ko": "타원의 매개화",
          "role": "definition",
          "latex": "x=h+a\\cos t,\\qquad y=k+b\\sin t",
          "cas": "(h+a*cos(t), k+b*sin(t))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "parameter_range_carried_over",
          "description": "매개변수를 제거한 뒤에도 원래 매개변수의 범위를 반영해 변환된 좌표의 범위를 함께 확인해야 한다.",
          "rule": {
            "property": "original_parameter_range_reflected_in_cartesian_form",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "not_always_eliminable",
          "description": "매개변수를 항상 명시적으로 제거할 수 있는 것은 아니다.",
          "rule": {
            "property": "explicit_elimination_possible",
            "operator": "not_equals",
            "value": "always"
          }
        }
      ],
      "properties": [
        {
          "property_id": "same_curve_different_direction_speed",
          "description": "같은 곡선이라도 매개화에 따라 진행 방향과 속도가 달라질 수 있다(예: y=x^2을 x=t, y=t^2으로 매개화한 것과 다른 매개화)."
        }
      ],
      "prerequisites": [
