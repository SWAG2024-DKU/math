    {
      "concept_id": "calculus.parametric_surface_area_of_revolution",
      "order": 3,
      "name_ko": "매개곡선의 회전체 표면적",
      "definition": "매끄러운 곡선 x=f(t), y=g(t)(α≤t≤β)를 x축 둘레로 회전시키면 표면적은 S=2π∫[α,β]|y(t)|√([x'(t)]²+[y'(t)]²)dt이고, y축 둘레로 회전시키면 S=2π∫[α,β]|x(t)|√([x'(t)]²+[y'(t)]²)dt이다. 회전축까지의 거리가 음수가 되지 않도록 항상 절댓값을 취한다.",
      "formulas": [
        {
          "formula_id": "surface_area_revolution_x_axis",
          "name_ko": "x축 둘레 회전체 표면적",
          "role": "theorem",
          "latex": "S=2\\pi\\int_\\alpha^\\beta|y(t)|\\sqrt{[x'(t)]^2+[y'(t)]^2}\\,dt",
          "cas": "2*pi*Integral(Abs(y(t))*sqrt(diff(x(t),t)**2+diff(y(t),t)**2), (t,alpha,beta))"
        },
        {
          "formula_id": "surface_area_revolution_y_axis",
          "name_ko": "y축 둘레 회전체 표면적",
          "role": "theorem",
          "latex": "S=2\\pi\\int_\\alpha^\\beta|x(t)|\\sqrt{[x'(t)]^2+[y'(t)]^2}\\,dt",
          "cas": "2*pi*Integral(Abs(x(t))*sqrt(diff(x(t),t)**2+diff(y(t),t)**2), (t,alpha,beta))"
        }
      ],
      "application_conditions": [
