    {
      "concept_id": "calculus.parametric_tangent_and_concavity",
      "order": 2,
      "name_ko": "매개곡선의 접선의 방정식과 오목성",
      "definition": "매개곡선 t=t0에 대응하는 점 (x0,y0)에서 접선의 방정식은 y-y0=m(x-x0)(m은 dy/dx|_{t=t0})이다. 이계도함수 d²y/dx²의 부호로 매개곡선의 오목성(위로/아래로 오목)을 판정한다.",
      "formulas": [
        {
          "formula_id": "parametric_tangent_line_equation",
          "name_ko": "매개곡선 접선의 방정식",
          "role": "theorem",
          "latex": "(x_0,y_0)=(f(t_0),g(t_0)),\\quad m=\\left.\\frac{dy}{dx}\\right|_{t=t_0}\\implies y-y_0=m(x-x_0)",
          "cas": "Eq(y-y0, m*(x-x0))"
        },
        {
          "formula_id": "parametric_concavity",
          "name_ko": "매개곡선의 오목성",
          "role": "theorem",
          "latex": "\\frac{d^2y}{dx^2}>0\\implies\\text{위로 오목},\\qquad\\frac{d^2y}{dx^2}<0\\implies\\text{아래로 오목}",
          "cas": "sign(d2y_dx2)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "both_zero_needs_further_analysis",
          "description": "dx/dt와 dy/dt가 동시에 0인 점에서는 단순한 비율공식만으로 접선을 판단할 수 없으며 국소적인 곡선의 형태를 추가로 조사해야 한다.",
          "rule": {
            "property": "dx_dt_and_dy_dt_both_zero",
            "operator": "not_equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "second_derivative_not_naive_ratio",
          "description": "d²y/dx²는 d²y/dt²을 d²x/dt²으로 직접 나눈 것이 아니다. 먼저 dy/dx를 구한 뒤 다시 t로 미분하고 dx/dt로 나누어야 한다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.parametric_tangent_line",
          "name_ko": "매개변수곡선의 접선과 이계도함수",
          "importance": "required"
        }
      ],
      "related_concepts": [],
      "learning_objectives": [
        {
          "objective_id": "find_parametric_tangent_line_equation",
          "verb": "construct",
          "description": "특정 t0에서 매개곡선의 접선의 방정식을 구한다."
        },
        {
          "objective_id": "determine_parametric_concavity",
          "verb": "classify",
          "description": "이계도함수의 부호로 매개곡선의 오목 구간을 판별한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "calculus.parametric_concavity.use_dt_sign_instead_of_dx",
          "title": "d²y/dt²의 부호로 오목성 판정",
          "description": "매개곡선의 오목성을 판단할 때 d²y/dx² 대신 d²y/dt²의 부호를 사용한다.",
          "diagnosis_tag": "use_d2y_dt2_sign_for_concavity",
