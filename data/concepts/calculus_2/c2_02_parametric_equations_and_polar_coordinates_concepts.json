    {
      "concept_id": "calculus.named_polar_curves_and_symmetry",
      "order": 4,
      "name_ko": "명명된 극곡선과 극좌표 대칭성 검사",
      "definition": "카디오이드 r=a(1±cosθ), 리마송 r=a±b cosθ, 장미곡선 r=a cos(nθ)(n 홀수면 n개 꽃잎, 짝수면 2n개 꽃잎), 레므니스케이트 r²=a²cos(2θ), 아르키메데스 나선 r=a+bθ 등 대표적인 극곡선의 형태와, 극축·θ=π/2·극에 대한 대칭성을 θ→-θ, θ→π-θ, r→-r(또는 θ→θ+π) 대입으로 검사하는 방법이다.",
      "formulas": [
        {
          "formula_id": "cardioid_limacon",
          "name_ko": "카디오이드와 리마송",
          "role": "example",
          "latex": "r=a(1\\pm\\cos\\theta)\\ (\\text{카디오이드}),\\qquad r=a\\pm b\\cos\\theta\\ (\\text{리마송})",
          "cas": "a*(1+cos(theta))"
        },
        {
          "formula_id": "rose_curve",
          "name_ko": "장미곡선",
          "role": "example",
          "latex": "r=a\\cos(n\\theta)\\ \\text{또는}\\ a\\sin(n\\theta)",
          "cas": "a*cos(n*theta)"
        },
        {
          "formula_id": "lemniscate",
          "name_ko": "레므니스케이트",
          "role": "example",
          "latex": "r^2=a^2\\cos(2\\theta)\\ \\text{또는}\\ a^2\\sin(2\\theta)",
          "cas": "a**2*cos(2*theta)"
        },
        {
          "formula_id": "archimedean_spiral",
          "name_ko": "아르키메데스 나선",
          "role": "example",
          "latex": "r=a+b\\theta",
          "cas": "a+b*theta"
        },
        {
          "formula_id": "polar_symmetry_tests",
          "name_ko": "대칭성 검사",
          "role": "test",
          "latex": "\\text{극축}:\\theta\\to-\\theta;\\quad\\theta=\\tfrac\\pi2:\\theta\\to\\pi-\\theta;\\quad\\text{극}:r\\to-r\\text{ 또는 }\\theta\\to\\theta+\\pi",
