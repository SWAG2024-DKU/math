    {
      "concept_id": "calculus.line_integral_vector_field",
      "order": 3,
      "name_ko": "벡터장의 선적분과 일",
      "definition": "벡터장 F와 방향을 가진 곡선 C에 대해 ∫C F·dr=∫[a,b]F(r(t))·r'(t)dt이다. 2차원에서는 ∫C P dx+Q dy로 성분별로 쓸 수 있다. 힘장이 입자를 C를 따라 이동시킬 때 한 일은 W=∫C F·dr이며, 곡선의 방향을 반대로 하면 적분값의 부호가 바뀐다(스칼라 선적분과 다름).",
      "formulas": [
        {
          "formula_id": "vector_line_integral",
          "name_ko": "벡터장의 선적분",
          "role": "definition",
          "latex": "\\int_C\\mathbf{F}\\cdot d\\mathbf{r}=\\int_a^b\\mathbf{F}(\\mathbf{r}(t))\\cdot\\mathbf{r}'(t)\\,dt",
          "cas": "Integral(F(r(t)).dot(rprime(t)), (t,a,b))"
        },
        {
          "formula_id": "vector_line_integral_component_form",
          "name_ko": "성분형",
          "role": "notation",
          "latex": "\\int_C\\mathbf{F}\\cdot d\\mathbf{r}=\\int_CP\\,dx+Q\\,dy\\ (+R\\,dz)",
          "cas": "Integral(P*dx+Q*dy, C)"
        },
        {
          "formula_id": "work_via_line_integral",
          "name_ko": "일",
          "role": "application",
          "latex": "W=\\int_C\\mathbf{F}\\cdot d\\mathbf{r}",
          "cas": "Integral(F(r(t)).dot(rprime(t)), (t,a,b))"
        },
        {
          "formula_id": "orientation_reversal",
          "name_ko": "방향 반전",
          "role": "property",
          "latex": "\\int_{-C}\\mathbf{F}\\cdot d\\mathbf{r}=-\\int_C\\mathbf{F}\\cdot d\\mathbf{r}",
          "cas": "-Integral(F(r(t)).dot(rprime(t)), (t,a,b))"
        },
        {
          "formula_id": "piecewise_smooth_additivity",
          "name_ko": "구간별 매끄러운 곡선의 가법성",
          "role": "property",
          "latex": "C=C_1\\cup\\cdots\\cup C_n\\implies\\int_C\\mathbf{F}\\cdot d\\mathbf{r}=\\sum_{k=1}^n\\int_{C_k}\\mathbf{F}\\cdot d\\mathbf{r}",
          "cas": "Sum(Integral(F, Ck), (k,1,n))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "depends_on_curve_orientation",
          "description": "벡터장 선적분은 곡선의 방향에 의존한다(스칼라 선적분과 달리 방향을 바꾸면 부호가 반대가 됨).",
          "rule": {
            "property": "vector_line_integral_orientation_dependent",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "dot_product_with_velocity",
          "description": "벡터장 선적분에는 F·r'(t)(내적)가 들어간다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.vector_fields",
          "name_ko": "벡터장",
          "importance": "required"
        },
        {
          "concept_id": "calculus.line_integral_scalar",
          "name_ko": "스칼라함수의 선적분",
          "importance": "recommended"
        }
