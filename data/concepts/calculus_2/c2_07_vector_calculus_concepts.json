    {
      "concept_id": "calculus.divergence_and_curl",
      "order": 6,
      "name_ko": "발산과 회전",
      "definition": "벡터장 F=<P,Q,R>의 발산 ∇·F=P_x+Q_y+R_z(스칼라)는 한 점에서 장이 얼마나 퍼지거나 모이는지를, 회전 ∇×F=<R_y-Q_z,P_z-R_x,Q_x-P_y>(벡터)는 장이 그 점 근처에서 얼마나 회전하려는지를 나타낸다. F=∇f이면 ∇×F=0이고, 임의의 F에 대해 ∇·(∇×F)=0이다.",
      "formulas": [
        {
          "formula_id": "divergence_def",
          "name_ko": "발산의 정의",
          "role": "definition",
          "latex": "\\nabla\\cdot\\mathbf{F}=P_x+Q_y+R_z",
          "cas": "diff(P(x,y,z),x)+diff(Q(x,y,z),y)+diff(R(x,y,z),z)"
        },
        {
          "formula_id": "curl_def",
          "name_ko": "회전의 정의",
          "role": "definition",
          "latex": "\\nabla\\times\\mathbf{F}=\\langle R_y-Q_z,\\ P_z-R_x,\\ Q_x-P_y\\rangle",
          "cas": "Matrix([diff(R,y)-diff(Q,z), diff(P,z)-diff(R,x), diff(Q,x)-diff(P,y)])"
        },
        {
          "formula_id": "curl_2d_scalar",
          "name_ko": "2차원 회전(스칼라)",
          "role": "special_case",
          "latex": "\\text{2D 회전}=Q_x-P_y",
          "cas": "diff(Q(x,y),x)-diff(P(x,y),y)"
        },
        {
          "formula_id": "fundamental_identities",
          "name_ko": "기본 항등식",
          "role": "identity",
          "latex": "\\nabla\\times(\\nabla f)=\\mathbf{0},\\qquad\\nabla\\cdot(\\nabla\\times\\mathbf{F})=0",
          "cas": "curl(grad(f))"
        },
        {
          "formula_id": "laplacian",
          "name_ko": "라플라시안",
          "role": "definition",
          "latex": "\\nabla^2f=\\nabla\\cdot(\\nabla f)=f_{xx}+f_{yy}+f_{zz}",
          "cas": "diff(f(x,y,z),x,2)+diff(f(x,y,z),y,2)+diff(f(x,y,z),z,2)"
        }
      ],
      "application_conditions": [
