      "concept_id": "calculus.greens_theorem",
      "order": 5,
      "name_ko": "Green 정리",
      "definition": "양의 방향(반시계방향)을 가진 단순폐곡선 C가 영역 D의 경계이고 P,Q가 필요한 연속 편도함수를 가지면 ∮C P dx+Q dy=∬D(Q_x-P_y)dA이다(순환형). 유출형 Green 정리는 ∮C F·n ds=∬D(P_x+Q_y)dA이다. 영역의 넓이는 A=(1/2)∮C(x dy-y dx) 등으로 구할 수 있다.",
      "formulas": [
        {
          "formula_id": "greens_theorem_circulation",
          "name_ko": "Green 정리(순환형)",
          "role": "theorem",
          "latex": "\\oint_CP\\,dx+Q\\,dy=\\iint_D\\left(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\right)dA",
          "cas": "Integral(diff(Q(x,y),x)-diff(P(x,y),y), (x,y), D)"
        },
        {
          "formula_id": "greens_theorem_flux",
          "name_ko": "Green 정리(유출형)",
          "role": "theorem",
          "latex": "\\oint_C\\mathbf{F}\\cdot\\mathbf{n}\\,ds=\\iint_D(P_x+Q_y)\\,dA",
          "cas": "Integral(diff(P(x,y),x)+diff(Q(x,y),y), (x,y), D)"
        },
        {
          "formula_id": "greens_area_formula",
          "name_ko": "Green 정리를 이용한 넓이 공식",
          "role": "corollary",
          "latex": "A=\\oint_Cx\\,dy=-\\oint_Cy\\,dx=\\frac12\\oint_C(x\\,dy-y\\,dx)",
          "cas": "(1/2)*Integral(x*dy-y*dx, C)"
        }
      ],
      "application_conditions": [
