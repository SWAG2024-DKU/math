      "concept_id": "calculus.vector_fields",
      "order": 1,
      "name_ko": "벡터장",
      "definition": "평면(또는 공간)의 각 점에 벡터를 대응시키는 함수를 벡터장이라 한다: F(x,y)=<P(x,y),Q(x,y)> 또는 F(x,y,z)=<P,Q,R>. 정의역은 성분함수의 공통 정의역이며, 속도장·힘장·방사형·회전형 벡터장이 대표적 예다.",
      "formulas": [
        {
          "formula_id": "vector_field_2d_3d",
          "name_ko": "벡터장의 정의",
          "role": "definition",
          "latex": "\\mathbf{F}(x,y)=\\langle P(x,y),Q(x,y)\\rangle,\\qquad\\mathbf{F}(x,y,z)=\\langle P,Q,R\\rangle",
          "cas": "Matrix([P(x,y), Q(x,y)])"
        },
        {
          "formula_id": "radial_and_rotational_fields",
          "name_ko": "방사형·회전형 벡터장의 예",
          "role": "example",
          "latex": "\\mathbf{F}(x,y)=\\langle x,y\\rangle\\ (\\text{방사형}),\\qquad\\mathbf{F}(x,y)=\\langle-y,x\\rangle\\ (\\text{회전형})",
          "cas": "Matrix([x, y])"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "domain_is_intersection",
          "description": "벡터장의 정의역은 모든 성분함수의 공통 정의역이다.",
