    {
      "concept_id": "calculus.conservative_vector_field",
      "order": 4,
      "name_ko": "보존적 벡터장과 선적분의 기본정리",
      "definition": "벡터장 F가 어떤 스칼라함수(퍼텐셜 함수) f의 그래디언트로 표현되면(F=∇f) 보존적이라 한다. 이때 선적분의 기본정리 ∫C F·dr=f(B)-f(A)가 성립해 선적분이 경로에 무관하고 폐곡선에서는 0이 된다. 단순연결영역에서 P_y=Q_x(2차원) 또는 ∇×F=0(3차원)이 보존성과 동치다.",
      "formulas": [
        {
          "formula_id": "conservative_field_def",
          "name_ko": "보존적 벡터장의 정의",
          "role": "definition",
          "latex": "\\mathbf{F}=\\nabla f",
          "cas": "Eq(F, grad(f))"
        },
        {
          "formula_id": "fundamental_theorem_line_integrals",
          "name_ko": "선적분의 기본정리",
          "role": "theorem",
          "latex": "\\int_C\\mathbf{F}\\cdot d\\mathbf{r}=f(B)-f(A)\\quad(\\mathbf{F}=\\nabla f,\\ C:A\\to B)",
          "cas": "f(B) - f(A)"
        },
        {
          "formula_id": "closed_curve_zero",
          "name_ko": "폐곡선에서의 선적분",
          "role": "corollary",
          "latex": "\\oint_C\\mathbf{F}\\cdot d\\mathbf{r}=0",
          "cas": "Eq(Integral(F, C, closed=True), 0)"
        },
        {
          "formula_id": "conservative_test_2d",
          "name_ko": "2차원 판정조건",
          "role": "test",
          "latex": "P_y=Q_x\\ (\\text{단순연결영역, }P,Q\\text{ 연속 편도함수})\\iff\\mathbf{F}\\text{ 보존적}",
          "cas": "Eq(diff(P(x,y),y), diff(Q(x,y),x))"
        },
        {
          "formula_id": "conservative_test_3d",
          "name_ko": "3차원 판정조건",
          "role": "test",
          "latex": "\\nabla\\times\\mathbf{F}=\\mathbf{0}\\ (\\text{단순연결영역})\\implies\\mathbf{F}\\text{ 보존적}",
          "cas": "Eq(curl(F), Matrix([0,0,0]))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "py_qx_needs_simply_connected",
          "description": "P_y=Q_x만으로는 항상 보존성을 결론 낼 수 없으며, 정의역이 단순연결영역이어야 한다.",
