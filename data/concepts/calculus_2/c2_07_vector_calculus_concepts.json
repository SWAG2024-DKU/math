    {
      "concept_id": "calculus.line_integral_scalar",
      "order": 2,
      "name_ko": "스칼라함수의 선적분",
      "definition": "매끄러운 곡선 C: r(t)=<x(t),y(t),z(t)>(a≤t≤b)를 따라 스칼라함수 f의 선적분은 ∫C f ds=∫[a,b]f(r(t))‖r'(t)‖dt이다. 선밀도 ρ가 주어지면 곡선의 질량 m=∫C ρ ds, 질량중심을 구할 수 있다. 스칼라 선적분은 곡선의 방향에 영향을 받지 않는다.",
      "formulas": [
        {
          "formula_id": "scalar_line_integral",
          "name_ko": "스칼라함수의 선적분",
          "role": "definition",
          "latex": "\\int_Cf\\,ds=\\int_a^bf(\\mathbf{r}(t))\\|\\mathbf{r}'(t)\\|\\,dt",
          "cas": "Integral(f(r(t))*rprime(t).norm(), (t,a,b))"
        },
        {
          "formula_id": "mass_via_line_integral",
          "name_ko": "곡선의 질량",
          "role": "application",
          "latex": "m=\\int_C\\rho\\,ds",
          "cas": "Integral(rho, C)"
        },
        {
          "formula_id": "center_of_mass_curve",
          "name_ko": "곡선의 질량중심",
          "role": "application",
          "latex": "\\bar x=\\frac1m\\int_Cx\\rho\\,ds,\\quad\\bar y=\\frac1m\\int_Cy\\rho\\,ds,\\quad\\bar z=\\frac1m\\int_Cz\\rho\\,ds",
          "cas": "Integral(x*rho, C)/m"
        },
        {
          "formula_id": "scalar_line_integral_orientation_independent",
          "name_ko": "방향에 무관",
          "role": "property",
          "latex": "\\int_{-C}f\\,ds=\\int_Cf\\,ds",
          "cas": "Integral(f, -C) - Integral(f, C)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "curve_smooth_not_retraced",
          "description": "매개화가 곡선을 중복 추적하지 않아야 정확한 값을 준다.",
          "rule": {
            "property": "curve_traced_exactly_once",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "involves_speed_not_velocity",
          "description": "스칼라 선적분에는 ‖r'(t)‖(속력)가 들어간다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.vector_valued_arc_length_and_curvature",
          "name_ko": "공간곡선의 호의 길이와 곡률",
