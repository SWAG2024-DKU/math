    {
      "concept_id": "calculus.double_integral_general_region",
      "order": 2,
      "name_ko": "일반 영역에서의 이중적분",
      "definition": "영역 D가 Type I(a≤x≤b, g1(x)≤y≤g2(x)) 또는 Type II(c≤y≤d, h1(y)≤x≤h2(y))로 표현되면 각각에 맞는 반복적분으로 이중적분을 계산한다. 두 곡면 z=f(x,y)≥z=g(x,y) 사이의 부피는 ∬D[f-g]dA이고, 영역의 넓이는 ∬D 1 dA이다.",
      "formulas": [
        {
          "formula_id": "type1_region_integral",
          "name_ko": "Type I 영역의 이중적분",
          "role": "theorem",
          "latex": "D=\\{a\\le x\\le b,\\ g_1(x)\\le y\\le g_2(x)\\}\\implies\\iint_Df\\,dA=\\int_a^b\\int_{g_1(x)}^{g_2(x)}f(x,y)\\,dy\\,dx",
          "cas": "Integral(Integral(f(x,y), (y,g1(x),g2(x))), (x,a,b))"
        },
        {
          "formula_id": "type2_region_integral",
          "name_ko": "Type II 영역의 이중적분",
          "role": "theorem",
          "latex": "D=\\{c\\le y\\le d,\\ h_1(y)\\le x\\le h_2(y)\\}\\implies\\iint_Df\\,dA=\\int_c^d\\int_{h_1(y)}^{h_2(y)}f(x,y)\\,dx\\,dy",
          "cas": "Integral(Integral(f(x,y), (x,h1(y),h2(y))), (y,c,d))"
        },
        {
          "formula_id": "area_via_double_integral",
          "name_ko": "넓이",
          "role": "corollary",
          "latex": "A=\\iint_D1\\,dA",
          "cas": "Integral(1, (x,y), D)"
        },
        {
          "formula_id": "volume_between_surfaces",
          "name_ko": "두 곡면 사이의 부피",
          "role": "theorem",
          "latex": "V=\\iint_D[f(x,y)-g(x,y)]\\,dA\\quad(f\\ge g)",
          "cas": "Integral(f(x,y)-g(x,y), (x,y), D)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "region_split_if_not_single_type",
          "description": "한 번에 Type I 또는 Type II로 표현하기 어려운 영역은 여러 부분으로 나누어 각각 적분한 뒤 더한다.",
          "rule": {
