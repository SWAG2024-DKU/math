  "concepts": [
    {
      "concept_id": "calculus.double_integral_over_rectangle",
      "order": 1,
      "name_ko": "직사각형 영역에서의 이중적분",
      "definition": "직사각형 R=[a,b]×[c,d]에서 f(x,y)의 이중적분은 리만합의 극한 ∬R f dA로 정의된다. f≥0이면 곡면 아래 입체의 부피를 나타낸다. Fubini 정리에 의해 연속함수의 이중적분은 반복적분 ∫∫f(x,y)dy dx(또는 순서를 바꾼 형태)로 계산할 수 있다.",
      "formulas": [
        {
          "formula_id": "double_integral_def",
          "name_ko": "이중적분의 정의",
          "role": "definition",
          "latex": "\\iint_Rf(x,y)\\,dA=\\lim_{m,n\\to\\infty}\\sum_{i=1}^m\\sum_{j=1}^nf(x_{ij}^*,y_{ij}^*)\\Delta A",
          "cas": "limit(Sum(Sum(f(xij,yij)*DA, (j,1,n)), (i,1,m)), (m,n), oo)"
        },
        {
          "formula_id": "fubini_rectangle",
          "name_ko": "Fubini 정리(직사각형)",
          "role": "theorem",
          "latex": "\\iint_Rf(x,y)\\,dA=\\int_a^b\\int_c^df(x,y)\\,dy\\,dx=\\int_c^d\\int_a^bf(x,y)\\,dx\\,dy",
          "cas": "Integral(Integral(f(x,y), (y,c,d)), (x,a,b))"
        },
        {
          "formula_id": "double_integral_constant",
          "name_ko": "상수함수의 이중적분",
          "role": "corollary",
          "latex": "\\iint_Rk\\,dA=k\\cdot\\operatorname{Area}(R)",
          "cas": "k*Area(R)"
        },
        {
          "formula_id": "double_integral_average",
          "name_ko": "평균값",
          "role": "definition",
          "latex": "f_{\\text{avg}}=\\frac1{\\operatorname{Area}(R)}\\iint_Rf(x,y)\\,dA",
          "cas": "Integral(f(x,y), (x,a,b), (y,c,d))/Area(R)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "inner_variable_first",
          "description": "반복적분에서는 안쪽 적분변수를 먼저 적분하며, 다른 변수는 안쪽 적분에서 상수로 취급한다.",
          "rule": {
            "property": "inner_integration_variable_evaluated_first",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "signed_net_volume",
          "description": "f가 음수가 될 수 있으면 이중적분은 부호를 고려한 순부피를 나타낸다."
        },
        {
          "property_id": "linearity_and_additivity",
          "description": "이중적분은 선형성(∬[af+bg]dA=a∬f dA+b∬g dA)과 영역 분할에 대한 가법성(∬R f dA=∬R1 f dA+∬R2 f dA, R1∪R2=R)을 만족한다."
        }
      ],
      "prerequisites": [
