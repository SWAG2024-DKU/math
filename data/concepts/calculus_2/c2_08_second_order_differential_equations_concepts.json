    {
      "concept_id": "calculus.constant_coefficient_homogeneous_ode",
      "order": 2,
      "name_ko": "상수계수 동차방정식과 특성방정식",
      "definition": "ay''+by'+cy=0에서 y=e^{rx}로 가정하면 특성방정식 ar²+br+c=0을 얻는다. 근의 종류(서로 다른 두 실근, 중근, 켤레복소근)에 따라 일반해의 형태가 달라지며, 두 개의 초기조건 y(x0)=y0, y'(x0)=v0으로 c1, c2를 결정한다.",
      "formulas": [
        {
          "formula_id": "characteristic_equation",
          "name_ko": "특성방정식",
          "role": "theorem",
          "latex": "ay''+by'+cy=0,\\ y=e^{rx}\\implies ar^2+br+c=0",
          "cas": "Eq(a*r**2+b*r+c, 0)"
        },
        {
          "formula_id": "distinct_real_roots_solution",
          "name_ko": "서로 다른 두 실근",
          "role": "case",
          "latex": "r_1\\neq r_2\\implies y=c_1e^{r_1x}+c_2e^{r_2x}",
          "cas": "c1*exp(r1*x)+c2*exp(r2*x)"
        },
        {
          "formula_id": "repeated_root_solution",
          "name_ko": "중근",
          "role": "case",
          "latex": "y=(c_1+c_2x)e^{rx}",
          "cas": "(c1+c2*x)*exp(r*x)"
        },
        {
          "formula_id": "complex_roots_solution",
          "name_ko": "켤레복소근",
          "role": "case",
          "latex": "r=\\alpha\\pm\\beta i\\implies y=e^{\\alpha x}(c_1\\cos\\beta x+c_2\\sin\\beta x)",
          "cas": "exp(alpha*x)*(c1*cos(beta*x)+c2*sin(beta*x))"
        },
        {
          "formula_id": "second_order_ivp",
          "name_ko": "이계 초기값 문제",
          "role": "definition",
          "latex": "y(x_0)=y_0,\\qquad y'(x_0)=v_0",
          "cas": "[Eq(y(x0), y0), Eq(diff(y,x).subs(x,x0), v0)]"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "constant_coefficients_only",
          "description": "특성방정식 방법은 상수계수 선형방정식에 적용한다.",
          "rule": {
            "property": "coefficients_are_constants",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "existence_uniqueness",
          "description": "y''+p(x)y'+q(x)y=g(x)에서 p,q,g가 어떤 열린구간에서 연속이면 두 초기조건을 만족하는 해가 그 구간에서 유일하게 존재한다.",
          "rule": {
            "property": "p_q_g_continuous_on_interval",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "euler_formula_link",
          "description": "Euler 공식 e^{iθ}=cosθ+i sinθ를 이용하면 복소지수해를 실수함수인 사인·코사인 조합으로 바꿀 수 있다."
        },
        {
          "property_id": "repeated_root_second_solution_needs_x",
          "description": "중근에서는 두 번째 해에 반드시 x를 곱해야 y1=e^{rx}, y2=xe^{rx}가 선형독립이 된다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.second_order_linear_ode_and_superposition",
          "name_ko": "이계 선형 미분방정식과 중첩원리",
