        }
      ],
      "related_concepts": [
        "calculus.variation_of_parameters"
      ],
      "learning_objectives": [
        {
          "objective_id": "select_undetermined_coefficient_ansatz",
          "verb": "select",
          "description": "우변의 형태에 맞는 특수해 가정을 선택한다."
