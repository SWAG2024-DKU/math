  "concepts": [
    {
      "concept_id": "calculus.second_order_linear_ode_and_superposition",
      "order": 1,
      "name_ko": "이계 선형 미분방정식과 중첩원리",
      "definition": "a(x)y''+b(x)y'+c(x)y=g(x)(a(x)≠0) 형태를 이계 선형 미분방정식이라 하며, g=0이면 동차, g≠0이면 비동차다. 동차방정식의 두 해 y1,y2의 임의의 선형결합도 해이며(중첩원리), Wronskian W=y1y2'-y2y1'이 어떤 점에서 0이 아니면 두 해는 선형독립이고 일반해는 y=c1y1+c2y2이다.",
      "formulas": [
        {
          "formula_id": "second_order_linear_ode",
          "name_ko": "이계 선형 미분방정식",
          "role": "definition",
          "latex": "a(x)y''+b(x)y'+c(x)y=g(x)\\quad(a(x)\\neq0)",
          "cas": "Eq(a(x)*diff(y,x,2)+b(x)*diff(y,x)+c(x)*y, g(x))"
        },
        {
          "formula_id": "superposition_principle",
          "name_ko": "중첩원리",
          "role": "theorem",
          "latex": "y_1,y_2\\text{가 동차방정식의 해}\\implies y=c_1y_1+c_2y_2\\text{도 해}",
          "cas": "c1*y1+c2*y2"
        },
        {
          "formula_id": "wronskian",
          "name_ko": "Wronskian과 선형독립",
          "role": "test",
          "latex": "W(y_1,y_2)=y_1y_2'-y_2y_1'\\neq0\\implies y_1,y_2\\text{ 선형독립}",
          "cas": "y1*diff(y2,x)-y2*diff(y1,x)"
        },
        {
          "formula_id": "homogeneous_general_solution",
          "name_ko": "동차방정식의 일반해",
          "role": "theorem",
          "latex": "y=c_1y_1+c_2y_2\\quad(y_1,y_2\\text{ 선형독립})",
          "cas": "c1*y1(x)+c2*y2(x)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "linear_independence_def",
          "description": "y1, y2가 구간에서 선형독립이라는 것은 c1y1+c2y2=0이 모든 x에서 성립할 때 c1=c2=0만 가능하다는 뜻이다.",
          "rule": {
            "property": "c1y1_plus_c2y2_zero_implies_c1_c2_zero",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "coefficients_may_be_functions",
          "description": "a(x), b(x), c(x), g(x)는 모두 x의 함수일 수 있으며, 이들이 전부 상수이면 상수계수 방정식이 된다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.higher_order_derivatives",
          "name_ko": "고계도함수",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.constant_coefficient_homogeneous_ode"
      ],
      "learning_objectives": [
