    {
      "concept_id": "calculus.undetermined_coefficients",
      "order": 4,
      "name_ko": "미정계수법",
      "definition": "우변 g(x)의 형태(다항함수, 지수함수, 삼각함수, 이들의 유한한 합과 곱)에 맞추어 특수해의 형태를 가정하고 계수를 결정하는 방법이다. 가정한 항이 보완해와 중복되면 선형독립이 될 때까지 x(또는 x²)를 곱한다. 우변이 합으로 분리되면 각각의 특수해를 구해 더할 수 있다(선형성).",
      "formulas": [
        {
          "formula_id": "undetermined_coeff_polynomial",
          "name_ko": "다항함수 우변",
          "role": "case",
          "latex": "g(x)=P_n(x)\\implies y_p=A_nx^n+\\cdots+A_0",
          "cas": "Poly(A_n*x**n+...+A_0, x)"
        },
        {
          "formula_id": "undetermined_coeff_exponential",
          "name_ko": "지수함수 우변",
          "role": "case",
          "latex": "g(x)=Ce^{\\alpha x}\\implies y_p=Ae^{\\alpha x}",
          "cas": "A*exp(alpha*x)"
        },
        {
          "formula_id": "undetermined_coeff_trig",
          "name_ko": "삼각함수 우변",
          "role": "case",
          "latex": "g(x)=C\\cos\\beta x+D\\sin\\beta x\\implies y_p=A\\cos\\beta x+B\\sin\\beta x",
          "cas": "A*cos(beta*x)+B*sin(beta*x)"
        },
        {
          "formula_id": "undetermined_coeff_product",
          "name_ko": "다항식·지수·삼각함수의 곱",
          "role": "case",
          "latex": "g(x)=e^{\\alpha x}[P_n(x)\\cos\\beta x+Q_n(x)\\sin\\beta x]\\implies y_p=e^{\\alpha x}[R_n(x)\\cos\\beta x+S_n(x)\\sin\\beta x]",
          "cas": "exp(alpha*x)*(R_n(x)*cos(beta*x)+S_n(x)*sin(beta*x))"
        },
        {
          "formula_id": "undetermined_coeff_duplication_rule",
          "name_ko": "중복되는 가정의 수정",
          "role": "rule",
          "latex": "\\text{단순근과 중복}\\implies y_p=x(\\text{원래 가정});\\quad\\text{중근과 중복}\\implies y_p=x^2(\\text{원래 가정})",
          "cas": "x*original_guess"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "restricted_to_specific_g_forms",
          "description": "미정계수법은 우변의 형태가 다항함수·지수함수·삼각함수 및 이들의 합·곱으로 제한되어 있을 때만 적용할 수 있다.",
          "rule": {
            "property": "g_is_polynomial_exponential_trig_or_combination",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "include_both_sin_cos",
          "description": "삼각함수 우변에서는 사인과 코사인 중 하나만 있어도 두 항을 모두 가정에 포함해야 한다."
        },
        {
          "property_id": "linearity_of_particular_solutions",
          "description": "g(x)=g1(x)+g2(x)로 분리되면 각각에 대한 특수해를 구해 더할 수 있다(yp=yp1+yp2)."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.nonhomogeneous_ode_general_solution",
          "name_ko": "비동차방정식의 일반해 구조",
