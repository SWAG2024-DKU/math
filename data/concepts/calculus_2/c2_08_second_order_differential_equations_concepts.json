          "formula_id": "variation_of_parameters_formula",
          "name_ko": "매개변수변환법의 공식",
          "role": "theorem",
          "latex": "u_1'=-\\frac{y_2g}{W},\\quad u_2'=\\frac{y_1g}{W}\\implies y_p=-y_1\\int\\frac{y_2g}{W}dx+y_2\\int\\frac{y_1g}{W}dx",
          "cas": "-y1*Integral(y2*g/W, x) + y2*Integral(y1*g/W, x)"
