          "formula_id": "lagrange_condition",
          "name_ko": "라그랑주 조건",
          "role": "theorem",
          "latex": "\\nabla f=\\lambda\\nabla g",
          "cas": "Eq(gradf, lam*gradg)"
        },
        {
          "formula_id": "lagrange_system_2var",
          "name_ko": "기본 연립방정식(2변수)",
          "role": "system",
          "latex": "f_x=\\lambda g_x,\\quad f_y=\\lambda g_y,\\quad g(x,y)=k",
          "cas": "solve([Eq(fx,lam*gx), Eq(fy,lam*gy), Eq(g(x,y),k)], [x,y,lam])"
