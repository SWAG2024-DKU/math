    {
      "concept_id": "calculus.tangent_plane_and_linear_approximation",
      "order": 4,
      "name_ko": "접평면과 선형근사",
      "definition": "곡면 z=f(x,y) 위 점 (a,b,f(a,b))의 접평면은 z-f(a,b)=f_x(a,b)(x-a)+f_y(a,b)(y-b)이다. 선형화 L(x,y)는 이 접평면의 z값으로 f(x,y)를 근사한다. f_x, f_y가 (a,b) 근방에서 존재하고 연속이면 f는 (a,b)에서 미분가능하다(충분조건). 전미분 dz=f_x dx+f_y dy는 Δz의 선형 근사다.",
      "formulas": [
        {
          "formula_id": "tangent_plane_formula",
          "name_ko": "접평면의 방정식",
          "role": "theorem",
          "latex": "z-f(a,b)=f_x(a,b)(x-a)+f_y(a,b)(y-b)",
          "cas": "Eq(z-f(a,b), fx(a,b)*(x-a)+fy(a,b)*(y-b))"
        },
        {
          "formula_id": "linearization_2var",
          "name_ko": "선형화",
          "role": "definition",
          "latex": "L(x,y)=f(a,b)+f_x(a,b)(x-a)+f_y(a,b)(y-b)",
          "cas": "f(a,b)+fx(a,b)*(x-a)+fy(a,b)*(y-b)"
        },
        {
          "formula_id": "differentiability_definition",
          "name_ko": "미분가능성의 정의",
          "role": "definition",
          "latex": "\\Delta z=f_x(a,b)\\Delta x+f_y(a,b)\\Delta y+\\varepsilon_1\\Delta x+\\varepsilon_2\\Delta y,\\quad\\varepsilon_1,\\varepsilon_2\\to0",
          "cas": "fx(a,b)*Dx+fy(a,b)*Dy+eps1*Dx+eps2*Dy"
        },
        {
          "formula_id": "total_differential",
          "name_ko": "전미분",
          "role": "definition",
          "latex": "dz=f_x\\,dx+f_y\\,dy,\\qquad\\Delta z\\approx dz",
          "cas": "fx*dx+fy*dy"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "sufficient_condition_for_differentiability",
          "description": "편도함수 f_x, f_y가 (a,b)의 근방에서 존재하고 (a,b)에서 연속이면 f는 (a,b)에서 미분가능하다(충분조건이며 필요조건은 아님).",
          "rule": {
            "property": "fx_fy_exist_near_point_and_continuous_at_point",
            "operator": "equals",
            "value": true
          }
