    {
      "concept_id": "calculus.directional_derivative_and_gradient",
      "order": 6,
      "name_ko": "방향도함수와 그래디언트",
      "definition": "단위벡터 u=<u1,u2> 방향으로의 방향도함수 D_u f(a,b)는 그 방향의 순간변화율이다. 그래디언트 ∇f=<f_x,f_y>를 이용하면 f가 미분가능할 때 D_u f=∇f·u=‖∇f‖cosθ이다. 함수는 그래디언트 방향으로 가장 빠르게 증가하며 최대 증가율은 ‖∇f‖, 최소(가장 빠른 감소) 방향도함수는 -‖∇f‖이다.",
      "formulas": [
        {
          "formula_id": "directional_derivative_def",
          "name_ko": "방향도함수의 정의",
          "role": "definition",
          "latex": "D_{\\mathbf{u}}f(a,b)=\\lim_{h\\to0}\\frac{f(a+hu_1,b+hu_2)-f(a,b)}h",
          "cas": "limit((f(a+h*u1,b+h*u2)-f(a,b))/h, h, 0)"
        },
        {
          "formula_id": "gradient_def",
          "name_ko": "그래디언트",
          "role": "definition",
          "latex": "\\nabla f(x,y)=\\langle f_x,f_y\\rangle,\\qquad\\nabla f(x,y,z)=\\langle f_x,f_y,f_z\\rangle",
          "cas": "Matrix([diff(f(x,y),x), diff(f(x,y),y)])"
        },
        {
          "formula_id": "directional_derivative_gradient_relation",
          "name_ko": "방향도함수와 그래디언트의 관계",
          "role": "theorem",
          "latex": "D_{\\mathbf{u}}f=\\nabla f\\cdot\\mathbf{u}=\\|\\nabla f\\|\\cos\\theta",
          "cas": "grad_f.dot(u)"
        },
        {
          "formula_id": "max_increase_rate",
          "name_ko": "최대 증가율",
          "role": "corollary",
          "latex": "\\max D_{\\mathbf{u}}f=\\|\\nabla f\\|\\ (\\mathbf{u}=\\nabla f/\\|\\nabla f\\|\\text{ 방향}),\\qquad\\min D_{\\mathbf{u}}f=-\\|\\nabla f\\|",
          "cas": "grad_f.norm()"
        }
      ],
