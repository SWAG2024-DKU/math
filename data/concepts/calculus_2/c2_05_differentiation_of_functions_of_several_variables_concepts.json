    {
      "concept_id": "calculus.partial_derivative",
      "order": 3,
      "name_ko": "편도함수와 고계편도함수",
      "definition": "z=f(x,y)에서 y를 상수로 두고 x에 대해 미분한 것이 x에 대한 편도함수 f_x이며, f_x(a,b)는 곡면을 y=b로 자른 단면곡선의 접선기울기다. 편도함수를 다시 편미분하면 고계편도함수를 얻으며, f_xy와 f_yx가 한 점 근방에서 연속이면 두 값이 같다(Clairaut 정리).",
      "formulas": [
        {
          "formula_id": "partial_derivative_def",
          "name_ko": "편도함수의 정의",
          "role": "definition",
          "latex": "f_x(a,b)=\\lim_{h\\to0}\\frac{f(a+h,b)-f(a,b)}h,\\qquad f_y(a,b)=\\lim_{h\\to0}\\frac{f(a,b+h)-f(a,b)}h",
          "cas": "limit((f(a+h,b)-f(a,b))/h, h, 0)"
        },
        {
          "formula_id": "second_order_partials",
          "name_ko": "고계편도함수",
          "role": "definition",
          "latex": "f_{xx}=\\frac{\\partial^2f}{\\partial x^2},\\ f_{yy}=\\frac{\\partial^2f}{\\partial y^2},\\ f_{xy}=\\frac{\\partial^2f}{\\partial y\\partial x},\\ f_{yx}=\\frac{\\partial^2f}{\\partial x\\partial y}",
          "cas": "diff(f(x,y), x, y)"
        },
        {
          "formula_id": "clairauts_theorem",
          "name_ko": "혼합편도함수의 일치(Clairaut 정리)",
          "role": "theorem",
          "latex": "f_{xy},f_{yx}\\text{가 한 점 근방에서 연속}\\implies f_{xy}=f_{yx}",
          "cas": "Eq(diff(f(x,y),x,y), diff(f(x,y),y,x))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "other_variables_held_constant",
          "description": "한 변수에 대해 편미분할 때 나머지 변수는 상수로 취급한다.",
