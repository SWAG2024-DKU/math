          "formula_id": "lagrange_two_constraints",
          "name_ko": "두 개의 제약조건",
          "role": "generalization",
          "latex": "g(x,y,z)=k,\\ h(x,y,z)=c\\implies\\nabla f=\\lambda\\nabla g+\\mu\\nabla h",
