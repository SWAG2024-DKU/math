    {
      "concept_id": "calculus.multivariable_limit_and_continuity",
      "order": 2,
      "name_ko": "다변수함수의 극한과 연속",
      "definition": "(x,y)→(a,b)일 때 f(x,y)가 L에 가까워지면 극한이 L이라 한다. 극한이 존재하려면 모든 접근 경로에서 같은 값에 수렴해야 하며, 서로 다른 경로에서 다른 값이 나오면 극한은 존재하지 않는다(단, 여러 경로가 일치한다고 극한 존재가 증명되지는 않음). 연속은 극한값=함숫값 조건을 요구한다.",
      "formulas": [
        {
          "formula_id": "multivariable_limit_def",
          "name_ko": "다변수함수의 극한",
          "role": "definition",
          "latex": "\\lim_{(x,y)\\to(a,b)}f(x,y)=L",
          "cas": "limit(f(x,y), (x,y), (a,b))"
        },
        {
          "formula_id": "path_test_examples",
          "name_ko": "경로 예시",
          "role": "technique",
          "latex": "y=b,\\quad x=a,\\quad y-b=m(x-a),\\quad y-b=(x-a)^2",
          "cas": "f(x, b)"
        },
        {
          "formula_id": "polar_substitution_for_limit",
          "name_ko": "극좌표 치환",
          "role": "technique",
          "latex": "x=r\\cos\\theta,\\ y=r\\sin\\theta,\\qquad(x,y)\\to(0,0)\\iff r\\to0",
          "cas": "f(r*cos(theta), r*sin(theta))"
        },
        {
          "formula_id": "multivariable_continuity",
          "name_ko": "연속의 정의",
          "role": "definition",
          "latex": "\\lim_{(x,y)\\to(a,b)}f(x,y)=f(a,b)",
          "cas": "Eq(limit(f(x,y),(x,y),(a,b)), f(a,b))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "path_disagreement_proves_nonexistence",
          "description": "서로 다른 두 경로에서 다른 극한값이 나오면 전체 극한은 존재하지 않는다.",
          "rule": {
            "property": "two_paths_give_different_limits",
            "operator": "equals",
            "value": true
          }
        },
        {
          "condition_id": "path_agreement_not_sufficient",
          "description": "여러 경로에서 같은 값이 나온다는 사실만으로 전체 극한이 존재한다고 결론 내릴 수 없다.",
          "rule": {
            "property": "path_agreement_proves_existence",
            "operator": "equals",
            "value": false
          }
        },
        {
          "condition_id": "polar_limit_must_be_theta_independent",
          "description": "극좌표로 바꾼 식이 θ와 무관하게 같은 값으로 수렴해야 원점에서의 극한 존재를 보이는 데 유용하다.",
          "rule": {
            "property": "polar_form_limit_independent_of_theta",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "continuous_function_combinations",
          "description": "다항함수는 모든 점에서 연속이고, 유리함수는 분모가 0이 아닌 곳에서 연속이며, 연속함수의 합·차·곱·합성은 정의되는 곳에서 연속이다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.limit_definition",
          "name_ko": "함수의 극한",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "calculus.partial_derivative"
      ],
      "learning_objectives": [
