    {
      "concept_id": "calculus.multivariable_extrema",
      "order": 8,
      "name_ko": "다변수함수의 극값과 이차미분판정법",
      "definition": "(a,b) 근방에서 f(a,b)≥f(x,y)이면 국소최대, f(a,b)≤f(x,y)이면 국소최소를 갖는다. 임계점은 f_x=f_y=0이거나 편도함수가 존재하지 않는 점이다. 이차미분판정법은 D=f_xx f_yy-(f_xy)²로 D>0,f_xx>0이면 국소최소, D>0,f_xx<0이면 국소최대, D<0이면 안장점, D=0이면 판정 불가로 분류한다. 닫히고 유계인 영역에서 연속함수는 절대최댓값·최솟값을 갖는다(극값정리).",
      "formulas": [
        {
          "formula_id": "critical_point_def",
          "name_ko": "임계점의 정의",
          "role": "definition",
          "latex": "f_x(a,b)=0,\\ f_y(a,b)=0\\ \\text{또는 편도함수 중 하나 이상이 존재하지 않음}",
          "cas": "solve([Eq(fx(a,b),0), Eq(fy(a,b),0)], [a,b])"
        },
        {
          "formula_id": "second_derivative_test",
          "name_ko": "이차미분판정법",
          "role": "theorem",
          "latex": "D=f_{xx}f_{yy}-(f_{xy})^2:\\ D>0,f_{xx}>0\\Rightarrow\\text{국소최소};\\ D>0,f_{xx}<0\\Rightarrow\\text{국소최대};\\ D<0\\Rightarrow\\text{안장점};\\ D=0\\Rightarrow\\text{판정 불가}",
          "cas": "fxx(a,b)*fyy(a,b) - fxy(a,b)**2"
        },
        {
          "formula_id": "extreme_value_theorem_multivariable",
          "name_ko": "극값정리(다변수)",
          "role": "theorem",
          "latex": "D\\text{가 닫히고 유계, }f\\text{ 연속}\\implies f\\text{는 }D\\text{에서 절대최댓값·최솟값을 가짐}",
          "cas": "Max(f, D)"
        }
      ],
      "application_conditions": [
