    {
      "concept_id": "calculus.multivariable_chain_rule",
      "order": 5,
      "name_ko": "다변수 연쇄법칙과 암시적 미분",
      "definition": "z=f(x,y)이고 x,y가 t의 함수이면 dz/dt=f_x·dx/dt+f_y·dy/dt이다. x,y가 두 매개변수 s,t의 함수이면 ∂z/∂s, ∂z/∂t를 각각 유사하게 구하며, 트리 다이어그램으로 의존관계를 정리한다. F(x,y)=0이 y를 x의 함수로 정의하면 암시적 미분으로 dy/dx=-F_x/F_y(F_y≠0)를 얻는다.",
      "formulas": [
        {
          "formula_id": "chain_rule_one_parameter",
          "name_ko": "한 매개변수에 대한 연쇄법칙",
          "role": "theorem",
          "latex": "\\frac{dz}{dt}=\\frac{\\partial f}{\\partial x}\\frac{dx}{dt}+\\frac{\\partial f}{\\partial y}\\frac{dy}{dt}",
          "cas": "diff(f(x(t),y(t)), t)"
        },
        {
          "formula_id": "chain_rule_two_parameters",
          "name_ko": "두 매개변수에 대한 연쇄법칙",
          "role": "theorem",
          "latex": "\\frac{\\partial z}{\\partial s}=f_x\\frac{\\partial x}{\\partial s}+f_y\\frac{\\partial y}{\\partial s},\\qquad\\frac{\\partial z}{\\partial t}=f_x\\frac{\\partial x}{\\partial t}+f_y\\frac{\\partial y}{\\partial t}",
          "cas": "diff(f(x(s,t),y(s,t)), s)"
        },
        {
          "formula_id": "chain_rule_three_variable",
          "name_ko": "세 변수 함수의 연쇄법칙",
          "role": "theorem",
          "latex": "\\frac{dw}{dt}=f_x\\frac{dx}{dt}+f_y\\frac{dy}{dt}+f_z\\frac{dz}{dt}",
          "cas": "diff(f(x(t),y(t),z(t)), t)"
        },
        {
          "formula_id": "multivariable_implicit_diff",
          "name_ko": "암시적 미분",
          "role": "theorem",
          "latex": "F(x,y)=0\\implies\\frac{dy}{dx}=-\\frac{F_x}{F_y}\\quad(F_y\\neq0)",
          "cas": "-diff(F(x,y),x)/diff(F(x,y),y)"
        }
      ],
      "application_conditions": [
