    {
      "concept_id": "la.determinant.cofactor",
      "order": 4,
      "name_ko": "여인수 전개를 통한 행렬식 계산",
      "definition": "정사각행렬의 행렬식을 구하기 위해 임의의 행이나 열을 선택하고 소행렬식과 부호 패턴을 결합한 여인수의 스칼라 선형결합으로 분해하는 연산법이다.",
      "formulas": [
        {
          "formula_id": "cofactor_formula",
          "name_ko": "여인수 정의",
          "role": "definition",
          "latex": "C_{ij} = (-1)^{i+j} M_{ij}",
          "cas": "(-1)**(i+j) * minor(A, i, j)"
