    {
      "concept_id": "la.transformation.matrix",
      "order": 2,
      "name_ko": "기하학적 선형변환과 표준행렬",
      "definition": "R^n에서 R^m으로 가는 모든 기하학적 선형변환 T는 유일한 m x n 행렬 A의 곱셈으로 완벽하게 대체하여 표현할 수 있으며, 이 행렬을 표준행렬이라 한다.",
      "formulas": [
        {
          "formula_id": "standard_matrix_definition",
          "name_ko": "표준행렬의 구성",
          "role": "definition",
          "latex": "A = [T(\\mathbf{e}_1) \\ T(\\mathbf{e}_2) \\ \\cdots \\ T(\\mathbf{e}_n)]",
          "cas": "Matrix([T(e1), T(e2), ..., T(en)])"
        },
        {
          "formula_id": "composition_matrix",
          "name_ko": "합성변환의 행렬",
          "role": "property",
          "latex": "T_2(T_1(\\mathbf{x})) \\iff (A_2 A_1)\\mathbf{x}",
          "cas": "A2 * A1 * x"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "use_standard_basis",
          "description": "표준행렬을 구성할 때는 반드시 정의역의 표준기저벡터를 T에 통과시킨 결과물들을 순서대로 열벡터로 배치해야 한다.",
          "rule": {
            "property": "uses_standard_basis",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "geometric_transformations",
          "description": "회전, 대칭, 전단, 사영 등 모든 선형적 기하 변환은 행렬 성분으로 수치화할 수 있다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "la.space.basis",
          "name_ko": "표준기저벡터",
          "importance": "required"
        },
        {
          "concept_id": "la.matrix.multiplication",
          "name_ko": "행렬-벡터 곱셈",
          "importance": "required"
        },
        {
          "concept_id": "calculus.composition",
          "name_ko": "합성함수",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "la.transformation.image_kernel"
      ],
      "learning_objectives": [
        {
          "objective_id": "find_standard_matrix",
          "verb": "calculate",
          "description": "주어진 선형변환의 표준행렬을 도출한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "la.transformation.matrix.composition_order_reversal",
          "title": "합성변환의 행렬 곱 순서 역전",
          "description": "변환 T1을 먼저 적용하고 T2를 나중에 적용할 때 표준행렬의 곱을 A1 A2로 작성한다.",
          "diagnosis_tag": "composition_matrix_order_error",
          "feedback": "함수 합성 순서와 동일하게 A2 A1 순서로 행렬 곱을 작성해야 합니다."
        }
      ],
