          "name_ko": "벡터의 선형결합",
          "importance": "required"
        },
        {
          "concept_id": "la.space.vector_space_axiom",
          "name_ko": "벡터 공간의 공리",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "la.transformation.matrix"
      ],
      "learning_objectives": [
        {
          "objective_id": "test_linear_transformation",
          "verb": "evaluate",
          "description": "주어진 함수가 선형성 조건을 만족하는지 판정한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "la.transformation.linear_test.affine_confusion",
          "title": "아핀 변환과의 혼동",
