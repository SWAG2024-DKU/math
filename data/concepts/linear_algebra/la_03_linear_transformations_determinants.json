    {
      "concept_id": "la.transformation.linear_test",
      "order": 1,
      "name_ko": "선형변환의 판정과 성질",
      "definition": "정의역 벡터 공간의 임의의 두 벡터에 대해 덧셈과 스칼라곱 연산 구조를 공역으로 그대로 보존하며 매핑하는 특수한 함수 T를 선형변환이라 한다.",
      "formulas": [
        {
          "formula_id": "superposition_principle",
          "name_ko": "선형성 판정 조건",
          "role": "definition",
          "latex": "T(c\\mathbf{u} + d\\mathbf{v}) = cT(\\mathbf{u}) + dT(\\mathbf{v})",
          "cas": "Eq(T(c*u + d*v), c*T(u) + d*T(v))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "maps_zero_to_zero",
          "description": "매핑 함수 T의 정의역과 공역은 반드시 유효한 벡터 공간이어야 하며, 임의의 선형변환은 항상 원점을 원점으로 매핑해야 한다 (T(0) = 0).",
          "rule": {
            "property": "maps_zero_vector",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "grid_preservation",
          "description": "선형변환은 공간의 격자 평행성과 등간격을 유지하며 변환시킨다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "calculus.function",
          "name_ko": "함수의 매핑(정의역/공역)",
          "importance": "required"
        },
        {
