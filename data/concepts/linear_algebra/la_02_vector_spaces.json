      ],
      "application_conditions": [
        {
          "condition_id": "non_empty_and_linear",
          "description": "집합 H는 공집합이 아니어야 하며, 0이 아닌 상수항이나 비선형 항이 포함되어 있지 않아야 한다.",
          "rule": {
            "property": "is_homogeneous_linear_set",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "homogeneous_solution_is_subspace",
          "description": "동차 선형방정식계 Ax=0의 해집합은 항상 부분공간을 이루나, 비동차 시스템의 해집합은 아핀 공간이다."
        }
      ],
