    {
      "concept_id": "la.space.span",
      "order": 2,
      "name_ko": "선형결합과 생성공간 (Span)",
      "definition": "벡터 집합의 스칼라 가중치 합으로 표현 가능한 모든 벡터의 집합을 Span이라 하며, 특정 벡터의 소속 여부를 해의 존재성으로 판별한다.",
      "formulas": [
        {
          "formula_id": "span_definition",
          "name_ko": "생성 공간",
          "role": "definition",
          "latex": "\\text{Span}(S) = \\{c_1\\mathbf{v}_1 + \\cdots + c_k\\mathbf{v}_k \\mid c_i \\in \\mathbb{R}\\}",
          "cas": "linear_span(S)"
        },
        {
          "formula_id": "membership_test",
          "name_ko": "소속 여부 판정",
          "role": "algorithm",
          "latex": "A\\mathbf{c} = \\mathbf{b} \\text{ 의 해 존재성}",
          "cas": "is_consistent(AugmentedMatrix(A, b))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "consistent_augmented_matrix",
          "description": "첨가행렬 [A | b]의 RREF 변환 시 불능 조건이 검출되지 않아야 한다.",
          "rule": {
            "property": "is_consistent",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "smallest_subspace",
          "description": "Span(S)는 주어진 벡터들을 포함하는 가장 작은 부분공간이다."
        }
      ],
