    {
      "concept_id": "la.matrix.ero_ref",
      "order": 2,
      "name_ko": "기본행연산(ERO)과 행사다리꼴(REF) 소거",
      "definition": "기본행연산을 적용하여 첨가행렬의 선도원소 아래쪽 성분들을 0으로 지워나가며, 계단 모양의 상삼각 형태인 행사다리꼴(REF)로 변환하는 알고리즘이다.",
      "formulas": [
        {
          "formula_id": "ero_swap",
          "name_ko": "행 교환",
          "role": "operation",
          "latex": "R_i \\leftrightarrow R_j",
          "cas": "Matrix.row_swap(i, j)"
        },
        {
          "formula_id": "ero_scale",
          "name_ko": "스칼라배",
          "role": "operation",
          "latex": "cR_i \\to R_i",
          "cas": "Matrix.row_op(i, lambda v, j: c*v)"
        },
        {
          "formula_id": "ero_replace",
          "name_ko": "행 가산",
          "role": "operation",
          "latex": "R_i + cR_j \\to R_i",
          "cas": "Matrix.row_op(i, lambda v, k: v + c*M[j, k])"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "nonzero_scale",
          "description": "스칼라배를 하거나 가산할 때 곱하는 상수는 0이 될 수 없다.",
          "rule": {
            "property": "scale_factor",
            "operator": "not_equals",
            "value": 0
          }
        }
      ],
      "properties": [
        {
          "property_id": "solution_preservation",
          "description": "기본행연산은 연립방정식의 본래 해집합을 전혀 훼손하지 않는다."
