    {
      "concept_id": "la.matrix.system_form",
      "order": 1,
      "name_ko": "선형방정식계의 형태와 연립방정식의 대수적 표현",
      "definition": "m개의 일차방정식과 n개의 미지수로 구성된 시스템을 계수행렬과 상수벡터의 첨가행렬 [A | b] 및 벡터의 선형결합 방정식으로 변환하여 대수적으로 다루기 쉬운 형태로 추상화하는 과정이다.",
      "formulas": [
        {
          "formula_id": "matrix_equation",
          "name_ko": "행렬 방정식",
          "role": "general_form",
          "latex": "A\\mathbf{x} = \\mathbf{b}",
          "cas": "Eq(A * x, b)"
        },
        {
          "formula_id": "vector_equation",
          "name_ko": "벡터 방정식",
          "role": "general_form",
          "latex": "x_1\\mathbf{a}_1 + x_2\\mathbf{a}_2 + \\cdots + x_n\\mathbf{a}_n = \\mathbf{b}",
          "cas": "Eq(Sum(x[i]*a[i], (i, 1, n)), b)"
        },
        {
          "formula_id": "augmented_matrix",
          "name_ko": "첨가행렬",
          "role": "representation",
          "latex": "[A \\mid \\mathbf{b}]",
          "cas": "BlockMatrix([A, b])"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "linear_terms_only",
          "description": "비선형 항(미지수 간의 곱, 제곱, 삼각함수 등)이 존재하지 않는 완전한 일차식 시스템이어야 행렬 매핑이 가능하다.",
          "rule": {
            "property": "is_linear_system",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "algebraic_equivalence",
          "description": "연립일차방정식, 행렬과 벡터의 곱, 열벡터들의 선형결합은 표현 형태만 다를 뿐 대수적, 알고리즘적으로 완전히 동치이다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "algebra.linear_equation",
          "name_ko": "일차방정식",
          "importance": "required"
        },
        {
          "concept_id": "algebra.vector_scalar",
          "name_ko": "벡터와 스칼라",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "la.matrix.ero_ref"
      ],
      "learning_objectives": [
        {
          "objective_id": "convert_forms",
          "verb": "transform",
          "description": "연립일차방정식을 행렬 방정식과 벡터 방정식으로 상호 변환한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "la.matrix.system_form.view_confusion",
          "title": "방정식 관점과 열벡터 관점의 혼동",
          "description": "방정식을 초평면들의 교집합으로만 보고, 미지수를 열벡터의 가중치로 해석하는 벡터 방정식 관점으로 전환하지 못한다.",
          "diagnosis_tag": "vector_weight_view_failure",
          "feedback": "미지수 벡터의 각 성분은 계수행렬의 각 열벡터에 곱해지는 선형결합의 가중치로 해석되어야 합니다."
        },
        {
          "misconception_id": "la.matrix.system_form.dimension_inversion",
          "title": "행렬 차원과 제약 조건의 역전",
          "description": "m x n 행렬에서 행과 열의 의미(제약 조건의 수 vs 미지수의 수)를 혼동한다.",
          "diagnosis_tag": "matrix_dimension_confusion",
          "feedback": "행렬의 행(m)은 방정식(제약 조건)의 개수이며, 열(n)은 미지수(공간의 차원)의 개수입니다."
        }
      ],
