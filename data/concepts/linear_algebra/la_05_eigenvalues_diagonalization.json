    {
      "concept_id": "la.eigen.eigenvector",
      "order": 2,
      "name_ko": "고유벡터(Eigenvector) 및 고유공간(Eigenspace) 구하기",
      "definition": "산출된 고윳값을 (A - lambda I)x = 0 동차방정식에 대입하여 도출한 영벡터가 아닌 해벡터를 고유벡터라 하며, 이 해공간 전체를 고유공간이라 한다.",
      "formulas": [
        {
          "formula_id": "eigenspace_definition",
          "name_ko": "고유공간 정의",
          "role": "definition",
          "latex": "E_\\lambda = N(A - \\lambda I)",
          "cas": "null_space(A - lambda_val * Eye(A.shape[0]))"
        },
        {
          "formula_id": "geometric_multiplicity",
          "name_ko": "기하적 중복도",
          "role": "formula",
          "latex": "\\dim(E_\\lambda) = n - \\text{Rank}(A - \\lambda I)",
          "cas": "n - rank(A - lambda_val * Eye(n))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "no_zero_eigenvector",
          "description": "도출된 기저 벡터는 절대로 영벡터가 되어서는 안 된다.",
          "rule": {
            "property": "is_nonzero_vector",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "multiplicity_bound",
          "description": "항상 1 <= 기하적 중복도 <= 대수적 중복도 관계가 성립한다."
        }
      ],
