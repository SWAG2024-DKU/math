  "concepts": [
    {
      "concept_id": "la.eigen.eigenvalue",
      "order": 1,
      "name_ko": "특성방정식과 고윳값(Eigenvalue) 계산",
      "definition": "정사각행렬 A에 의한 변환 결과가 자기 자신의 스칼라배가 되도록 하는 특정 스칼라 값을 고윳값이라 하며, det(A - lambda I) = 0을 통해 특성다항식의 근을 찾는 알고리즘이다.",
      "formulas": [
        {
          "formula_id": "eigenvalue_definition",
          "name_ko": "고윳값의 정의",
          "role": "definition",
          "latex": "A\\mathbf{x} = \\lambda\\mathbf{x}",
          "cas": "Eq(A * x, lambda_val * x)"
        },
        {
          "formula_id": "characteristic_equation",
          "name_ko": "특성방정식",
          "role": "definition",
          "latex": "\\det(A - \\lambda I) = 0",
          "cas": "det(A - lambda_val * Eye(A.shape[0])) == 0"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "square_matrix_for_eigen",
          "description": "행렬 A는 반드시 n x n 정사각행렬이어야 한다.",
          "rule": {
            "property": "is_square_matrix",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "trace_and_determinant_relation",
          "description": "고윳값들의 총합은 대각합(Trace)과 같고, 총곱은 행렬식(det(A))과 일치한다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "la.determinant.cofactor",
          "name_ko": "행렬식",
          "importance": "required"
        },
        {
          "concept_id": "algebra.identity_matrix",
          "name_ko": "항등행렬",
          "importance": "required"
        },
        {
          "concept_id": "algebra.polynomial_roots",
          "name_ko": "다항식의 근",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "la.eigen.eigenvector"
      ],
      "learning_objectives": [
        {
          "objective_id": "compute_eigenvalues",
          "verb": "calculate",
          "description": "특성방정식을 풀어 고윳값을 산출한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "la.eigen.eigenvalue.dimension_mismatch",
          "title": "차원 붕괴 연산",
          "description": "A - lambda I를 계산할 때 항등행렬 I를 곱하지 않고 A - lambda로 표기하여 행렬과 스칼라를 직접 뺀다.",
          "diagnosis_tag": "matrix_scalar_subtraction_error",
          "feedback": "스칼라 lambda는 대각 성분에만 빼야 하므로 반드시 항등행렬 I를 곱한 A - lambda I 형태로 연산해야 합니다."
        }
      ],
