    {
      "concept_id": "la.advanced.svd",
      "order": 1,
      "name_ko": "특이값 분해 (Singular Value Decomposition, SVD)",
      "definition": "정사각행렬에만 국한되던 고윳값 분해를 일반화하여 임의의 m x n 직사각행렬 A를 회전, 스케일링, 회전이라는 세 가지 기하학적 직교 변환의 조합으로 완전 분해하는 행렬 분해 기법이다.",
      "formulas": [
        {
          "formula_id": "svd_formula",
          "name_ko": "SVD 분해 모델",
          "role": "definition",
          "latex": "A = U \\Sigma V^T",
          "cas": "U, S, V = Matrix(A).singular_value_decomposition()"
        },
        {
          "formula_id": "singular_values_definition",
          "name_ko": "특이값 정의",
          "role": "formula",
          "latex": "\\sigma_i = \\sqrt{\\lambda_i(A^T A)}",
          "cas": "sqrt(eigenvals(A.T * A))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "positive_semi_definite_gram_matrix",
          "description": "특이값을 구하기 위한 A^T A는 양의 반정부호 대칭행렬이므로 고윳값은 항상 0 이상의 실수여야 한다.",
          "rule": {
            "property": "is_positive_semi_definite",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "svd_rank_equality",
          "description": "행렬의 랭크는 0이 아닌 특이값의 개수 r과 정확히 일치한다."
        }
      ],
      "prerequisites": [
        {
          "concept_id": "la.eigen.symmetric_diagonalization",
          "name_ko": "대칭행렬의 직교 대각화",
          "importance": "required"
        },
        {
          "concept_id": "la.ortho.complement",
          "name_ko": "4대 부분공간",
          "importance": "required"
        },
        {
          "concept_id": "la.ortho.orthonormal_set",
          "name_ko": "직교행렬",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "la.advanced.compact_svd",
        "la.advanced.pseudoinverse"
      ],
      "learning_objectives": [
        {
          "objective_id": "compute_svd",
          "verb": "calculate",
          "description": "임의의 행렬에 대해 SVD를 수행하여 U, Sigma, V 행렬을 구한다."
        }
      ],
      "misconceptions": [
        {
          "misconception_id": "la.advanced.svd.matrix_domain_reversal",
          "title": "U와 V의 연산 행렬 역전",
          "description": "V를 구해야 하는데 AA^T를 계산하거나 U를 구해야 하는데 A^TA를 계산한다.",
          "diagnosis_tag": "svd_domain_matrix_reversal",
          "feedback": "V는 A^T A의 고유벡터로 구성되고, U는 A A^T의 고유벡터로 구성됩니다."
        }
      ],
