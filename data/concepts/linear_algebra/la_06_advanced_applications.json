      "concept_id": "la.advanced.jordan_form",
      "order": 6,
      "name_ko": "조르당 표준형 (Jordan Canonical Form)",
      "definition": "고유벡터가 부족하여 대각화가 불가능한 결함 행렬을 대각행렬에 가장 근사한 형태인 주대각선 위가 1인 블록 행렬 구조로 기저 변환하는 알고리즘이다.",
      "formulas": [
        {
          "formula_id": "jordan_decomposition_formula",
          "name_ko": "조르당 분해 모델",
          "role": "definition",
          "latex": "A = M J M^{-1}",
          "cas": "J, M = Matrix(A).jordan_form()"
        },
        {
          "formula_id": "generalized_eigenvector_chain",
          "name_ko": "일반화 고유벡터 체인",
