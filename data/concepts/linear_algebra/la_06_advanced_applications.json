    {
      "concept_id": "la.advanced.compact_svd",
      "order": 2,
      "name_ko": "축소 SVD (Compact SVD)와 행렬 근사",
      "definition": "원본 SVD에서 0인 특이값과 영공간 벡터를 제거하여 연산을 최적화하고 상위 k개의 특이값만 남겨 노이즈를 제거한 최적의 저랭크 근사를 구현하는 과정이다.",
      "formulas": [
        {
          "formula_id": "truncated_svd_formula",
          "name_ko": "절단 SVD",
          "role": "formula",
          "latex": "A_k = \\sum_{i=1}^{k} \\sigma_i \\mathbf{u}_i \\mathbf{v}_i^T",
          "cas": "sum(sigma_i * outer(u_i, v_i) for i in range(k))"
        },
        {
          "formula_id": "eckart_young_mirsky",
          "name_ko": "Eckart-Young-Mirsky 정리",
          "role": "theorem",
          "latex": "\\min_{\\text{Rank}(B)=k} \\|A - B\\|_F = \\|A - A_k\\|_F = \\sqrt{\\sum_{i=k+1}^{r} \\sigma_i^2}",
          "cas": "sqrt(sum(S[i]**2 for i in range(k, r)))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "descending_order_singular_values",
          "description": "외적을 합산하는 스펙트럼 분해 방식을 적용할 때 특이값이 큰 순서대로 내림차순 정렬되어 있어야 한다.",
          "rule": {
            "property": "singular_values_sorted_descending",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "optimal_low_rank_approximation",
          "description": "절단 SVD로 만든 랭크 k 행렬은 원본과의 프로베니우스 노름 오차가 가장 작은 최적의 근사치이다."
        }
      ],
      "prerequisites": [
