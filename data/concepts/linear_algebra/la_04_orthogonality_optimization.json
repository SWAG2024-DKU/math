        }
      ],
      "misconceptions": [
        {
          "misconception_id": "la.ortho.complement.subspace_mapping_error",
          "title": "부분공간 매핑 축 역전",
          "description": "열공간의 직교 여공간을 구할 때 좌영공간이 아닌 원본 영공간을 계산한다.",
          "diagnosis_tag": "wrong_complement_mapping",
          "feedback": "열공간 C(A)의 직교 여공간은 좌영공간 N(A^T)입니다."
        }
