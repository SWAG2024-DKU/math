    {
      "concept_id": "la.ortho.gram_schmidt",
      "order": 5,
      "name_ko": "그람-슈미트 직교화 (Gram-Schmidt Process)",
      "definition": "임의의 일반 기저 벡터 집합으로부터 이전 벡터가 만든 공간으로의 직교 사영을 순차적으로 빼나가며 새로운 직교기저를 추출하는 알고리즘이다.",
      "formulas": [
        {
          "formula_id": "gram_schmidt_formula",
          "name_ko": "그람-슈미트 순환식",
          "role": "algorithm",
          "latex": "\\mathbf{v}_k = \\mathbf{x}_k - \\sum_{j=1}^{k-1} \\left( \\frac{\\mathbf{x}_k \\cdot \\mathbf{v}_j}{\\mathbf{v}_j \\cdot \\mathbf{v}_j}\\mathbf{v}_j \\right)",
          "cas": "gram_schmidt(X)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "linearly_independent_input",
          "description": "입력되는 초기 벡터 집합은 반드시 선형독립이어야 한다.",
