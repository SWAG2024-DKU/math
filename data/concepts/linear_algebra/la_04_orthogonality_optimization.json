    {
      "concept_id": "la.ortho.projection",
      "order": 4,
      "name_ko": "부분공간으로의 직교 사영 (Orthogonal Projection)",
      "definition": "벡터 b를 특정 부분공간 W 위의 가장 가까운 투영 성분과 수직인 직교 오차 성분으로 분해하는 기하학적 연산이다.",
      "formulas": [
        {
          "formula_id": "orthogonal_projection_formula",
          "name_ko": "직교 기저 기준 사영",
          "role": "formula",
          "latex": "\\hat{\\mathbf{b}} = \\frac{\\mathbf{b} \\cdot \\mathbf{u}_1}{\\mathbf{u}_1 \\cdot \\mathbf{u}_1}\\mathbf{u}_1 + \\cdots + \\frac{\\mathbf{b} \\cdot \\mathbf{u}_p}{\\mathbf{u}_p \\cdot \\mathbf{u}_p}\\mathbf{u}_p",
          "cas": "sum((Dot(b, u_i) / Dot(u_i, u_i)) * u_i for u_i in U)"
        },
        {
          "formula_id": "projection_matrix",
          "name_ko": "사영행렬",
          "role": "definition",
          "latex": "P = A(A^T A)^{-1}A^T",
          "cas": "A * (A.T * A).inv() * A.T"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "orthogonal_basis_required_for_simple_formula",
          "description": "단순 성분별 합산 형태의 사영 공식을 쓰려면 투영 기준이 되는 부분공간의 기저가 반드시 서로 직교해야 한다.",
          "rule": {
            "property": "basis_is_orthogonal",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "idempotent_symmetric_projection",
          "description": "사영행렬 P는 대칭행렬이며 멱등성(P^2 = P)을 가진다."
        }
      ],
