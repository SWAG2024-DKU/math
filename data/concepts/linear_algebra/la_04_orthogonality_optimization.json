    {
      "concept_id": "la.ortho.norm_distance",
      "order": 1,
      "name_ko": "내적 공간과 노름(Norm)·거리 계산",
      "definition": "공간 상의 두 벡터의 성분끼리 곱하고 합하여 하나의 실수로 매핑하는 점곱을 통해 벡터의 기하학적 크기와 벡터 간의 거리 및 각도를 대수적으로 수치화한다.",
      "formulas": [
        {
          "formula_id": "dot_product",
          "name_ko": "표준 내적",
          "role": "definition",
          "latex": "\\mathbf{u} \\cdot \\mathbf{v} = \\mathbf{u}^T \\mathbf{v}",
          "cas": "Dot(u, v)"
        },
        {
          "formula_id": "norm_and_distance",
          "name_ko": "노름과 거리",
          "role": "definition",
          "latex": "\\|\\mathbf{u}\\| = \\sqrt{\\mathbf{u} \\cdot \\mathbf{u}}, \\quad \\text{dist}(\\mathbf{u}, \\mathbf{v}) = \\|\\mathbf{u} - \\mathbf{v}\\|",
          "cas": "Norm(u), Norm(u - v)"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "same_dimension_euclidean",
          "description": "유클리드 공간 R^n에서 두 벡터는 반드시 동일한 차원인 n x 1 열벡터여야 내적 연산이 정의된다.",
          "rule": {
            "property": "vector_dimensions_equal",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "positive_definiteness_inner",
          "description": "u dot u = 0이 될 필요충분조건은 오직 u = 0일 때뿐이다."
        }
      ],
      "prerequisites": [
        {
