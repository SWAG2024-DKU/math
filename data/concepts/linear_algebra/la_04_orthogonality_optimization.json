    {
      "concept_id": "la.ortho.qr_decomposition",
      "order": 6,
      "name_ko": "QR 분해 (QR Decomposition)",
      "definition": "행렬 A의 열벡터들에 그람-슈미트 직교화를 적용하여 정규직교열을 가진 행렬 Q와 상삼각행렬 R의 곱으로 분해하는 알고리즘이다.",
      "formulas": [
        {
          "formula_id": "qr_factorization",
          "name_ko": "QR 분해식",
          "role": "definition",
          "latex": "A = QR, \\quad Q^T Q = I",
          "cas": "Q, R = QR_decomposition(A)"
        },
        {
          "formula_id": "r_matrix_calculation",
          "name_ko": "R 행렬 구성",
          "role": "formula",
          "latex": "R = Q^T A, \\quad r_{ij} = \\mathbf{q}_i \\cdot \\mathbf{a}_j \\ (i \\le j)",
          "cas": "Q.T * A"
        }
      ],
      "application_conditions": [
