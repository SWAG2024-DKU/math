    {
      "concept_id": "la.ortho.complement",
      "order": 2,
      "name_ko": "직교성과 직교 여공간 (Orthogonal Complement)",
      "definition": "부분공간 W에 속한 모든 벡터와 내적이 0이 되는 벡터들의 집합을 직교 여공간이라 하며, 행렬의 4대 부분공간 간 직교 관계를 대수적으로 모델링한다.",
      "formulas": [
        {
          "formula_id": "orthogonal_complement_def",
          "name_ko": "직교 여공간 정의",
          "role": "definition",
          "latex": "W^\\perp = \\{\\mathbf{z} \\in \\mathbb{R}^n \\mid \\mathbf{z} \\cdot \\mathbf{w} = 0 \\text{ for all } \\mathbf{w} \\in W \\}",
          "cas": "orthogonal_complement(W)"
        },
        {
          "formula_id": "fundamental_subspaces_orthogonality",
          "name_ko": "핵심 부분공간 직교성",
          "role": "property",
          "latex": "N(A) = C(A^T)^\\perp, \\quad N(A^T) = C(A)^\\perp",
          "cas": "is_orthogonal(null_space(A), row_space(A))"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "use_basis_for_complement",
          "description": "부분공간 W에 직교하는 벡터를 구할 때 W의 기저 벡터들과의 내적이 0이 되는지 검증하면 충분하다.",
          "rule": {
            "property": "test_against_basis",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "complement_dimension_sum",
          "description": "공간과 그 직교 여공간의 차원을 합하면 항상 전체 공간의 차원이 된다."
        }
      ],
      "prerequisites": [
