          "name_ko": "벡터의 덧셈",
          "importance": "required"
        },
        {
          "concept_id": "algebra.scalar_multiplication",
          "name_ko": "스칼라곱",
          "importance": "required"
        },
        {
          "concept_id": "la.matrix.transpose_symmetric",
          "name_ko": "전치행렬 연산",
          "importance": "required"
        }
      ],
      "related_concepts": [
        "la.ortho.complement"
      ],
      "learning_objectives": [
