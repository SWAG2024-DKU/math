    {
      "concept_id": "la.ortho.orthonormal_set",
      "order": 3,
      "name_ko": "직교집합 및 정규직교집합 (Orthonormal Set)",
      "definition": "서로 다른 두 벡터 간의 내적이 모두 0인 집합을 직교집합이라 하며, 크기가 1로 정규화된 집합을 정규직교집합이라 한다.",
      "formulas": [
        {
          "formula_id": "orthonormal_condition",
          "name_ko": "정규직교 조건",
          "role": "definition",
          "latex": "\\mathbf{u}_i \\cdot \\mathbf{u}_j = \\begin{cases} 0 & (i \\neq j) \\\\ 1 & (i = j) \\end{cases}",
          "cas": "is_orthonormal(U)"
        },
        {
          "formula_id": "orthogonal_matrix_property",
          "name_ko": "직교행렬 특성",
          "role": "property",
          "latex": "Q^T Q = I",
          "cas": "Transpose(Q) * Q == Eye()"
        }
      ],
      "application_conditions": [
        {
          "condition_id": "no_zero_vector_in_orthonormal",
          "description": "영벡터는 크기를 1로 만들 수 없으므로 정규직교집합에 포함될 수 없다.",
          "rule": {
            "property": "contains_no_zero_vector",
            "operator": "equals",
            "value": true
          }
        }
      ],
      "properties": [
        {
          "property_id": "orthogonal_set_is_independent",
          "description": "영벡터를 포함하지 않는 모든 직교집합은 자동으로 선형독립이 되므로 기저가 된다."
        }
      ],
