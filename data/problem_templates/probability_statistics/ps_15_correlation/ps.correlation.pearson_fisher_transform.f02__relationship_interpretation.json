    },
    {
      "type": "concept_application_condition",
      "expression": "tie_ranking_rule_documented equals True",
      "required": true,
      "description": "동점에는 평균순위 등 명시한 순위 규칙을 사용해야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "both_rank_variances_positive equals True",
      "required": true,
      "description": "두 순위 중 적어도 하나의 분산이 0이면 상관계수가 정의되지 않는다."
    },
    {
      "type": "concept_application_condition",
      "expression": "original_variances_positive equals True",
      "required": true,
      "description": "$\\operatorname{Var}(X)>0$이고 $\\operatorname{Var}(Y)>0$이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "affine_scale_coefficients_nonzero equals True",
      "required": true,
      "description": "$b\\ne0$이고 $d\\ne0$이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "original_variances_finite equals True",
      "required": true,
      "description": "X와 Y의 분산은 유한해야 한다."
    }
