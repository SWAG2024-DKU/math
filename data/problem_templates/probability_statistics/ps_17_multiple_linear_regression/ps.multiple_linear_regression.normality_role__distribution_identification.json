      "type": "concept_application_condition",
      "expression": "frequencies_nonnegative equals True",
      "required": true,
      "description": "각 도수는 비음수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "sample_size greater_or_equal 1",
      "required": true,
      "description": "경험적 분포함수와 MAD를 계산하려면 관측값이 적어도 하나인 표본, 즉 $n\\ge1$이 필요하다."
    },
    {
      "type": "concept_application_condition",
      "expression": "sample_size_is_integer equals True",
      "required": true,
      "description": "`sample_size`에 대응하는 값은 정수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "joint_density_exists equals True",
      "required": true,
      "description": "표시된 결합밀도가 존재해야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "conditional_densities_exist equals True",
      "required": true,
      "description": "표시된 조건부밀도들이 존재해야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "conditioning_marginal_densities_positive equals True",
      "required": true,
      "description": "조건부밀도의 분모가 되는 주변밀도는 평가점에서 양수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "joint_and_marginal_density_or_pmf_exist equals True",
      "required": true,
      "description": "결합 및 주변 밀도 또는 질량함수가 존재해야 한다."
    }
