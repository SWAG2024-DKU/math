    },
    {
      "type": "concept_application_condition",
      "expression": "stage_choice_counts_nonnegative_integers equals True",
      "required": true,
      "description": "$m,n$은 비음수 정수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "multiplicity_counts_sum_to_total equals True",
      "required": true,
      "description": "$n_i\\in\\mathbb Z_{\\ge0}$이고 $\\sum_i n_i=n$이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "identical_items_indistinguishable equals True",
      "required": true,
      "description": "같은 종류의 원소끼리는 구별하지 않는다."
    },
    {
      "type": "concept_application_condition",
      "expression": "object_type_count greater_or_equal 0",
      "required": true,
      "description": "$n\\in\\mathbb Z_{\\ge0}$이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "object_type_count_is_integer equals True",
      "required": true,
      "description": "$n$은 정수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "selection_length greater_or_equal 0",
      "required": true,
      "description": "$r\\in\\mathbb Z_{\\ge0}$이어야 한다."
