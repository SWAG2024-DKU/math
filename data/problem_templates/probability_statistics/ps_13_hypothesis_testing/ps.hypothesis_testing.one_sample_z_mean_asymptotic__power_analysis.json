    },
    {
      "type": "concept_application_condition",
      "expression": "sample_size greater_or_equal 1",
      "required": true,
      "description": "$n\\ge1$이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "sample_size_is_integer equals True",
      "required": true,
      "description": "`sample_size`에 대응하는 값은 정수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "sample_size_is_integer equals True",
      "required": true,
      "description": "$n$은 정수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "two_samples_independent equals True",
      "required": true,
      "description": "두 표본은 서로 독립이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "both_samples_iid_normal equals True",
      "required": true,
      "description": "각 표본은 i.i.d. 정규표본이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "both_sample_sizes_at_least_two equals True",
      "required": true,
      "description": "$n_1,n_2\\ge2$여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "denominator_sample_variance greater_than 0",
      "required": true,
      "description": "분모 표본분산은 양수여야 한다."
    }
