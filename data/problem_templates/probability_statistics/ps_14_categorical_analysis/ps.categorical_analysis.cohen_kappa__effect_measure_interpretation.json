      "required": true,
      "description": "비례오즈의 공통기울기 가정이 적절해야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "expected_count greater_than 0",
      "required": true,
      "description": "Pearson 잔차는 기대도수 $E_{ij}>0$인 셀에서 정의된다."
    },
    {
      "type": "concept_application_condition",
      "expression": "all_stratum_totals_positive equals True",
      "required": true,
      "description": "각 층의 전체도수는 $n_k>0$이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "mantel_haenszel_denominator greater_than 0",
      "required": true,
      "description": "분모 $\\sum_k b_kc_k/n_k$는 양수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "stratified_common_odds_ratio_model equals True",
      "required": true,
      "description": "층별 2×2 표와 공통 오즈비 모형이 의미 있어야 한다."
