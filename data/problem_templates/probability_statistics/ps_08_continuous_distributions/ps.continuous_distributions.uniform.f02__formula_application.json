    {
      "type": "concept_application_condition",
      "expression": "all_observations_positive equals True",
      "required": true,
      "description": "관측값은 모두 양수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "sample_size greater_or_equal 1",
      "required": true,
      "description": "자료 개수는 $n\\ge1$이어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "sample_size_is_integer equals True",
      "required": true,
      "description": "`sample_size`에 대응하는 값은 정수여야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "all_observations_nonzero equals True",
      "required": true,
      "description": "각 관측값은 0이 아니어야 한다."
    },
    {
      "type": "concept_application_condition",
      "expression": "sum_of_reciprocals not_equals 0",
